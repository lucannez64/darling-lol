# darling-lol hardware presentation profile.
#
# This is the single source for the CPU, GPU, VRAM and memory values that the
# launcher exports to Metal and the patched guest sysctls. Platform identity
# (model, serial, UUID and board) remains in darling-platform.plist so a bad
# detection can be corrected without changing this hardware profile.
#
# profile=host   (default) report the real host CPU/GPU/VRAM/memory.
# profile=compat (opt-in)  report the MacBookPro16,1 compatibility values.
# COMPAT is never selected by default. Change only this key to opt in:
# profile=compat
profile=host

# HOST: the literal value "host" is resolved at launch from /proc and /sys.
host.cpu.brand=host
host.gpu.name=host
host.gpu.vram=host
host.memory.bytes=host

# COMPAT: guest-visible compatibility profile. These are compatibility strings,
# not identifiers from a real Mac; they do not enable or disable any Riot or
# Apple security check.
#
# The CPU brand is the one part identity every surface reports: the machdep.cpu.*
# sysctls, hw.cpufrequency and the game's own cpuid (see
# emulation/include/common/cpu_identity.h in patches/xnu.patch). It is a
# 6-core/12-thread part, matching the host's topology, so the profile does not
# have to invent a topology the scheduler does not have.
compat.cpu.brand=Intel(R) Core(TM) i7-9750H CPU @ 2.60GHz
compat.gpu.name=mac
compat.gpu.vram=4096
compat.memory.bytes=17179869184
