+{
+    return (CFFileSecurityRef)[(NSFileSecurity *)fileSec copy];
+}
+
+Boolean CFFileSecurityGetOwner(CFFileSecurityRef fileSec, uid_t *owner)
+{
+    NSFileSecurity *security = (NSFileSecurity *)fileSec;
