diff --git a/NSConstantObjects.m b/NSConstantObjects.m
new file mode 100644
index 0000000..70f31ff
--- /dev/null
+++ b/NSConstantObjects.m
@@ -0,0 +1,84 @@
+//
+//  NSConstantObjects.m
+//  CoreFoundation
+//
+//  Compatibility classes for the constant collection objects emitted by newer
+//  Clang versions for Objective-C collection literals. The layouts match
+//  clang/lib/CodeGen/CGObjCMac.cpp.
+//
+
+#import <Foundation/NSArray.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSEnumerator.h>
+#import <Foundation/NSException.h>
+#import <Foundation/NSString.h>
+
+struct dc_constant_array {
+	void *isa;
+	NSUInteger count;
+	id *objects;
+};
+
+struct dc_constant_dictionary {
+	void *isa;
+	NSUInteger hashOptions;
+	NSUInteger count;
+	id *keys;
+	id *objects;
+};
+
+@interface NSConstantArray : NSArray
+@end
+@interface NSConstantDictionary : NSDictionary
+@end
+
+@implementation NSConstantArray
+
+- (NSUInteger)count
+{
+	return ((struct dc_constant_array *) self)->count;
+}
+
+- (id)objectAtIndex:(NSUInteger)index
+{
+	struct dc_constant_array *array = (struct dc_constant_array *) self;
+
+	if (index >= array->count)
+		[NSException raise:NSRangeException format:@"index %lu beyond bounds %lu",
+		    (unsigned long) index, (unsigned long) array->count];
+	return array->objects[index];
+}
+
+@end
+
+@implementation NSConstantDictionary
+
+- (NSUInteger)count
+{
+	return ((struct dc_constant_dictionary *) self)->count;
+}
+
+- (id)objectForKey:(id)key
+{
+	struct dc_constant_dictionary *dictionary = (struct dc_constant_dictionary *) self;
+	NSUInteger index;
+
+	for (index = 0; index < dictionary->count; index++) {
+		if ([dictionary->keys[index] isEqual:key])
+			return dictionary->objects[index];
+	}
+	return nil;
+}
+
+- (NSEnumerator *)keyEnumerator
+{
+	struct dc_constant_dictionary *dictionary = (struct dc_constant_dictionary *) self;
+	NSMutableArray *keys = [NSMutableArray arrayWithCapacity:dictionary->count];
+	NSUInteger index;
+
+	for (index = 0; index < dictionary->count; index++)
+		[keys addObject:dictionary->keys[index]];
+	return [keys objectEnumerator];
+}
+
+@end
