+
+// Classes for the constant collection literals that clang emits when the
+// deployment target is macOS 12 or later. The compiler lays the objects out
+// in static data, so they are never allocated, retained or freed.
+
+#import <Foundation/NSArray.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSEnumerator.h>
+#import <Foundation/NSException.h>
+
+typedef struct {
+    Class isa;
+    NSUInteger count;
+    const id *objects;
+} NSConstantArrayLayout;
+
+typedef struct {
+    Class isa;
+    NSUInteger options;
+    NSUInteger count;
+    const id *keys;
+    const id *objects;
+} NSConstantDictionaryLayout;
+
+static unsigned long __NSConstantCollectionMutations;
+
+#define NS_CONSTANT_OBJECT_LIFETIME \
+- (id)retain { return self; } \
+- (oneway void)release {} \
+- (id)autorelease { return self; } \
+- (NSUInteger)retainCount { return NSUIntegerMax; } \
+- (id)copyWithZone:(NSZone *)zone { return self; }
+
+@interface NSConstantArray : NSArray
+@end
+
+@implementation NSConstantArray
+
+NS_CONSTANT_OBJECT_LIFETIME
+
+- (const NSConstantArrayLayout *)_layout
+{
+    return (const NSConstantArrayLayout *)(void *)self;
+}
+
+- (NSUInteger)count
+{
+    return [self _layout]->count;
+}
+
+- (id)objectAtIndex:(NSUInteger)index
+{
+    const NSConstantArrayLayout *layout = [self _layout];
+    if (index >= layout->count)
+    {
+        [NSException raise:NSRangeException format:@"*** -[NSConstantArray objectAtIndex:]: index %lu beyond bounds [0 .. %lu]",
+            (unsigned long)index, (unsigned long)layout->count];
+    }
+    return layout->objects[index];
+}
+
+- (NSUInteger)countByEnumeratingWithState:(NSFastEnumerationState *)state objects:(id *)buffer count:(NSUInteger)len
+{
+    if (state->state != 0)
+    {
+        return 0;
+    }
+    state->state = 1;
+    state->itemsPtr = (id *)[self _layout]->objects;
+    state->mutationsPtr = &__NSConstantCollectionMutations;
+    return [self _layout]->count;
+}
+
+@end
+
+@interface NSConstantDictionary : NSDictionary
+@end
+
+@implementation NSConstantDictionary
+
+NS_CONSTANT_OBJECT_LIFETIME
+
+- (const NSConstantDictionaryLayout *)_layout
+{
+    return (const NSConstantDictionaryLayout *)(void *)self;
+}
+
+- (NSUInteger)count
+{
+    return [self _layout]->count;
+}
+
+- (id)objectForKey:(id)key
+{
+    const NSConstantDictionaryLayout *layout = [self _layout];
+    if (key == nil)
+    {
+        return nil;
+    }
+    for (NSUInteger i = 0; i < layout->count; i++)
+    {
+        if (layout->keys[i] == key || [layout->keys[i] isEqual:key])
+        {
+            return layout->objects[i];
+        }
+    }
+    return nil;
+}
+
+- (NSEnumerator *)keyEnumerator
+{
+    const NSConstantDictionaryLayout *layout = [self _layout];
+    return [[NSArray arrayWithObjects:layout->keys count:layout->count] objectEnumerator];
+}
+
+- (NSUInteger)countByEnumeratingWithState:(NSFastEnumerationState *)state objects:(id *)buffer count:(NSUInteger)len
+{
+    if (state->state != 0)
+    {
+        return 0;
+    }
+    state->state = 1;
+    state->itemsPtr = (id *)[self _layout]->keys;
+    state->mutationsPtr = &__NSConstantCollectionMutations;
+    return [self _layout]->count;
+}
+
+@end
+
+extern char __NSConstantArrayClass __asm__("_OBJC_CLASS_$_NSConstantArray");
+extern char __NSConstantDictionaryClass __asm__("_OBJC_CLASS_$_NSConstantDictionary");
+
+// Empty singletons that the compiler references for @[] and @{}.
+NSConstantArrayLayout __NSArray0__struct = { (Class)&__NSConstantArrayClass, 0, NULL };
+NSConstantDictionaryLayout __NSDictionary0__struct = { (Class)&__NSConstantDictionaryClass, 1, 0, NULL, NULL };
