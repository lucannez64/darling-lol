diff --git a/NSConstantCollections.m b/NSConstantCollections.m
new file mode 100644
index 0000000..cebac5a
--- /dev/null
+++ b/NSConstantCollections.m
@@ -0,0 +1,171 @@
+//
+//  NSConstantCollections.m
+//  CoreFoundation
+//
+//  The collection literals clang emits when it knows their contents at compile
+//  time. When a translation unit is built for a macOS 11 or newer runtime,
+//  clang turns `@[a, b]` into a statically allocated struct whose first word is
+//  the class and whose remaining words are the count and the object pointers,
+//  and it binds that class to NSConstantArray. An empty `@[]` is a reference to
+//  the object __NSArray0__struct instead. Dictionaries work the same
+//  way with NSConstantDictionary and __NSDictionary0__struct.
+//
+//  Darling only provided __NSArray0__ / __NSDictionary0__, so an application
+//  built with such a compiler failed to bind at launch:
+//
+//      dyld: Symbol not found: _OBJC_CLASS_$_NSConstantIntegerNumber
+//      dyld: Symbol not found: ___NSArray0__struct
+//
+//  The instance layouts below are exactly the ones clang emits (see
+//  CGObjCMac.cpp, GenerateConstantNSArray / GenerateConstantNSDictionary):
+//
+//      struct { Class isa; NSUInteger count; id const *objects; }
+//      struct { Class isa; NSUInteger hashOptions; NSUInteger count;
+//               id const *keys; id const *objects; }
+//
+//  The instances live in the calling image's read-only data, are never
+//  deallocated and can be retained from anywhere, so the memory-management
+//  methods are no-ops and copying returns the same object.
+
+#import <Foundation/NSArray.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSEnumerator.h>
+#import <Foundation/NSException.h>
+#import <Foundation/NSObjCRuntime.h>
+
+#import "NSObjectInternal.h"
+
+@interface NSConstantArray : NSArray {
+    NSUInteger _count;
+    id const *_objects;
+}
+@end
+
+@interface NSConstantDictionary : NSDictionary {
+    NSUInteger _hashOptions;
+    NSUInteger _count;
+    id const *_keys;
+    id const *_objects;
+}
+@end
+
+@implementation NSConstantArray
+
+- (NSUInteger)count
+{
+    return _count;
+}
+
+- (id)objectAtIndex:(NSUInteger)idx
+{
+    if (idx >= _count)
+    {
+        [NSException raise:NSRangeException
+                    format:@"index %lu beyond bounds of constant array (count %lu)",
+                           (unsigned long)idx, (unsigned long)_count];
+    }
+    return _objects[idx];
+}
+
+- (void)getObjects:(id __unsafe_unretained [])objects range:(NSRange)range
+{
+    if (range.location > _count || range.length > _count - range.location)
+    {
+        [NSException raise:NSRangeException
+                    format:@"range {%lu, %lu} beyond bounds of constant array (count %lu)",
+                           (unsigned long)range.location, (unsigned long)range.length,
+                           (unsigned long)_count];
+    }
+    for (NSUInteger i = 0; i < range.length; ++i)
+    {
+        objects[i] = _objects[range.location + i];
+    }
+}
+
+- (id)copyWithZone:(NSZone *)zone
+{
+    return self;
+}
+
+- (id)retain
+{
+    return self;
+}
+
+- (oneway void)release
+{
+}
+
+- (id)autorelease
+{
+    return self;
+}
+
+- (NSUInteger)retainCount
+{
+    return NSUIntegerMax;
+}
+
+- (void)dealloc
+{
+}
+
+@end
+
+@implementation NSConstantDictionary
+
+- (NSUInteger)count
+{
+    return _count;
+}
+
+- (id)objectForKey:(id)key
+{
+    if (key == nil)
+    {
+        return nil;
+    }
+    for (NSUInteger i = 0; i < _count; ++i)
+    {
+        if (_keys[i] == key || [_keys[i] isEqual:key])
+        {
+            return _objects[i];
+        }
+    }
+    return nil;
+}
+
+- (NSEnumerator *)keyEnumerator
+{
+    return [[[[NSArray alloc] initWithObjects:_keys count:_count] autorelease] objectEnumerator];
+}
+
+- (id)copyWithZone:(NSZone *)zone
+{
+    return self;
+}
+
+- (id)retain
+{
+    return self;
+}
+
+- (oneway void)release
+{
+}
+
+- (id)autorelease
+{
+    return self;
+}
+
+- (NSUInteger)retainCount
+{
+    return NSUIntegerMax;
+}
+
+- (void)dealloc
+{
+}
+
+@end
