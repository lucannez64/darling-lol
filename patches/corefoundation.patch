diff --git a/NSConstantObjects.m b/NSConstantObjects.m
new file mode 100644
index 0000000..e2d2b36
--- /dev/null
+++ b/NSConstantObjects.m
@@ -0,0 +1,149 @@
+//
+//  NSConstantObjects.m
+//  CoreFoundation
+//
+//  Collections that newer Clang versions emit at compile time for Objective-C
+//  literals (-fobjc-constant-literals), and the empty array and dictionary
+//  objects such code references directly. The objects live in the binary that
+//  uses them, so they are never allocated, retained or freed.
+//
+
+#import <Foundation/NSArray.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSEnumerator.h>
+#import <Foundation/NSException.h>
+#import <objc/runtime.h>
+
+// The layouts Clang emits.
+struct NSConstantArrayLayout {
+    Class isa;
+    NSUInteger count;
+    const id *objects;
+};
+
+struct NSConstantDictionaryLayout {
+    Class isa;
+    NSUInteger options; // 1: keys are sorted and unique
+    NSUInteger count;
+    const id *keys;
+    const id *objects;
+};
+
+#define CONSTANT_ARRAY(object) ((const struct NSConstantArrayLayout *)(object))
+#define CONSTANT_DICTIONARY(object) ((const struct NSConstantDictionaryLayout *)(object))
+
+@interface NSConstantArray : NSArray
+@end
+
+@interface NSConstantDictionary : NSDictionary
+@end
+
+@implementation NSConstantArray
+
+- (NSUInteger)count
+{
+    return CONSTANT_ARRAY(self)->count;
+}
+
+- (id)objectAtIndex:(NSUInteger)index
+{
+    if (index >= CONSTANT_ARRAY(self)->count)
+    {
+        [NSException raise:NSRangeException format:@"*** -[NSConstantArray objectAtIndex:]: index %lu beyond bounds [0 .. %lu]",
+            (unsigned long)index, (unsigned long)CONSTANT_ARRAY(self)->count];
+    }
+    return CONSTANT_ARRAY(self)->objects[index];
+}
+
+- (id)copyWithZone:(NSZone *)zone
+{
+    return self;
+}
+
+- (id)retain
+{
+    return self;
+}
+
+- (oneway void)release
+{
+}
+
+- (id)autorelease
+{
+    return self;
+}
+
+- (NSUInteger)retainCount
+{
+    return NSUIntegerMax;
+}
+
+- (void)dealloc
+{
+}
+
+@end
+
+@implementation NSConstantDictionary
+
+- (NSUInteger)count
+{
+    return CONSTANT_DICTIONARY(self)->count;
+}
+
+- (id)objectForKey:(id)key
+{
+    if (key == nil)
+        return nil;
+    const struct NSConstantDictionaryLayout *dictionary = CONSTANT_DICTIONARY(self);
+    for (NSUInteger i = 0; i < dictionary->count; i++)
+    {
+        if (dictionary->keys[i] == key || [dictionary->keys[i] isEqual:key])
+            return dictionary->objects[i];
+    }
+    return nil;
+}
+
+- (NSEnumerator *)keyEnumerator
+{
+    const struct NSConstantDictionaryLayout *dictionary = CONSTANT_DICTIONARY(self);
+    return [[NSArray arrayWithObjects:dictionary->keys count:dictionary->count] objectEnumerator];
+}
+
+- (id)copyWithZone:(NSZone *)zone
+{
+    return self;
+}
+
+- (id)retain
+{
+    return self;
+}
+
+- (oneway void)release
+{
+}
+
+- (id)autorelease
+{
+    return self;
+}
+
+- (NSUInteger)retainCount
+{
+    return NSUIntegerMax;
+}
+
+- (void)dealloc
+{
+}
+
+@end
+
+// Code built with constant literals references these objects for @[] and @{}.
+extern char NSConstantArrayClass __asm__("_OBJC_CLASS_$_NSConstantArray");
+extern char NSConstantDictionaryClass __asm__("_OBJC_CLASS_$_NSConstantDictionary");
+
+struct NSConstantArrayLayout __NSArray0__struct = { (Class)&NSConstantArrayClass, 0, NULL };
+struct NSConstantDictionaryLayout __NSDictionary0__struct = { (Class)&NSConstantDictionaryClass, 1, 0, NULL, NULL };
