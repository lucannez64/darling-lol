+    security->_owner = owner;
+    security->_validProperties |= kCFFileSecurityClearOwner;
+    return true;
+}
+
+Boolean CFFileSecurityGetGroup(CFFileSecurityRef fileSec, gid_t *group)
+{
+    NSFileSecurity *security = (NSFileSecurity *)fileSec;
+    if (security == nil || !(security->_validProperties & kCFFileSecurityClearGroup))
+        return false;
+    if (group)
+        *group = security->_group;
+    return true;
+}
+
+Boolean CFFileSecuritySetGroup(CFFileSecurityRef fileSec, gid_t group)
+{
+    NSFileSecurity *security = (NSFileSecurity *)fileSec;
+    if (security == nil)
+        return false;
+    security->_group = group;
+    security->_validProperties |= kCFFileSecurityClearGroup;
+    return true;
+}
+
+Boolean CFFileSecurityGetMode(CFFileSecurityRef fileSec, mode_t *mode)
+{
+    NSFileSecurity *security = (NSFileSecurity *)fileSec;
+    if (security == nil || !(security->_validProperties & kCFFileSecurityClearMode))
+        return false;
+    if (mode)
+        *mode = security->_mode;
+    return true;
+}
+
+Boolean CFFileSecuritySetMode(CFFileSecurityRef fileSec, mode_t mode)
+{
+    NSFileSecurity *security = (NSFileSecurity *)fileSec;
+    if (security == nil)
+        return false;
+    security->_mode = mode & ALLPERMS;
