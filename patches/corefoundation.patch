+static BOOL _NSTypeIsFloating(const char *type)
+{
+    return type != NULL && (*type == _C_FLT || *type == _C_DBL);
+}
+
+static BOOL _NSTypeIsUnsigned(const char *type)
+{
+    switch (type ? *type : '\0')
+    {
+        case _C_UCHR:
+        case _C_USHT:
+        case _C_UINT:
+        case _C_ULNG:
+        case _C_ULNG_LNG:
+            return YES;
+        default:
+            return NO;
+    }
+}
+
+static NSComparisonResult _NSCompareNonCFNumber(id self, id other)
+{
+    const char *type = [self objCType];
+    const char *otherType = [other objCType];
