+// Like mkdir -p, but only warns: launchd runs without its database (it only
+// loses overrides and WatchPaths registration records), so a prefix with an
+// unexpected entry here must still start.
+static void createLaunchdStateDir(const char* path)
+{
+	char partial[4096];
+	size_t length = strlen(path);
+
+	if (length >= sizeof(partial))
+		return;
+	memcpy(partial, path, length + 1);
+
+	for (size_t i = 1; i <= length; i++)
+	{
+		if (partial[i] != '/' && partial[i] != '\0')
+			continue;
+
+		const char saved = partial[i];
+		partial[i] = '\0';
+
+		struct stat st;
+		if (stat(partial, &st) == 0)
+		{
+			if (!S_ISDIR(st.st_mode))
+			{
+				fprintf(stderr, "Warning: %s is not a directory; launchd state is not persisted.\n", partial);
+				return;
+			}
+		}
+		else if (errno != ENOENT || mkdir(partial, 0755) != 0)
+		{
+			fprintf(stderr, "Warning: cannot create %s: %s; launchd state is not persisted.\n", partial, strerror(errno));
+			return;
+		}
+
+		partial[i] = saved;
+	}
+}
