+static bool frameSinkReadSaved(FrameSinkSavedState *state) {
+	int fd = open(frameSinkStatePath(), 0, 0);
+	if (fd < 0)
+		return false;
+	ssize_t got = read(fd, state, sizeof(*state));
+	close(fd);
+	return got == (ssize_t) sizeof(*state) &&
+		state->magic == kFrameSinkSavedMagic;
