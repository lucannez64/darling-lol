new file mode 100644
index 00000000..5007a03c
--- /dev/null
+++ b/src/frameworks/CoreServices/src/LaunchServices/launchservicesd/lsregister.m
@@ -0,0 +1,164 @@
+/*
+ This file is part of Darling.
+
