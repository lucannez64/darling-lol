+/*
+ * endnm() - locate end of Namech
+ */
+
+char *
+endnm(sz)
+	size_t *sz;			/* returned remaining size */
+{
+	register char *s;
+	register size_t tsz;
+
+	for (s = Namech, tsz = Namechl; *s; s++, tsz--)
+		;
+	*sz = tsz;
+	return(s);
+}
