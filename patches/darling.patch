+void
+jobmgr_reap_orphaned_children(void)
+{
+	/* Darling: when a process's parent dies, the kernel reparents it to
+	 * launchd, and the job manager never learns about it, so nothing ever
+	 * waits on it and it lingers as a zombie until shutdown. Reap those
+	 * zombies here, leaving tracked jobs alone so their exit status is still
+	 * available to job_reap().
+	 *
+	 * proc_listpids() is not implemented yet, so enumerate the guest PID
+	 * namespace through /proc. */
+	DIR *dir;
+	struct dirent *de;
+	pid_t self = getpid();
+
+	if (root_jobmgr == NULL) {
+		return;
+	}
+
+	dir = opendir("/proc");
+	if (dir == NULL) {
+		jobmgr_log(root_jobmgr, LOG_DEBUG, "Unable to enumerate /proc: %d: %s", errno, strerror(errno));
+		return;
+	}
+
