+/* Records each label that has registered WatchPaths in the launchd database,
+ * so the first registration survives runtime restarts as it does on macOS.
+ * Returns true only for the first registration of the label.
+ */
+static bool
+externalevent_first_watchpaths_registration(job_t j)
+{
+	char *dir = launchd_copy_persistent_store(LAUNCHD_PERSISTENT_STORE_DB, "watchpaths-registered");
+	if (!dir) {
+		return false;
+	}
+	if (mkdir(dir, S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH) == -1 && errno != EEXIST) {
+		job_log(j, LOG_ERR, "Could not create %s: %d: %s", dir, errno, strerror(errno));
+		free(dir);
+		return false;
+	}
+
+	char name[PATH_MAX];
+	size_t i = 0;
+	for (const char *c = j->label; *c && i + 1 < sizeof(name); c++) {
+		name[i++] = (*c == '/') ? '_' : *c;
+	}
+	name[i] = '\0';
+
+	char *marker = NULL;
+	(void)asprintf(&marker, "%s/%s", dir, name);
+	free(dir);
+	if (!marker) {
