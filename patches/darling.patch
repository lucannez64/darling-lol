diff --git a/src/startup/mldr/include/dc_entitlements.h b/src/startup/mldr/include/dc_entitlements.h
new file mode 100644
index 0000000..2033969
--- /dev/null
+++ b/src/startup/mldr/include/dc_entitlements.h
@@ -0,0 +1,63 @@
+/* Bounded, non-networked plist policy parsing shared by mldr and the server. */
+#ifndef DC_ENTITLEMENTS_H
+#define DC_ENTITLEMENTS_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <libxml/parser.h>
+#include <libxml/tree.h>
+
+static inline xmlNode* dc_next_element(xmlNode* node) {
+    while (node && (node->type == XML_COMMENT_NODE || node->type == XML_PI_NODE ||
+                    (node->type == XML_TEXT_NODE && xmlIsBlankNode(node)))) node = node->next;
+    return node;
+}
+static inline bool dc_xml_name(xmlNode* node, const char* name) {
+    return node && !node->ns && xmlStrEqual(node->name, (const xmlChar*)name);
+}
+static inline bool dc_entitlement_is_true(const uint8_t* data, size_t len, const char* key) {
+    if (!data || !key || !len || len > 1024 * 1024) return false;
+    while (len && data[len - 1] == 0) len--;
+    xmlDoc* doc = xmlReadMemory((const char*)data, (int)len, "entitlements.plist", NULL,
+        XML_PARSE_NONET | XML_PARSE_NOERROR | XML_PARSE_NOWARNING);
+    if (!doc) return false;
+    bool result = false, seen = false;
+    /* A normal plist DOCTYPE is fine; custom entities and external DTDs are not
+     * policy input. No DTD loading or entity substitution options are enabled. */
+    if (doc->extSubset || (doc->intSubset &&
+        (doc->intSubset->entities || doc->intSubset->pentities))) goto done;
+    {
+        xmlNode* plist = xmlDocGetRootElement(doc);
+        if (!dc_xml_name(plist, "plist")) goto done;
+        xmlNode* dict = dc_next_element(plist->children);
+        if (!dc_xml_name(dict, "dict") || dc_next_element(dict->next)) goto done;
+        for (xmlNode* entry = dc_next_element(dict->children); entry;) {
+            if (!dc_xml_name(entry, "key") || entry->properties) { result = false; goto done; }
+            for (xmlNode* part = entry->children; part; part = part->next) {
+                if (part->type != XML_TEXT_NODE && part->type != XML_CDATA_SECTION_NODE) {
+                    result = false; goto done;
+                }
+            }
+            xmlNode* value = dc_next_element(entry->next);
+            if (!(dc_xml_name(value, "true") || dc_xml_name(value, "false") ||
+                  dc_xml_name(value, "string") || dc_xml_name(value, "data") ||
+                  dc_xml_name(value, "date") || dc_xml_name(value, "integer") ||
+                  dc_xml_name(value, "real") || dc_xml_name(value, "array") ||
+                  dc_xml_name(value, "dict"))) { result = false; goto done; }
+            xmlChar* name = xmlNodeGetContent(entry);
+            bool matches = name && xmlStrEqual(name, (const xmlChar*)key);
+            xmlFree(name);
+            if (matches) {
+                if (seen) { result = false; goto done; }
+                seen = true;
+                result = dc_xml_name(value, "true") && !value->children && !value->properties;
+            }
+            entry = dc_next_element(value->next);
+        }
+    }
+done:
+    xmlFreeDoc(doc);
+    return result;
+}
+#endif
diff --git a/src/startup/mldr/include/dc_mseal.h b/src/startup/mldr/include/dc_mseal.h
new file mode 100644
index 0000000..fb3f73c
--- /dev/null
+++ b/src/startup/mldr/include/dc_mseal.h
@@ -0,0 +1,37 @@
+/* Replace a read-only file mapping with an anonymous snapshot before sealing.
+ * mseal alone does not stop writes to the original inode. Anonymous backing also
+ * prevents madvise from discarding COW pages and re-reading a modified file.
+ * Callbacks return negative errno on failure; addresses use the native long ABI.
+ */
+#ifndef DC_MSEAL_H
+#define DC_MSEAL_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+struct dc_seal_ops {
+    long (*allocate)(unsigned long);
+    long (*protect)(void*, unsigned long, int);
+    long (*relocate)(void*, unsigned long, void*);
+    void (*release)(void*, unsigned long);
+    long (*seal)(void*, unsigned long);
+};
+static inline int dc_vm_error(long value) {
+    return (unsigned long)value >= (unsigned long)-4095;
+}
+static inline long dc_snapshot_and_seal(void* address, unsigned long length, int prot,
+                                       const struct dc_seal_ops* ops) {
+    const unsigned long page = 4096; /* Darling's x86 guest page size. */
+    if (!length || ((uintptr_t)address & (page - 1)) ||
+        length > ~(unsigned long)0 - (page - 1) || !(prot & 1) || (prot & 2)) return -22;
+    length = (length + page - 1) & ~(page - 1);
+    long allocated = ops->allocate(length);
+    if (dc_vm_error(allocated)) return allocated;
+    void* snapshot = (void*)(uintptr_t)allocated;
+    memcpy(snapshot, address, length);
+    long result = ops->protect(snapshot, length, prot);
+    if (result < 0) { ops->release(snapshot, length); return result; }
+    result = ops->relocate(snapshot, length, address);
+    if (dc_vm_error(result)) { ops->release(snapshot, length); return result; }
+    return ops->seal(address, length);
+}
+#endif
diff --git a/src/startup/mldr/include/dc_image_snapshot.h b/src/startup/mldr/include/dc_image_snapshot.h
new file mode 100644
index 0000000..04d64c1
--- /dev/null
+++ b/src/startup/mldr/include/dc_image_snapshot.h
@@ -0,0 +1,48 @@
+/* Immutable file snapshots bind verification and mapping to the same bytes.
+ * Callbacks normalize errors to negative errno and never change the source offset.
+ */
+#ifndef DC_IMAGE_SNAPSHOT_H
+#define DC_IMAGE_SNAPSHOT_H
+#include <stddef.h>
+enum { DC_F_SNAPSHOT_IMAGE = 0x40004443 };
+struct dc_image_ops {
+    long (*size)(int);
+    long (*create)(void);
+    long (*read)(int, void*, unsigned long, unsigned long);
+    long (*write)(int, const void*, unsigned long);
+    long (*seal)(int);
+    void (*close)(int);
+};
+static inline long dc_snapshot_image(int source, const struct dc_image_ops* ops) {
+    long length = ops->size(source);
+    if (length < 0) return length;
+    if (!length) return -22;
+    if ((unsigned long)length > 2UL * 1024 * 1024 * 1024) return -27;
+    long target = ops->create();
+    if (target < 0) return target;
+    unsigned long offset = 0;
+    long error = -5;
+    char buffer[16384];
+    while (offset < (unsigned long)length) {
+        unsigned long amount = (unsigned long)length - offset;
+        if (amount > sizeof(buffer)) amount = sizeof(buffer);
+        long got = ops->read(source, buffer, amount, offset);
+        if (got == -4) continue;
+        if (got <= 0) { error = got < 0 ? got : -5; goto fail; }
+        unsigned long written = 0;
+        while (written < (unsigned long)got) {
+            long put = ops->write((int)target, buffer + written, (unsigned long)got - written);
+            if (put == -4) continue;
+            if (put <= 0) { error = put < 0 ? put : -5; goto fail; }
+            written += (unsigned long)put;
+        }
+        offset += (unsigned long)got;
+    }
+    error = ops->seal((int)target);
+    if (error < 0) goto fail;
+    return target;
+fail:
+    ops->close((int)target);
+    return error;
+}
+#endif
diff --git a/src/startup/mldr/include/dc_macho_slice.h b/src/startup/mldr/include/dc_macho_slice.h
new file mode 100644
--- /dev/null
+++ b/src/startup/mldr/include/dc_macho_slice.h
@@ -0,0 +1,104 @@
+/* Bounded, allocation-free architecture selection shared by mldr's gate and loader. */
+#ifndef DC_MACHO_SLICE_H
+#define DC_MACHO_SLICE_H
+#include <stdint.h>
+#include <stddef.h>
+
+#define DC_CPU_X86 7u
+#define DC_CPU_X86_64 0x01000007u
+#define DC_MAX_FAT_ARCHES 64u
+
+struct dc_macho_slice { uint64_t offset, size; uint32_t cpu, subtype; };
+
+static uint32_t dc_slice_u32(const uint8_t *p, int big) {
+    if (big) return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+    return ((uint32_t)p[3] << 24) | ((uint32_t)p[2] << 16) | ((uint32_t)p[1] << 8) | p[0];
+}
+static uint64_t dc_slice_u64(const uint8_t *p, int big) {
+    if (big) return ((uint64_t)dc_slice_u32(p, 1) << 32) | dc_slice_u32(p + 4, 1);
+    return ((uint64_t)dc_slice_u32(p + 4, 0) << 32) | dc_slice_u32(p, 0);
+}
+static int dc_slice_header(const uint8_t *p, uint64_t size, uint32_t *cpu, uint32_t *subtype) {
+    if (size < 28) return -1;
+    uint32_t magic = dc_slice_u32(p, 1);
+    int big, wide = 0;
+    switch (magic) {
+    case 0xfeedfaceu: big = 1; break;
+    case 0xcefaedfeu: big = 0; break;
+    case 0xfeedfacfu: big = 1; wide = 1; if (size < 32) return -1; break;
+    case 0xcffaedfeu: big = 0; wide = 1; if (size < 32) return -1; break;
+    default: return -1;
+    }
+    *cpu = dc_slice_u32(p + 4, big);
+    *subtype = dc_slice_u32(p + 8, big);
+    if (wide != ((*cpu & 0x01000000u) != 0)) return -1;
+    return 0;
+}
+
+/* Returns -1 for unsupported or malformed input. Does not validate signatures.
+ * host_cpu is the loader ABI; x86_64 may select x86 for re-execution in mldr32.
+ * Preferences retain the existing first-matching-preference behavior; otherwise
+ * prefer the native ABI, falling back to x86 only on an x86_64 host.
+ * Output is untouched on error. */
+static int dc_select_macho_slice(const uint8_t *data, size_t size,
+    const uint32_t preferences[4], uint32_t forced_cpu, uint32_t host_cpu,
+    struct dc_macho_slice *out) {
+    struct dc_macho_slice slices[DC_MAX_FAT_ARCHES];
+    unsigned count = 1;
+    if (!data || !out || size < 4 ||
+        (host_cpu != DC_CPU_X86 && host_cpu != DC_CPU_X86_64)) return -1;
+    uint32_t magic = dc_slice_u32(data, 1);
+    int fat = magic == 0xcafebabeu || magic == 0xbebafecau ||
+              magic == 0xcafebabfu || magic == 0xbfbafecau;
+    if (fat) {
+        if (size < 8) return -1;
+        int big = magic == 0xcafebabeu || magic == 0xcafebabfu;
+        int wide = magic == 0xcafebabfu || magic == 0xbfbafecau;
+        unsigned width = wide ? 32 : 20;
+        count = dc_slice_u32(data + 4, big);
+        if (!count || count > DC_MAX_FAT_ARCHES || count > (size - 8) / width) return -1;
+        uint64_t table_end = 8 + (uint64_t)count * width;
+        for (unsigned i = 0; i < count; ++i) {
+            const uint8_t *row = data + 8 + (size_t)i * width;
+            slices[i].cpu = dc_slice_u32(row, big);
+            slices[i].subtype = dc_slice_u32(row + 4, big);
+            slices[i].offset = wide ? dc_slice_u64(row + 8, big) : dc_slice_u32(row + 8, big);
+            slices[i].size = wide ? dc_slice_u64(row + 16, big) : dc_slice_u32(row + 12, big);
+            uint32_t align = dc_slice_u32(row + (wide ? 24 : 16), big);
+            if (align >= 63 || slices[i].offset < table_end || slices[i].offset > size ||
+                !slices[i].size || slices[i].size > size - slices[i].offset ||
+                (slices[i].offset & ((UINT64_C(1) << align) - 1))) return -1;
+            uint32_t cpu, subtype;
+            if (dc_slice_header(data + (size_t)slices[i].offset, slices[i].size, &cpu, &subtype) ||
+                cpu != slices[i].cpu || subtype != slices[i].subtype) return -1;
+            for (unsigned j = 0; j < i; ++j) {
+                if (slices[i].offset < slices[j].offset + slices[j].size &&
+                    slices[j].offset < slices[i].offset + slices[i].size) return -1;
+                if (slices[i].cpu == slices[j].cpu && slices[i].subtype == slices[j].subtype) return -1;
+            }
+        }
+    } else {
+        slices[0].offset = 0; slices[0].size = size;
+        if (dc_slice_header(data, size, &slices[0].cpu, &slices[0].subtype)) return -1;
+    }
+    int best = -1;
+    unsigned best_preference = 4;
+    for (unsigned i = 0; i < count; ++i) {
+        uint32_t cpu = slices[i].cpu;
+        if (cpu != host_cpu && !(host_cpu == DC_CPU_X86_64 && cpu == DC_CPU_X86)) continue;
+        if (forced_cpu) {
+            if (cpu == forced_cpu) best = (int)i;
+            continue;
+        }
+        unsigned preference = 4;
+        if (preferences) for (unsigned j = 0; j < 4; ++j) {
+            if (preferences[j] && preferences[j] == cpu) { preference = j; break; }
+        }
+        if (preference < best_preference) { best = (int)i; best_preference = preference; }
+        else if (best_preference == 4 && (cpu == host_cpu || best < 0)) best = (int)i;
