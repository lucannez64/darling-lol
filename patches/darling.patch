+- (BOOL)_matches:(NSDictionary *)user
+{
+    if (_matchType == kODMatchAny)
+        return YES;
+
+    for (NSString *value in user[_attribute]) {
+        for (NSString *wanted in _queryValues) {
+            if ([self _value: value matches: wanted])
+                return YES;
+        }
+    }
+    return NO;
+}
