+void
+jobmgr_reap_orphaned_children(void)
+{
+	/* Darling: when a process's parent dies, the kernel reparents it to
+	 * launchd, and the job manager never learns about it, so nothing ever
+	 * waits on it and it lingers as a zombie until shutdown. Reap those
+	 * zombies here, leaving tracked jobs alone so their exit status is still
+	 * available to job_reap().
+	 *
+	 * proc_listpids() is not implemented yet, so enumerate the guest PID
+	 * namespace through /proc. */
+	DIR *dir;
+	struct dirent *de;
+	pid_t self = getpid();
+
+	if (root_jobmgr == NULL) {
+		return;
+	}
+
+	dir = opendir("/proc");
+	if (dir == NULL) {
+		jobmgr_log(root_jobmgr, LOG_DEBUG, "Unable to enumerate /proc: %d: %s", errno, strerror(errno));
+		return;
+	}
+
+	while ((de = readdir(dir)) != NULL) {
+		struct proc_bsdshortinfo proc;
+		char *end = NULL;
+		long value = strtol(de->d_name, &end, 10);
+		pid_t pid;
+		int status;
+
+		if (end == de->d_name || *end != '\0' || value <= 0) {
+			continue;
+		}
+		pid = (pid_t)value;
+
+		memset(&proc, 0, sizeof(proc));
+		if (proc_pidinfo(pid, PROC_PIDT_SHORTBSDINFO, 1, &proc, PROC_PIDT_SHORTBSDINFO_SIZE) == 0) {
+			continue;
+		}
+		if (proc.pbsi_ppid != self) {
+			continue;
+		}
+		if (proc.pbsi_status != SZOMB) {
+			continue;
+		}
+		if (jobmgr_find_by_pid_deep(root_jobmgr, pid, true) != NULL) {
+			continue;
+		}
+
+		if (waitpid(pid, &status, WNOHANG) == pid) {
+			jobmgr_log(root_jobmgr, LOG_DEBUG, "Reaped orphaned zombie child PID %u.", pid);
+		}
+	}
+
+	closedir(dir);
+}
