diff --git a/src/frameworks/OpenDirectory/src/ODLocalDirectory.m b/src/frameworks/OpenDirectory/src/ODLocalDirectory.m
new file mode 100644
--- /dev/null
+++ b/src/frameworks/OpenDirectory/src/ODLocalDirectory.m
@@ -0,0 +1,141 @@
+/*
+ This file is part of Darling.
+
+ Copyright (C) 2026 Darling Team
+
