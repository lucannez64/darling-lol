+// darling-lol: hand a URL to the running app that serves its scheme. AppKit makes
+// every app that declares CFBundleURLTypes schemes serve one CFMessagePort per
+// scheme (NSApplication.m, "URL events for running apps") and delivers the URL as
+// the kAEGetURL Apple event macOS would send. Returns kLSApplicationNotFoundErr
+// when no running app serves the scheme; launching an app for it is not done yet.
+#define LS_URL_EVENT_PORT_PREFIX "org.darlinghq.url-event."
+#define LS_URL_EVENT_MAX_LENGTH 4096
+
+// True for a URL with a scheme other than file. open(1) may pass scheme-less URLs
+// built from raw paths; those keep the path handling below.
+static Boolean
+_LSURLHasNonFileScheme(CFURLRef url)
+{
+	CFStringRef scheme = CFURLCopyScheme(url);
+	if (scheme == NULL)
+		return FALSE;
+	Boolean other = CFStringCompare(scheme, CFSTR("file"), kCFCompareCaseInsensitive) != kCFCompareEqualTo;
+	CFRelease(scheme);
+	return other;
+}
+
+OSStatus
+_LSOpenURLInRunningApp(CFURLRef url)
+{
+	CFStringRef scheme = CFURLCopyScheme(url);
+	char schemeBuf[64], portName[128], urlBuf[LS_URL_EVENT_MAX_LENGTH + 1];
+	OSStatus status = kLSApplicationNotFoundErr;
+
+	if (scheme == NULL)
+		return kLSApplicationNotFoundErr;
+	Boolean ok = CFStringGetCString(scheme, schemeBuf, sizeof(schemeBuf), kCFStringEncodingASCII);
+	CFRelease(scheme);
+	if (!ok || schemeBuf[0] == 0)
+		return kLSApplicationNotFoundErr;
+	for (char *c = schemeBuf; *c; c++)
+	{
+		if (*c >= 'A' && *c <= 'Z')
+			*c += 'a' - 'A';
+		if (!((*c >= 'a' && *c <= 'z') || (*c >= '0' && *c <= '9') || *c == '+' || *c == '-' || *c == '.'))
+			return kLSApplicationNotFoundErr;
+	}
+	if (strcmp(schemeBuf, "file") == 0)
+		return kLSApplicationNotFoundErr;
+
+	if (!CFStringGetCString(CFURLGetString(url), urlBuf, sizeof(urlBuf), kCFStringEncodingUTF8))
+		return paramErr; // over LS_URL_EVENT_MAX_LENGTH bytes, or not representable
+
+	snprintf(portName, sizeof(portName), LS_URL_EVENT_PORT_PREFIX "%s", schemeBuf);
+	CFStringRef name = CFStringCreateWithCString(NULL, portName, kCFStringEncodingASCII);
+	CFMessagePortRef remote = CFMessagePortCreateRemote(NULL, name);
+	CFRelease(name);
+	if (remote == NULL)
+		return kLSApplicationNotFoundErr;
+
+	CFDataRef data = CFDataCreate(NULL, (const UInt8 *) urlBuf, strlen(urlBuf));
+	CFDataRef reply = NULL;
+	SInt32 sent = CFMessagePortSendRequest(remote, 0, data, 2.0, 5.0, kCFRunLoopDefaultMode, &reply);
+	CFRelease(data);
+	CFMessagePortInvalidate(remote);
+	CFRelease(remote);
+
+	if (sent != kCFMessagePortSuccess)
+		fprintf(stderr, "LaunchServices: could not deliver a %s URL to its app (%d)\n", schemeBuf, (int) sent);
+	else if (reply != NULL && CFDataGetLength(reply) == 1 && CFDataGetBytePtr(reply)[0] == 1)
+		status = noErr;
+	else
+		fprintf(stderr, "LaunchServices: the app serving %s URLs did not handle it\n", schemeBuf);
+	if (reply != NULL)
+		CFRelease(reply);
+	return status;
+}
+
+// darling-lol M2a: minimal bundle launching.
+// Supports: file URLs (or bare POSIX paths) pointing at .app bundles,
+// optionally with an explicit target app via inAppParams->application.
+// The bundle's executable is spawned directly with the emulated posix_spawn
+// (no launchd job registration yet — see _LSLaunchApplication).
+// NOT yet supported (documented deviations):
+//  - AppleEvent delivery (oapp/odoc): the app is spawned bare, as if launched
+//    by hand. Apps waiting for their initial event will park. Needs #425/#937.
+//  - inAppParams->argv / ->environment: not propagated (_LSLaunchApplication
+//    takes no argv yet).
+//  - inRole / launch flags (kLSLaunchNewInstance etc.): every launch spawns a
+//    new instance; no running-app registry, so outPSNs is left untouched.
+//  - non-bundle documents without an explicit application: there is no default
+//    handler database yet (needs UTI/LaunchServices DB).
+static OSStatus
+LSOpenOneURL(CFURLRef url, const LSApplicationParameters *params)
+{
+	CFStringRef pathStr;
+	char path[4096];
+	struct stat st;
+	CFURLRef appURL = NULL;
+	OSStatus status;
+
+	if (url == NULL)
+		return paramErr;
+
+	if ((params == NULL || params->application == NULL) && _LSIsHostOpenURL(url))
+		return _LSOpenURLOnHost(url);
+
+	if (params == NULL || params->application == NULL)
+	{
+		status = _LSOpenURLInRunningApp(url);
+		// A URL with its own scheme is never a file path, even when no app serves it:
+		// riotclient:///Applications/Other.app must not launch Other.app.
+		if (status != kLSApplicationNotFoundErr || _LSURLHasNonFileScheme(url))
+			return status;
+	}
+
+	// open(1) builds URLs via +URLWithString from a raw path, which may yield
+	// a scheme-less URL object. CFURLCopyFileSystemPath works either way.
+	pathStr = CFURLCopyFileSystemPath(url, kCFURLPOSIXPathStyle);
+	if (pathStr == NULL)
+		return paramErr;
+
+	if (!CFStringGetCString(pathStr, path, sizeof(path), kCFStringEncodingUTF8))
+	{
+		CFRelease(pathStr);
+		return paramErr;
+	}
+	CFRelease(pathStr);
+
+	if (params != NULL && params->application != NULL)
+	{
+		// Explicit target application wins; the URLs become its documents
+		// (delivered as argv once M2c lands; for now they are dropped).
+		char appPath[4096];
+		CFStringRef appStr;
+		status = FSRefMakePath(params->application, (UInt8*) appPath, sizeof(appPath) - 1);
+		if (status != noErr)
+			return status;
+		appStr = CFStringCreateWithCString(NULL, appPath, kCFStringEncodingUTF8);
+		appURL = CFURLCreateWithFileSystemPath(NULL, appStr, kCFURLPOSIXPathStyle, TRUE);
+		CFRelease(appStr);
+	}
+	else
+	{
+		size_t len = strlen(path);
+		Boolean looksLikeBundle = FALSE;
+
+		if (len > 4 && strcasecmp(path + len - 4, ".app") == 0)
+			looksLikeBundle = TRUE;
+		else if (stat(path, &st) == 0 && S_ISDIR(st.st_mode))
+		{
+			// Bundle without .app suffix (e.g. helper apps, frameworks-as-apps).
+			char plist[4096 + 32];
+			snprintf(plist, sizeof(plist), "%s/Contents/Info.plist", path);
+			if (stat(plist, &st) == 0)
+				looksLikeBundle = TRUE;
+		}
+
+		if (!looksLikeBundle)
+			return kLSApplicationNotFoundErr; // no default-handler DB yet
+
+		CFStringRef tmp = CFStringCreateWithCString(NULL, path, kCFStringEncodingUTF8);
+		appURL = CFURLCreateWithFileSystemPath(NULL, tmp, kCFURLPOSIXPathStyle, TRUE);
+		CFRelease(tmp);
+	}
+
+	if (appURL == NULL)
+		return paramErr;
+
+	status = _LSLaunchApplication(appURL);
+	CFRelease(appURL);
+
+	// _LSLaunchApplication returns 1 on failure instead of a MacErrors code.
+	if (status != noErr)
+		status = fnfErr;
+	return status;
+}
 
