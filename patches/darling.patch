+	uint32_t planeCount;
+	uint32_t reserved;
+	uint64_t memoryOffset;	/* == IOSURFACE_WIRE_DATA_OFFSET */
+	uint32_t width;
+	uint32_t height;
+	uint32_t bytesPerRow;
+	uint32_t bytesPerElement;
