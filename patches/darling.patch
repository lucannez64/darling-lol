--- /dev/null
+++ b/src/UserEventAgent/main.c
@@ -0,0 +1,626 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 darling-lol contributors
+ * Filesystem LaunchEvents provider for Darling's launchd-842.
+ *
+ * Serves the com.apple.fsevents.matching stream like macOS's UserEventAgent:
+ * - WatchPaths: one pulse per change anywhere at or below a watched path
+ *   (FSEvents reports directory trees), symlinks followed, bursts coalesced;
+ * - QueueDirectories: level state, true while any directory is non-empty;
+ * - KeepAlive PathState: level state, true while any path matches its wanted
+ *   existence.
+ * One inotify instance serves every watch; descriptors are reference counted
+ * because inotify returns one descriptor per inode.
+ */
+#include <sys/event.h>
+#include <sys/stat.h>
+#include <sys/inotify.h>
+#include <mach/mach_time.h>
+#include <servers/bootstrap.h>
+#include <xpc/xpc.h>
+#include <xpc/launchd_defs.h>
+#include <xpc/private/pipe.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static const char *stream = "com.apple.fsevents.matching";
+/* FSEvents-style latency: changes within this window become one pulse.
+ * Measured on macOS 15.5: changes 1 s apart already run twice (the second
+ * run deferred by launchd's ThrottleInterval), a burst of touches runs once,
+ * and a change while the job is still running is dropped by launchd.
+ */
+#define COALESCE_SECONDS 0.5
+/* Re-check in periodically in case a SIGUSR1 from launchd was missed. */
+#define RECHECK_SECONDS 30.0
+/* Retry incomplete watches (descriptor limits, races) this often. */
+#define RETRY_SECONDS 5.0
+/* Upper bound on directories watched below one path. */
+#define MAX_TREE_DIRECTORIES 65536
+
+#define TREE_MASK (IN_MODIFY | IN_ATTRIB | IN_CREATE | IN_DELETE | IN_MOVED_FROM | \
+	IN_MOVED_TO | IN_DELETE_SELF | IN_MOVE_SELF)
+
+static int queue = -1;
+static int notify = -1;
+static xpc_pipe_t launchd_pipe;
+static bool registrations_changed;
+
+struct descriptor {
+	int wd;
+	unsigned references;
+	struct descriptor *next;
+};
+static struct descriptor *descriptors;
+
+struct path_watch {
+	char *path;
+	char *parent;       /* Nearest existing ancestor of path. */
+	char *component;    /* Name below parent leading toward path. */
+	bool component_is_path; /* parent is the path's own directory. */
+	int parent_wd;
+	int *tree;          /* Descriptors for path and, for a directory, its subtree. */
+	size_t tree_count, tree_capacity;
+	struct stat previous;
+	bool existed, initialized, changed, dirty, incomplete;
+	struct path_watch *next;
+};
+
+struct event {
+	uint64_t token;
+	xpc_object_t description;
+	struct path_watch *paths;
+	bool watchpaths, state, state_known;
+	double pending; /* When the coalesced pulse is due; 0 when none. */
+	struct event *next;
+};
+static struct event *events;
+
+static void *allocate(size_t size)
+{
+	void *value = calloc(1, size);
+	if (!value) { perror("UserEventAgent: calloc"); exit(1); }
+	return value;
+}
+
+static char *copy_string(const char *value)
+{
+	char *copy = strdup(value);
+	if (!copy) { perror("UserEventAgent: strdup"); exit(1); }
+	return copy;
+}
+
+static double now(void)
+{
+	mach_timebase_info_data_t scale;
+	mach_timebase_info(&scale);
+	return (double)mach_absolute_time() * scale.numer / scale.denom / 1e9;
+}
+
+/* ---- launchd ---------------------------------------------------------- */
+
+static xpc_object_t request(uint64_t operation)
+{
+	xpc_object_t message = xpc_dictionary_create(NULL, NULL, 0);
+	xpc_dictionary_set_uint64(message, XPC_EVENT_ROUTINE_KEY_OP, operation);
+	xpc_dictionary_set_string(message, XPC_EVENT_ROUTINE_KEY_STREAM, stream);
+	return message;
+}
+
+static xpc_object_t routine(xpc_object_t message)
+{
+	xpc_object_t reply = NULL;
+	int error = xpc_pipe_routine(launchd_pipe, message, &reply);
+	xpc_release(message);
+	if (!error && reply && xpc_get_type(reply) == XPC_TYPE_DICTIONARY) {
+		int provider_error = (int)xpc_dictionary_get_uint64(reply, XPC_EVENT_ROUTINE_KEY_ERROR);
+		/* An unload may race a state update. Keep other tokens' pending pulses. */
+		if (provider_error == ESRCH) return reply;
+		error = provider_error;
+	}
+	if (error || !reply || xpc_get_type(reply) != XPC_TYPE_DICTIONARY) {
+		fprintf(stderr, "UserEventAgent: launchd event routine failed: %d\n", error);
+		if (reply) xpc_release(reply);
+		/* launchd restarts this KeepAlive provider; never cache an unsent state. */
+		exit(1);
+	}
+	return reply;
+}
+
+static bool set_state(uint64_t token, bool state)
+{
+	xpc_object_t message = request(XPC_EVENT_PROVIDER_SET_STATE);
+	xpc_dictionary_set_uint64(message, XPC_EVENT_ROUTINE_KEY_TOKEN, token);
+	xpc_dictionary_set_bool(message, XPC_EVENT_ROUTINE_KEY_STATE, state);
+	xpc_object_t reply = routine(message);
+	bool removed = xpc_dictionary_get_uint64(reply, XPC_EVENT_ROUTINE_KEY_ERROR) == ESRCH;
+	if (removed) registrations_changed = true;
+	xpc_release(reply);
+	return !removed;
+}
+
+/* launchd starts the job on true (deferred by ThrottleInterval, ignored while
+ * the job runs, as on macOS); the false that follows stops a relaunch loop.
+ */
+static void pulse_watchpaths(struct event *event)
+{
+	if (set_state(event->token, true)) set_state(event->token, false);
+	event->pending = 0;
+}
+
+/* ---- inotify descriptors -------------------------------------------- */
+
+static int descriptor_acquire(const char *path)
+{
+	int wd = inotify_add_watch(notify, path, TREE_MASK);
+	if (wd < 0) return -1;
+	for (struct descriptor *d = descriptors; d; d = d->next) {
+		if (d->wd == wd) { d->references++; return wd; }
+	}
+	struct descriptor *d = allocate(sizeof(*d));
+	d->wd = wd;
+	d->references = 1;
+	d->next = descriptors;
+	descriptors = d;
+	return wd;
+}
+
+static void descriptor_release(int wd)
+{
+	if (wd < 0) return;
+	for (struct descriptor **slot = &descriptors; *slot; slot = &(*slot)->next) {
+		struct descriptor *d = *slot;
+		if (d->wd != wd) continue;
+		if (--d->references == 0) {
+			(void)inotify_rm_watch(notify, wd);
+			*slot = d->next;
+			free(d);
+		}
+		return;
+	}
+}
+
+static void tree_add(struct path_watch *watch, int wd)
+{
+	if (watch->tree_count == watch->tree_capacity) {
+		size_t capacity = watch->tree_capacity ? watch->tree_capacity * 2 : 8;
+		int *tree = realloc(watch->tree, capacity * sizeof(*tree));
+		if (!tree) { perror("UserEventAgent: realloc"); exit(1); }
+		watch->tree = tree;
+		watch->tree_capacity = capacity;
+	}
+	watch->tree[watch->tree_count++] = wd;
+}
+
+static bool tree_contains(const struct path_watch *watch, int wd)
+{
+	for (size_t i = 0; i < watch->tree_count; ++i)
+		if (watch->tree[i] == wd) return true;
+	return false;
+}
+
+static void watch_release(struct path_watch *watch)
+{
+	for (size_t i = 0; i < watch->tree_count; ++i) descriptor_release(watch->tree[i]);
+	watch->tree_count = 0;
+	descriptor_release(watch->parent_wd);
+	watch->parent_wd = -1;
+}
+
+/* Watch a directory and every directory below it, without following
+ * symlinks inside the tree (FSEvents reports the link, not its target).
+ */
+static void watch_tree(struct path_watch *watch, const char *directory, size_t *budget)
+{
+	if (*budget == 0) { watch->incomplete = true; return; }
+	--*budget;
+	int wd = descriptor_acquire(directory);
+	if (wd < 0) { watch->incomplete = true; return; }
+	tree_add(watch, wd);
+	DIR *listing = opendir(directory);
+	if (!listing) return;
+	struct dirent *entry;
+	while ((entry = readdir(listing))) {
+		if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+		char child[PATH_MAX];
+		if (snprintf(child, sizeof(child), "%s/%s", directory, entry->d_name) >= (int)sizeof(child))
+			continue;
+		struct stat info;
+		if (lstat(child, &info) == 0 && S_ISDIR(info.st_mode))
+			watch_tree(watch, child, budget);
+	}
+	closedir(listing);
+}
+
+static char *parent_path(const char *path)
+{
+	char *parent = copy_string(path);
+	size_t length = strlen(parent);
+	while (length > 1 && parent[length - 1] == '/') parent[--length] = 0;
+	char *slash = strrchr(parent, '/');
+	if (slash == parent) parent[1] = 0;
+	else if (slash) *slash = 0;
+	else { free(parent); parent = copy_string("."); }
+	return parent;
+}
+
+/* First path component of path below parent. */
+static char *component_below(const char *path, const char *parent)
+{
+	const char *relative = path;
+	if (strcmp(parent, ".")) relative += strlen(parent);
+	else if (!strncmp(relative, "./", 2)) relative += 2;
+	while (*relative == '/') ++relative;
+	size_t length = strcspn(relative, "/");
+	char *component = allocate(length + 1);
+	memcpy(component, relative, length);
+	return component;
+}
+
+/* Re-establish every descriptor for one watched path. */
+static void watch_rebuild(struct path_watch *watch)
+{
+	watch_release(watch);
+	watch->incomplete = false;
+	watch->dirty = false;
+
+	struct stat info;
+	if (stat(watch->path, &info) == 0) {
+		char resolved[PATH_MAX];
+		const char *target = realpath(watch->path, resolved) ? resolved : watch->path;
+		if (S_ISDIR(info.st_mode)) {
+			size_t budget = MAX_TREE_DIRECTORIES;
+			watch_tree(watch, target, &budget);
+		} else {
+			/* Never open() the target: a FIFO would block the agent. */
+			int wd = descriptor_acquire(target);
+			if (wd >= 0) tree_add(watch, wd);
+			else watch->incomplete = true;
+		}
+	}
+
+	/* The nearest existing ancestor reports creation, deletion and renames
+	 * of the path itself or of a missing ancestor.
+	 */
+	char *parent = parent_path(watch->path);
+	for (;;) {
+		struct stat parent_info;
+		if (stat(parent, &parent_info) == 0 && S_ISDIR(parent_info.st_mode)) break;
+		if (!strcmp(parent, "/") || !strcmp(parent, ".")) break;
+		char *next = parent_path(parent);
+		free(parent);
+		parent = next;
+	}
+	free(watch->parent);
+	free(watch->component);
+	watch->parent = parent;
+	watch->component = component_below(watch->path, parent);
+	{
+		char *own = parent_path(watch->path);
+		watch->component_is_path = !strcmp(own, parent);
+		free(own);
+	}
+	watch->parent_wd = descriptor_acquire(parent);
+	if (watch->parent_wd < 0) watch->incomplete = true;
+}
+
+static bool same_snapshot(const struct stat *a, const struct stat *b)
+{
+	return a->st_dev == b->st_dev && a->st_ino == b->st_ino &&
+		a->st_mode == b->st_mode && a->st_size == b->st_size &&
+		a->st_nlink == b->st_nlink &&
+		a->st_mtimespec.tv_sec == b->st_mtimespec.tv_sec &&
+		a->st_mtimespec.tv_nsec == b->st_mtimespec.tv_nsec &&
+		a->st_ctimespec.tv_sec == b->st_ctimespec.tv_sec &&
+		a->st_ctimespec.tv_nsec == b->st_ctimespec.tv_nsec;
+}
+
+/* Returns whether the path changed since the last call. The stat snapshot
+ * also covers changes inotify cannot see (descriptor limits, other mounts).
+ */
+static bool refresh_path(struct path_watch *watch)
+{
+	struct stat info;
+	bool exists = stat(watch->path, &info) == 0;
+	bool changed = watch->changed || (watch->initialized &&
+		(exists != watch->existed || (exists && !same_snapshot(&info, &watch->previous))));
+	if (watch->initialized && (exists != watch->existed ||
+		(exists && (info.st_dev != watch->previous.st_dev || info.st_ino != watch->previous.st_ino))))
+		watch->dirty = true;
+	watch->changed = false;
+	if (exists) watch->previous = info;
+	watch->existed = exists;
+	watch->initialized = true;
+	if (watch->dirty) watch_rebuild(watch);
+	return changed;
+}
+
+static void handle_notification(const struct inotify_event *entry)
+{
+	for (struct event *event = events; event; event = event->next) {
+		for (struct path_watch *watch = event->paths; watch; watch = watch->next) {
+			if (entry->mask & IN_Q_OVERFLOW) {
+				watch->changed = watch->dirty = true;
+				continue;
+			}
+			if (tree_contains(watch, entry->wd)) {
+				if (!(entry->mask & IN_IGNORED)) watch->changed = true;
+				/* New or removed directories change the watched tree. */
+				if ((entry->mask & IN_ISDIR) &&
+					(entry->mask & (IN_CREATE | IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO)))
+					watch->dirty = true;
+				if (entry->mask & (IN_DELETE_SELF | IN_MOVE_SELF | IN_IGNORED))
+					watch->dirty = true;
+			}
+			if (entry->wd == watch->parent_wd) {
+				/* An entry for the path itself is a change; one for a missing
+				 * ancestor only moves the watch closer (macOS ignores it).
+				 */
+				if (entry->len && watch->component && !strcmp(entry->name, watch->component)) {
+					watch->dirty = true;
+					if (watch->component_is_path) watch->changed = true;
+				}
+				if (entry->mask & (IN_DELETE_SELF | IN_MOVE_SELF | IN_IGNORED))
+					watch->dirty = true;
+			}
+		}
+	}
+}
+
+static void drain_notifications(void)
+{
+	union { struct inotify_event alignment; char bytes[16384]; } buffer;
+	for (;;) {
+		ssize_t count = read(notify, buffer.bytes, sizeof(buffer.bytes));
+		if (count < 0 && errno == EINTR) continue;
+		if (count <= 0) break;
+		for (size_t offset = 0; offset + sizeof(struct inotify_event) <= (size_t)count;) {
+			const struct inotify_event *entry = (const void *)(buffer.bytes + offset);
+			size_t size = sizeof(*entry) + entry->len;
+			if (size > (size_t)count - offset) break;
+			handle_notification(entry);
+			offset += size;
+		}
+	}
+}
+
+/* ---- events ------------------------------------------------------------ */
+
+static bool directory_nonempty(const char *path)
+{
+	DIR *directory = opendir(path);
+	if (!directory) return false;
+	bool nonempty = false;
+	struct dirent *entry;
+	while ((entry = readdir(directory))) {
+		if (strcmp(entry->d_name, ".") && strcmp(entry->d_name, "..")) {
+			nonempty = true;
+			break;
+		}
+	}
+	closedir(directory);
+	return nonempty;
+}
+
+static bool pathstate_matches(const char *path, xpc_object_t wanted)
+{
+	struct stat info;
+	if (xpc_get_type(wanted) != XPC_TYPE_BOOL) return false;
+	bool exists = stat(path, &info) == 0;
+	/* EACCES and other failures do not establish that the path is absent. */
+	if (!exists && errno != ENOENT && errno != ENOTDIR) return false;
+	return exists == xpc_bool_get_value(wanted);
+}
+
+static void add_path(struct event *event, const char *path)
+{
+	if (!path || !*path) return;
+	struct path_watch *watch = allocate(sizeof(*watch));
+	watch->path = copy_string(path);
+	watch->parent_wd = -1;
+	watch->next = event->paths;
+	event->paths = watch;
+	watch_rebuild(watch);
+	(void)refresh_path(watch); /* Baseline; launchd runs a first registration itself. */
+}
+
+static struct event *new_event(uint64_t token, xpc_object_t description)
+{
+	struct event *event = allocate(sizeof(*event));
+	event->token = token;
+	event->description = xpc_retain(description);
+	xpc_object_t paths = xpc_dictionary_get_value(description, "WatchPaths");
+	event->watchpaths = paths && xpc_get_type(paths) == XPC_TYPE_ARRAY;
+	if (!event->watchpaths) paths = xpc_dictionary_get_value(description, "QueueDirectories");
+	if (paths && xpc_get_type(paths) == XPC_TYPE_ARRAY) {
+		for (size_t i = 0; i < xpc_array_get_count(paths); ++i)
+			add_path(event, xpc_array_get_string(paths, i));
+	}
+	xpc_object_t states = xpc_dictionary_get_value(description, "PathState");
+	if (states && xpc_get_type(states) == XPC_TYPE_DICTIONARY) {
+		xpc_dictionary_apply(states, ^bool(const char *path, xpc_object_t value) {
+			if (xpc_get_type(value) == XPC_TYPE_BOOL) add_path(event, path);
+			return true;
+		});
+	}
+	return event;
+}
+
+static void free_event(struct event *event)
+{
+	while (event->paths) {
+		struct path_watch *watch = event->paths;
+		event->paths = watch->next;
+		watch_release(watch);
+		free(watch->tree);
+		free(watch->path);
+		free(watch->parent);
+		free(watch->component);
+		free(watch);
+	}
+	xpc_release(event->description);
+	free(event);
+}
+
+static void reconcile_events(xpc_object_t registrations)
+{
+	/* Deliver queued notifications to the existing watches first: a new watch
+	 * can share a descriptor and must not inherit changes from before it was
+	 * registered.
+	 */
+	drain_notifications();
+	struct event *old = events;
+	events = NULL;
+	/* CHECK_IN supplies a flat [token, dictionary, token, dictionary, ...]. */
+	for (size_t i = 0; i + 1 < xpc_array_get_count(registrations); i += 2) {
+		uint64_t token = xpc_array_get_uint64(registrations, i);
+		xpc_object_t description = xpc_array_get_value(registrations, i + 1);
+		if (!token || !description || xpc_get_type(description) != XPC_TYPE_DICTIONARY) continue;
+		struct event **slot = &old;
+		while (*slot && (*slot)->token != token) slot = &(*slot)->next;
+		struct event *event = *slot;
+		if (event) {
+			*slot = event->next;
+			if (!xpc_equal(event->description, description)) {
+				free_event(event);
+				event = NULL;
+			}
+		}
+		if (!event) event = new_event(token, description);
+		event->next = events;
+		events = event;
+	}
+	while (old) {
+		struct event *next = old->next;
+		free_event(old);
+		old = next;
+	}
+}
+
+static void provider_check_in(void)
+{
+	xpc_object_t reply = routine(request(XPC_EVENT_PROVIDER_CHECK_IN));
+	xpc_object_t registrations = xpc_dictionary_get_value(reply, XPC_EVENT_ROUTINE_KEY_EVENTS);
+	if (!registrations || xpc_get_type(registrations) != XPC_TYPE_ARRAY ||
+		xpc_array_get_count(registrations) % 2) {
+		fprintf(stderr, "UserEventAgent: malformed event registration reply\n");
+		exit(1);
+	}
+	reconcile_events(registrations);
+	xpc_release(reply);
+}
+
+static void evaluate_events(double time, bool retry)
+{
+	for (struct event *event = events; event; event = event->next) {
+		bool changed = false, state = false;
+		for (struct path_watch *watch = event->paths; watch; watch = watch->next) {
+			if (retry && watch->incomplete) watch->dirty = true;
+			changed |= refresh_path(watch);
+		}
+		if (event->watchpaths) {
+			if (!event->state_known) event->state_known = set_state(event->token, false);
+			if (changed && !event->pending) event->pending = time + COALESCE_SECONDS;
+			if (event->pending && time >= event->pending) pulse_watchpaths(event);
+			continue;
+		}
+		xpc_object_t paths = xpc_dictionary_get_value(event->description, "QueueDirectories");
+		if (paths && xpc_get_type(paths) == XPC_TYPE_ARRAY) {
+			for (size_t i = 0; i < xpc_array_get_count(paths); ++i) {
+				const char *path = xpc_array_get_string(paths, i);
+				if (path) state |= directory_nonempty(path);
+			}
+		}
+		xpc_object_t states = xpc_dictionary_get_value(event->description, "PathState");
+		if (states && xpc_get_type(states) == XPC_TYPE_DICTIONARY) {
+			__block bool matches = false;
+			xpc_dictionary_apply(states, ^bool(const char *path, xpc_object_t wanted) {
+				matches |= pathstate_matches(path, wanted);
+				return true;
+			});
+			state |= matches;
+		}
+		if (!event->state_known || state != event->state) {
+			event->state_known = set_state(event->token, state);
+			event->state = state;
+		}
+	}
+}
+
+/* Sleep until the earliest pending pulse, but at most one second so the stat
+ * snapshots still catch changes inotify cannot report.
+ */
+static struct timespec next_timeout(double time)
+{
+	double wait = 1.0;
+	for (struct event *event = events; event; event = event->next) {
+		if (event->pending && event->pending - time < wait)
+			wait = event->pending - time;
+	}
+	if (wait < 0.01) wait = 0.01;
+	struct timespec timeout = { (time_t)wait, (long)((wait - (time_t)wait) * 1e9) };
+	return timeout;
+}
+
+int main(void)
+{
+	queue = kqueue();
+	if (queue < 0) { perror("UserEventAgent: kqueue"); return 1; }
+	notify = inotify_init1(IN_NONBLOCK);
+	if (notify < 0) { perror("UserEventAgent: inotify"); return 1; }
+	(void)fcntl(notify, F_SETFD, FD_CLOEXEC);
+
+	/* Install before CHECK_IN: launchd may send SIGUSR1 as soon as it replies. */
+	signal(SIGUSR1, SIG_IGN);
+	struct kevent changes[2];
+	EV_SET(&changes[0], SIGUSR1, EVFILT_SIGNAL, EV_ADD, 0, 0, NULL);
+	EV_SET(&changes[1], notify, EVFILT_READ, EV_ADD, 0, 0, NULL);
+	if (kevent(queue, changes, 2, NULL, 0, NULL) < 0) {
+		perror("UserEventAgent: kevent registration"); return 1;
+	}
+
+	/* launchd serves event routines directly on the bootstrap port. */
+	launchd_pipe = xpc_pipe_create_from_port(bootstrap_port, 0);
+	if (!launchd_pipe) return 1;
+	provider_check_in();
+	double last_check_in = now(), last_retry = last_check_in;
+
+	for (;;) {
+		double time = now();
+		bool retry = time - last_retry >= RETRY_SECONDS;
+		if (retry) last_retry = time;
+		evaluate_events(time, retry);
+		if (registrations_changed || time - last_check_in >= RECHECK_SECONDS) {
+			registrations_changed = false;
+			provider_check_in();
+			last_check_in = now();
+			continue;
+		}
+
+		struct timespec timeout = next_timeout(time);
+		struct kevent notifications[16];
+		int count = kevent(queue, NULL, 0, notifications, 16, &timeout);
+		if (count < 0) {
+			if (errno == EINTR) continue;
+			perror("UserEventAgent: kevent"); return 1;
+		}
+		bool recheck = false;
+		for (int i = 0; i < count; ++i) {
+			if (notifications[i].filter == EVFILT_SIGNAL && notifications[i].ident == SIGUSR1)
+				recheck = true;
+			else if (notifications[i].filter == EVFILT_READ && (int)notifications[i].ident == notify)
+				drain_notifications();
+		}
+		if (recheck) {
+			provider_check_in();
+			last_check_in = now();
+		}
+	}
+}
