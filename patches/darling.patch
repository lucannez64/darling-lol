+static constexpr Float32 kVolumeMinDecibels = -96.0f;
+static constexpr Float32 kVolumeMaxDecibels = 0.0f;
+
+static Float32 volumeScalarToDecibels(Float32 scalar)
+{
+	if (scalar <= 0.0f)
+		return kVolumeMinDecibels;
+	if (scalar >= 1.0f)
+		return kVolumeMaxDecibels;
+	Float32 db = 20.0f * std::log10(scalar);
+	return std::clamp(db, kVolumeMinDecibels, kVolumeMaxDecibels);
+}
+
+static Float32 volumeDecibelsToScalar(Float32 db)
+{
+	if (db <= kVolumeMinDecibels)
+		return 0.0f;
+	if (db >= kVolumeMaxDecibels)
+		return 1.0f;
+	Float32 scalar = std::pow(10.0f, db / 20.0f);
+	return std::clamp(scalar, 0.0f, 1.0f);
+}
