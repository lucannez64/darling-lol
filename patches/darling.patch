+/* The runloop timer's handler: re-read the state file fresh each tick. */
+static void DisplayLinkMainTimerF(CFRunLoopTimerRef timer, void* info) {
+	CVLinkStateRec rec;
+	if (!readState(&rec))
+		return;
+	displayLinkTickFromRec(&rec);
+	writeState(&rec);
