+
+static dev_t *ADev = (dev_t *) NULL;	/* device numbers besides DevDev found
+					 * inside DDEV_DEVPATH */
+static int ADevA = 0;			/* entries allocated to ADev[] */
+static int ADevU = 0;			/* entries used in ADev[] */
+
+
+/*
+ * Local function prototypes
