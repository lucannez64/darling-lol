+ */
+
+#define	WILLDROPGID	1
+
+
+/*
+ * zeromem is a macro that uses bzero or memset.
+ */
+
+#define	zeromem(a, l)	memset(a, 0, l)
+
+#endif	/* !defined(LSOF_MACHINE_H) */
