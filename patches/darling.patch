+/* sturdy host-shared record, written fresh on every mutation. */
+struct CVLinkStateRec {
+	uint32_t magic;      /* 0xC81DFA10 */
+	uint32_t version;
+	void* callback;
+	void* userInfo;
+	uint32_t running;
+	uint32_t alive;
+	uint32_t ticks;
+	uint32_t nullTicks;
+    /* Per-link retain count; in the header this is the number of slots. */
+	uint32_t refs;
+	uint64_t reserved;
+    CVDisplayLinkRef link;
+};
+static const uint32_t kStateMagic = 0xC81DFA10u;
+static const uint32_t kStateVersion = 1;
+
+static void traceLog(const char* fmt, uint64_t a, uint64_t b) {
+    if (!getenv("RCLOL_CV_TRACE")) return;
+	char msg[192];
+	struct timespec ts;
+#ifdef CLOCK_MONOTONIC
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+#else
+	ts.tv_sec = (time_t) mach_absolute_time() / 1000000000ull;
+	ts.tv_nsec = 0;
+#endif
+	snprintf(msg, sizeof(msg), "%lld.%03ld %d %s",
+	    (long long) ts.tv_sec, ts.tv_nsec / 1000000,
+	    (int) getpid(), /* msg below */ "");
+	snprintf(msg + strlen(msg), sizeof(msg) - strlen(msg), fmt, a, b);
+	int fd = open("/Volumes/SystemRoot/tmp/opencode/cvpump.log",
+	    1 | 0x200 | 8, 0644);
+	if (fd >= 0) { write(fd, msg, strlen(msg)); close(fd); }
+}
+
+static const char* statePathFor(void) {
+	static char path[128];
+	static bool init = false;
+	if (!init) {
+		snprintf(path, sizeof(path), "/dev/shm/darling-cvlink-%d.state",
+		    (int) getpid());
+		init = true;
+	}
+	return path;
+}
+
+/* These private records live in the host /dev/shm. Bypass recursive guest
+ * path expansion on Chromium's small callback stacks, and avoid frame-time RPC. */
+extern "C" long __lolsys_syscall(long,long,long,long,long,long,int);
+static int clockOpen(void) { return (int)__lolsys_syscall((long)statePathFor(),66,0600,0,0,0,2); }
+static void clockClose(int fd) { __lolsys_syscall(fd,0,0,0,0,0,3); }
+static long clockRead(int fd,void *p,size_t n,off_t offset) { return __lolsys_syscall(fd,(long)p,n,offset,0,0,17); }
+static long clockWrite(int fd,const void *p,size_t n,off_t offset) { return __lolsys_syscall(fd,(long)p,n,offset,0,0,18); }
+static int clockFlock(int fd,int op) { return (int)__lolsys_syscall(fd,op,0,0,0,0,73); }
+/* The first record owns the process-wide lock and slot count. Every link has
+ * its own record after it: Chromium uses separate links for its Viz and GPU
+ * threads even on one display. A process-wide callback silently drops one. */
+static bool readHeader(int fd, CVLinkStateRec *out) {
+    return clockRead(fd, out, sizeof(*out), 0) == sizeof(*out) &&
+        out->magic == kStateMagic && out->version == 2;
+}
+static off_t slotOffset(uint32_t slot) {
+    return ((off_t)slot + 1) * sizeof(CVLinkStateRec);
+}
+// Callback reentrancy belongs to the calling thread, not a fallible file
+// record. Borrow the pump's locked descriptor; other threads still lock it.
+static __thread int callbackClockFD = -1;
+struct CVCallbackScope {
+    int previous;
+    explicit CVCallbackScope(int fd) : previous(callbackClockFD) { callbackClockFD = fd; }
+    ~CVCallbackScope() { callbackClockFD = previous; }
+};
+struct CVStateGuard {
+    int fd; bool locked; bool borrowed;
+    CVStateGuard() : fd(callbackClockFD), locked(false), borrowed(fd >= 0) {
+        if (borrowed) return;
+        fd = clockOpen();
+        if (fd < 0) return;
+        int result;
+        do { result = clockFlock(fd, LOCK_EX); } while (result == -4); // Linux EINTR.
+        locked = result == 0;
+        if (!locked) { clockClose(fd); fd = -1; }
+    }
+    ~CVStateGuard() {
+        if (fd >= 0 && !borrowed) {
+            if (locked) clockFlock(fd, LOCK_UN);
+            clockClose(fd);
+        }
+    }
+};
+static bool readState(int fd, CVLinkStateRec *out, CVDisplayLinkRef link) {
+    if (fd < 0) return false;
+    CVLinkStateRec header;
+    bool found = false;
+    if (readHeader(fd, &header)) {
+        for (uint32_t i = 0; i < header.refs; ++i) {
+            if (clockRead(fd, out, sizeof(*out), slotOffset(i)) != sizeof(*out)) break;
+            if (out->alive && out->link == link) { found = true; break; }
+        }
+    }
+    return found;
+}
+static bool writeState(int fd, const CVLinkStateRec *rec) {
+    if (fd < 0) return false;
+    CVLinkStateRec header, current;
+    bool written = false;
+    if (readHeader(fd, &header)) {
+        for (uint32_t i = 0; i < header.refs; ++i) {
+            if (clockRead(fd, &current, sizeof(current), slotOffset(i)) != sizeof(current)) break;
+            if (current.link == rec->link) {
+                written = clockWrite(fd, rec, sizeof(*rec), slotOffset(i)) == sizeof(*rec);
+                break;
+            }
+        }
+    }
+    return written;
+}
+__attribute__((constructor)) static void initializeDisplayClockRecord(void) {
+    int fd = clockOpen();
+    if (fd < 0) return;
+    CVLinkStateRec header = {};
+    header.magic = kStateMagic; header.version = 2; header.alive = 1;
+    clockWrite(fd, &header, sizeof(header), 0);
+    clockClose(fd);
+}
+static bool registerDisplayLink(CVDisplayLinkRef link) {
+    CVStateGuard guard;
+    CVLinkStateRec header, current;
+    if (guard.fd < 0 || !readHeader(guard.fd, &header)) return false;
+    uint32_t slot;
+    for (slot = 0; slot < header.refs; ++slot) {
+        if (clockRead(guard.fd, &current, sizeof(current), slotOffset(slot)) != sizeof(current)) return false;
+        if (!current.alive) break;
+    }
+    CVLinkStateRec rec = {};
+    rec.magic = kStateMagic; rec.version = kStateVersion;
+    rec.alive = 1; rec.refs = 1; rec.link = link;
+    if (clockWrite(guard.fd, &rec, sizeof(rec), slotOffset(slot)) != sizeof(rec)) return false;
+    if (slot == header.refs) {
+        ++header.refs;
+        return clockWrite(guard.fd, &header, sizeof(header), 0) == sizeof(header);
+    }
+    return true;
+}
