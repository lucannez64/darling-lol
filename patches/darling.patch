+static void setupLaunchdState(void)
+{
+	char path[4096];
+	const uid_t saved_euid = geteuid();
+	const gid_t saved_egid = getegid();
+	const char* dirs[] = {
+		"/private/var/db/launchd.db",
+		"/private/var/db/launchd.db/com.apple.launchd"
+	};
+
+	// Persistent state belongs in the writable prefix, not the root-owned
+	// runtime image. Repair old prefixes as well as initializing new ones.
+	if (setegid(g_originalGid) != 0 || seteuid(g_originalUid) != 0)
+	{
+		fprintf(stderr, "Cannot select prefix owner for launchd state: %s\n", strerror(errno));
+		exit(1);
+	}
+
+	const mode_t saved_mask = umask(0022);
+	for (size_t i = 0; i < sizeof(dirs)/sizeof(dirs[0]); i++)
+	{
+		snprintf(path, sizeof(path), "%s%s", prefix, dirs[i]);
+		createLaunchdStateDir(path);
+	}
+
+	umask(saved_mask);
+
+	if (seteuid(saved_euid) != 0 || setegid(saved_egid) != 0)
+	{
+		fprintf(stderr, "Cannot restore credentials after launchd state setup: %s\n", strerror(errno));
+		exit(1);
+	}
+}
