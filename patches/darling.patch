 */
 
 #import <AVFoundation/AVCaptureDevice.h>
+#include <dispatch/dispatch.h>
+#include <dlfcn.h>
+#include <CoreAudio/AudioHardware.h>
 
 @implementation AVCaptureDevice
 
++ (NSArray *)devices {
+    return [NSArray array];
+}
+
++ (NSArray *)devicesWithMediaType:(AVMediaType)mediaType {
+    (void)mediaType;
+    return [self devices];
+}
+
++ (AVCaptureDevice *)defaultDeviceWithMediaType:(AVMediaType)mediaType {
+    (void)mediaType;
+    return nil;
+}
+
+
+// Darling has no TCC consent store. Microphone input works through CoreAudio
+// (PulseAudio), so audio is authorized whenever CoreAudio reports a default input
+// device. CoreAudio is looked up at run time: AVFoundation does not link it, and
+// this query only reads its device table (no PulseAudio connection is made).
+static BOOL hasDefaultInputDevice(void)
+{
+	static OSStatus (*getProperty)(AudioObjectID, const AudioObjectPropertyAddress*, UInt32, const void*, UInt32*, void*);
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		// Never closed: CoreAudio keeps process-wide state once loaded.
+		void* coreAudio = dlopen("/System/Library/Frameworks/CoreAudio.framework/CoreAudio", RTLD_LAZY | RTLD_LOCAL);
+		if (coreAudio)
+			getProperty = dlsym(coreAudio, "AudioObjectGetPropertyData");
+	});
+	if (!getProperty)
+		return NO;
+	AudioDeviceID device = kAudioObjectUnknown;
+	UInt32 size = sizeof(device);
+	AudioObjectPropertyAddress address = {
+		kAudioHardwarePropertyDefaultInputDevice, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMaster
+	};
+	return getProperty(kAudioObjectSystemObject, &address, 0, NULL, &size, &device) == noErr
+		&& device != kAudioObjectUnknown;
+}
+
++ (AVAuthorizationStatus)authorizationStatusForMediaType:(AVMediaType)mediaType
+{
+	// There is no camera capture; report Denied so callers take their
+	// no-access path instead of raising an unrecognized-selector exception.
+	if ([mediaType isEqualToString: AVMediaTypeAudio] && hasDefaultInputDevice())
+		return AVAuthorizationStatusAuthorized;
+	return AVAuthorizationStatusDenied;
+}
+
++ (void)requestAccessForMediaType:(AVMediaType)mediaType completionHandler:(void (^)(BOOL))handler
+{
+	if (!handler)
+		return;
+	BOOL granted = [self authorizationStatusForMediaType: mediaType] == AVAuthorizationStatusAuthorized;
+	// macOS calls the handler later on an arbitrary queue, never inside this call;
+	// callers may hold locks here or wait on the main thread for the result.
+	void (^copied)(BOOL) = [handler copy];
+	dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+		copied(granted);
+		[copied release];
+	});
+}
+
 - (NSMethodSignature *)methodSignatureForSelector:(SEL)aSelector {
     return [NSMethodSignature signatureWithObjCTypes: "v@:"];
 }
