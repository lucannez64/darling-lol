+/*
+ * sv_fmt_str() - save format string
+ */
+
+static char *
+sv_fmt_str(f)
+	char *f;			/* format string */
+{
+	char *cp;
+	MALLOC_S l;
+
+	l = (MALLOC_S)(strlen(f) + 1);
+	if (!(cp = (char *)malloc(l))) {
+	    (void) fprintf(stderr,
+		"%s: can't allocate %d bytes for format: %s\n", Pn, (int)l, f);
+	    Exit(1);
+	}
+	(void) snpf(cp, l, "%s", f);
+	return(cp);
+}
