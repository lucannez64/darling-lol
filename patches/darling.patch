+/*
+ * isnullstr() - is it a null string?
+ */
+
+static char *
+isnullstr(s)
+	char *s;			/* string pointer */
+{
+	if (!s)
+		return((char *)NULL);
+	while (*s) {
+		if (*s != ' ')
+			return(s);
+		s++;
+	}
+	return((char *)NULL);
+}
