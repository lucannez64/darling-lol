+			  (MALLOC_S)(LPROCINCR * sizeof(struct lproc)))))
+	    {
+		(void) fprintf(stderr,
+		    "%s: no malloc space for %d local proc structures\n",
+		    Pn, LPROCINCR);
+		Exit(1);
+	    }
+	    sz = LPROCINCR;
+	} else if ((Nlproc + 1) > sz) {
+	    sz += LPROCINCR;
+	    if (!(Lproc = (struct lproc *)realloc((MALLOC_P *)Lproc,
+			  (MALLOC_S)(sz * sizeof(struct lproc)))))
