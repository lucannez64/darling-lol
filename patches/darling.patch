diff --git a/src/shellspawn/shellspawn-fds.h b/src/shellspawn/shellspawn-fds.h
new file mode 100644
index 0000000..1f3c473
--- /dev/null
+++ b/src/shellspawn/shellspawn-fds.h
@@ -0,0 +1,37 @@
+#ifndef SHELLSPAWN_FDS_H
+#define SHELLSPAWN_FDS_H
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+// Preserve every source before replacing any standard descriptor: sources can
+// themselves be 0, 1 or 2 when the daemon was launched with closed stdio.
+static int shellspawn_remap_stdio(const int streams[3])
+{
+    int saved[3] = { -1, -1, -1 };
+    for (int i = 0; i < 3; ++i) {
+        saved[i] = fcntl(streams[i], F_DUPFD_CLOEXEC, 3);
+        if (saved[i] < 0) goto failure;
+    }
+    for (int i = 0; i < 3; ++i)
+        if (dup2(saved[i], i) < 0) goto failure;
+    for (int i = 0; i < 3; ++i) close(saved[i]);
+    return 0;
+failure: {
+    int error = errno;
+    for (int i = 0; i < 3; ++i) if (saved[i] >= 0) close(saved[i]);
+    errno = error;
+    return -1;
+}}
+
+static void shellspawn_close_streams(int streams[3])
+{
+    for (int i = 0; i < 3; ++i) {
+        int fd = streams[i];
+        streams[i] = -1;
+        for (int j = i + 1; j < 3; ++j)
+            if (streams[j] == fd) streams[j] = -1;
+        if (fd > STDERR_FILENO) close(fd);
+    }
+}
+#endif
