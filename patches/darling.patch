diff --git a/src/diskdev_cmds/CMakeLists.txt b/src/diskdev_cmds/CMakeLists.txt
new file mode 100644
index 00000000..f7c49187
--- /dev/null
+++ b/src/diskdev_cmds/CMakeLists.txt
@@ -0,0 +1,42 @@
+project(diskdev_cmds)
+
+# mount and umount from Apple's diskdev_cmds-751.80.2
+# (apple-oss-distributions/diskdev_cmds), installed at /sbin like macOS 15.5.
+# Only the macOS code paths are built. FSKit is not available, so
+# fskit_support.m compiles its "no FSKit" branch (invoke_tool_from_fskit()
+# returns ENOTSUP), exactly as on a Darwin system without FSKit.
+
+add_definitions(-nostdinc)
+add_compile_options(
+	-include ${CMAKE_CURRENT_SOURCE_DIR}/include/darling_mount_compat.h
+	# booted_rosv() passes NULL as sysctlbyname()'s newlen, as Apple's source does.
+	-Wno-int-conversion
+)
+
+include_directories(
+	${CMAKE_CURRENT_SOURCE_DIR}/include
+	${CMAKE_CURRENT_SOURCE_DIR}/disklib
+	${CMAKE_CURRENT_SOURCE_DIR}/edt_fstab
+	${CMAKE_CURRENT_SOURCE_DIR}/fsck.tproj
+	${CMAKE_CURRENT_SOURCE_DIR}/mount_flags_dir
+	${CMAKE_CURRENT_SOURCE_DIR}/mount.tproj
+	${CMAKE_SOURCE_DIR}/src/external/libc/libdarwin/h
+)
+
+add_darling_executable(mount
+	mount.tproj/mount.c
+	mount_flags_dir/mount_flags.c
+	disklib/vfslist.c
+	disklib/fskit_support.m
+)
+
+add_darling_executable(umount
+	umount.tproj/umount.c
+	disklib/vfslist.c
+)
+
+install(TARGETS mount umount DESTINATION libexec/darling/sbin)
+install(FILES mount.tproj/mount.8 umount.tproj/umount.8
+	DESTINATION libexec/darling/usr/share/man/man8)
+install(FILES mount.tproj/fstab.5
+	DESTINATION libexec/darling/usr/share/man/man5)
