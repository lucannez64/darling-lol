+ along with Darling.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+// darling-lol: block-based property listeners and CATapDescription, linked by
+// the current Riot Client's Electron. The listeners are built on the
+// function-pointer API: each registration owns a copy of the block and the queue
+// it is delivered on.
+
+#include <CoreAudio/AudioHardware.h>
+#include <dispatch/dispatch.h>
+#include <Block.h>
+#include <stdlib.h>
+#include <string.h>
+#include <mutex>
+#include <vector>
+#import <objc/NSObject.h>
+#import <objc/runtime.h>
+
+namespace
+{
+
+struct BlockListener
+{
+	AudioObjectID object;
+	AudioObjectPropertyAddress address;
+	dispatch_queue_t queue;
+	AudioObjectPropertyListenerBlock block;
+};
+
+std::mutex g_listenersLock;
+std::vector<BlockListener*> g_listeners;
+
+bool sameAddress(const AudioObjectPropertyAddress& a, const AudioObjectPropertyAddress& b)
+{
+	return a.mSelector == b.mSelector && a.mScope == b.mScope && a.mElement == b.mElement;
+}
+
+OSStatus deliverToBlock(AudioObjectID inObjectID, UInt32 inNumberAddresses,
+		const AudioObjectPropertyAddress* inAddresses, void* inClientData)
+{
+	BlockListener* listener = static_cast<BlockListener*>(inClientData);
+	AudioObjectPropertyListenerBlock block = listener->block;
+
+	if (listener->queue == NULL)
+	{
+		block(inNumberAddresses, inAddresses);
+		return noErr;
+	}
+
+	// The addresses only live for this call; the block runs later on its queue.
+	size_t size = inNumberAddresses * sizeof(AudioObjectPropertyAddress);
+	AudioObjectPropertyAddress* copy = static_cast<AudioObjectPropertyAddress*>(malloc(size ? size : 1));
+	if (copy == NULL)
+		return kAudioHardwareUnspecifiedError;
+	memcpy(copy, inAddresses, size);
+	dispatch_async(listener->queue, ^{
+		block(inNumberAddresses, copy);
+		free(copy);
+	});
+	return noErr;
+}
+
+}
+
+extern "C" OSStatus AudioObjectAddPropertyListenerBlock(AudioObjectID inObjectID,
+		const AudioObjectPropertyAddress* inAddress, dispatch_queue_t inDispatchQueue,
+		AudioObjectPropertyListenerBlock inListener)
+{
+	if (inAddress == NULL || inListener == NULL)
+		return kAudioHardwareIllegalOperationError;
+
+	BlockListener* listener = new BlockListener{inObjectID, *inAddress, inDispatchQueue,
+		Block_copy(inListener)};
+	if (inDispatchQueue != NULL)
+		dispatch_retain(inDispatchQueue);
+
+	OSStatus status = AudioObjectAddPropertyListener(inObjectID, inAddress, deliverToBlock, listener);
+	if (status != noErr)
+	{
+		if (inDispatchQueue != NULL)
+			dispatch_release(inDispatchQueue);
+		Block_release(listener->block);
+		delete listener;
+		return status;
+	}
+
+	std::lock_guard<std::mutex> guard(g_listenersLock);
+	g_listeners.push_back(listener);
+	return noErr;
+}
+
+extern "C" OSStatus AudioObjectRemovePropertyListenerBlock(AudioObjectID inObjectID,
+		const AudioObjectPropertyAddress* inAddress, dispatch_queue_t inDispatchQueue,
+		AudioObjectPropertyListenerBlock inListener)
+{
+	if (inAddress == NULL || inListener == NULL)
+		return kAudioHardwareIllegalOperationError;
+
+	BlockListener* listener = NULL;
+	{
+		std::lock_guard<std::mutex> guard(g_listenersLock);
+		for (auto it = g_listeners.begin(); it != g_listeners.end(); ++it)
+		{
+			// Block_copy of a heap block returns the same block, so the caller's
+			// pointer identifies its registration.
+			if ((*it)->object == inObjectID && sameAddress((*it)->address, *inAddress)
+				&& (*it)->queue == inDispatchQueue && (*it)->block == inListener)
+			{
+				listener = *it;
+				g_listeners.erase(it);
+				break;
+			}
+		}
+	}
+	if (listener == NULL)
+		return kAudioHardwareUnknownPropertyError;
+
+	OSStatus status = AudioObjectRemovePropertyListener(inObjectID, inAddress, deliverToBlock, listener);
+	// A delivery already queued holds its own reference to the block.
+	if (listener->queue != NULL)
+		dispatch_release(listener->queue);
+	Block_release(listener->block);
+	delete listener;
+	return status;
+}
+
+// Process taps (macOS 14.2) are not supported; the class exists so the binary
+// links, and every message it does not implement returns nil or 0. CoreAudio
+// does not link Foundation, so unknown selectors are resolved with an IMP
+// instead of being forwarded.
+static id returnNil(id self, SEL _cmd, ...)
+{
+	return nil;
+}
+
+@interface CATapDescription : NSObject
+@end
+
+@implementation CATapDescription
+
++ (BOOL)resolveClassMethod:(SEL)sel
+{
+	return class_addMethod(object_getClass(self), sel, (IMP) returnNil, "@@:");
+}
+
++ (BOOL)resolveInstanceMethod:(SEL)sel
+{
+	return class_addMethod(self, sel, (IMP) returnNil, "@@:");
+}
+
+@end
