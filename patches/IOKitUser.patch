diff --git a/IOKitLib.c b/IOKitLib.c
index 81ed8f7..fd964ee 100644
--- a/IOKitLib.c
+++ b/IOKitLib.c
@@ -110,6 +110,7 @@ gIOKitLibSerializeOptions = kIOCFSerializeToBinary;
 
 extern 	mach_port_t 	mach_task_self();
 const 	mach_port_t 	kIOMasterPortDefault = MACH_PORT_NULL;
+const 	mach_port_t 	kIOMainPortDefault = MACH_PORT_NULL; /* darling-lol: macOS 12 name, linked by the current Riot Client */
 
 static mach_port_t
 __IOGetDefaultMasterPort()
@@ -884,6 +885,15 @@ IONotificationPortGetRunLoopSource(
     CFMachPortContext 	    context;
     Boolean		            cfReusedPort = false;
 
+#ifdef DARLING
+    /* A notification port can still be absent when allocation fails or
+     * the IOKit service is unavailable. Keep the accessor tolerant of
+     * that failure; CFRunLoopAddSource already ignores NULL sources.
+     * Normal power registration is implemented by iokitd. */
+    if (!notify)
+        return NULL;
+#endif
+
     if (notify->source)
         return (notify->source);
     
@@ -934,6 +944,11 @@ mach_port_t
 IONotificationPortGetMachPort(
 	IONotificationPortRef	notify )
 {
+#ifdef DARLING
+    /* See IONotificationPortGetRunLoopSource: fail soft on NULL. */
+    if (!notify)
+        return MACH_PORT_NULL;
+#endif
     return( notify->wakePort );
 }
 
