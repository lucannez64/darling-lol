+#ifndef DARLING_KEYCHAIN_H
+#define DARLING_KEYCHAIN_H
+
+#include <Security/SecItem.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    DarlingKeychainAdd,
+    DarlingKeychainFind,
+    DarlingKeychainUpdate,
+    DarlingKeychainDelete,
+} DarlingKeychainOperation;
+
+bool DarlingKeychainHandles(CFDictionaryRef query, DarlingKeychainOperation operation);
+OSStatus DarlingKeychainPerform(DarlingKeychainOperation operation, CFDictionaryRef query,
+                                CFDictionaryRef changes, CFTypeRef *result);
+/* Removes a key this store holds; used to undo half of a failed key pair. */
