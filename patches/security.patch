diff --git a/OSX/libsecurity_codesigning/lib/rclol_signing_trace.h b/OSX/libsecurity_codesigning/lib/rclol_signing_trace.h
new file mode 100644
index 00000000..e4c04257
--- /dev/null
+++ b/OSX/libsecurity_codesigning/lib/rclol_signing_trace.h
@@ -0,0 +1,41 @@
+// darling-lol: opt-in trace of the code-signing calls a loaded module makes.
+//
+// MVG validates code signatures through these system entry points; the module
+// itself is obfuscated, so the path/requirement it checks cannot be read
+// statically. This records what actually reaches the framework. It is OFF
+// unless the environment variable RCLOL_SIGNING_TRACE names a writable file,
+// appends only allowlisted fields (the API, the path or requirement text, the
+// flags and the result), and never touches MVG. No game logic is changed.
+#ifndef RCLOL_SIGNING_TRACE_H
+#define RCLOL_SIGNING_TRACE_H
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+static inline void rclol_signing_trace(const char* api, const char* detail,
+    unsigned int flags, int has_status, long status)
+{
+    const char* path = getenv("RCLOL_SIGNING_TRACE");
+    if (!path || !*path)
+        return;
+    int fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0600);
+    if (fd < 0)
+        return;
+    char line[1200];
+    int n;
+    if (has_status)
+        n = snprintf(line, sizeof(line), "%ld %s flags=0x%x status=%ld detail=%.900s\n",
+            (long) time(NULL), api, flags, status, detail ? detail : "");
+    else
+        n = snprintf(line, sizeof(line), "%ld %s flags=0x%x detail=%.900s\n",
+            (long) time(NULL), api, flags, detail ? detail : "");
+    if (n > 0)
+        (void) write(fd, line, (size_t) (n < (int) sizeof(line) ? n : (int) sizeof(line) - 1));
+    close(fd);
+}
+
+#endif
