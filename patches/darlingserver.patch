+
+uid_t DarlingServer::Process::hostUid() const {
+	/* Debug authority must come from host-verified credentials, not from a
+	 * guest-supplied setuid request. */
+	std::ifstream statusFile("/proc/" + std::to_string(_pid) + "/status");
+	std::string line;
+
+	while (std::getline(statusFile, line)) {
+		if (line.substr(0, sizeof("Uid") - 1) != "Uid")
+			continue;
+		auto colon = line.find(':');
+		if (colon == line.npos)
+			break;
+		std::string rest = line.substr(colon + 1);
+		char* end = nullptr;
+		/* Uid: real effective saved fs. Debug authority is the effective
+		 * host uid; the real uid of a process that called seteuid remains 0. */
+		(void) strtoul(rest.c_str(), &end, 10);
+		if (end == rest.c_str())
+			break;
+		char* effective_end = nullptr;
+		unsigned long effective = strtoul(end, &effective_end, 10);
+		if (effective_end == end)
+			break;
+		return (uid_t) effective;
+	}
+	return (uid_t) -1;
+};
