+		/* pushAndSend has already left the message queued and woken the main loop,
+		 * where unexpected send errors have always been reported; a worker
+		 * microthread must not throw. */
+	}
 };
diff --git a/include/darlingserver/cs_state.h b/include/darlingserver/cs_state.h
new file mode 100644
index 0000000..6faa042
--- /dev/null
+++ b/include/darlingserver/cs_state.h
@@ -0,0 +1,114 @@
+/*
+ * cs_state.h - code-signing state shared by mldr, libsystem_kernel and
+ * darlingserver.
+ *
+ * This is the M3 data model from
+ * docs/security/SIP_AMFI_IMPLEMENTATION_PLAN.md. The structure is deliberately
+ * packed and fixed-size so a 32-bit guest and the 64-bit server agree on the
+ * layout when it is copied through darlingserver's read/writeMemory helpers.
+ * Variable-length data (the SuperBlob and entitlements) lives outside the
+ * structure and is transferred separately.
+ */
+
+#ifndef _DARLINGSERVER_CS_STATE_H_
+#define _DARLINGSERVER_CS_STATE_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define DC_CS_STATE_VERSION 1u
+
+#define DC_CS_CDHASH_LEN 20u
+#define DC_CS_TEAMID_MAX 64u
+#define DC_CS_IDENTITY_MAX 256u
+#define DC_CS_PATH_MAX 1024u
+
+#define DC_CS_MAX_BLOB (16u * 1024u * 1024u)
+#define DC_CS_MAX_ENTITLEMENTS (1024u * 1024u)
+#define DC_CS_MAX_DER_ENTITLEMENTS (1024u * 1024u)
+
+/* Apple's CS_* flag values (osfmk/kern/cs_blobs.h). */
+#define DC_CS_VALID 0x00000001u
+#define DC_CS_ADHOC 0x00000002u
+#define DC_CS_GET_TASK_ALLOW 0x00000004u
+#define DC_CS_INSTALLER 0x00000008u
+#define DC_CS_FORCED_LV 0x00000010u
+#define DC_CS_INVALID_ALLOWED 0x00000020u
+#define DC_CS_HARD 0x00000100u
+#define DC_CS_KILL 0x00000200u
+#define DC_CS_CHECK_EXPIRATION 0x00000400u
+#define DC_CS_RESTRICT 0x00000800u
+#define DC_CS_ENFORCEMENT 0x00001000u
+#define DC_CS_REQUIRE_LV 0x00002000u
+#define DC_CS_ENTITLEMENTS_VALIDATED 0x00004000u
+#define DC_CS_NVRAM_UNRESTRICTED 0x00008000u
+#define DC_CS_RUNTIME 0x00010000u
+#define DC_CS_LINKER_SIGNED 0x00020000u
+#define DC_CS_EXEC_SET_HARD 0x00100000u
+#define DC_CS_EXEC_SET_KILL 0x00200000u
+#define DC_CS_EXEC_SET_ENFORCEMENT 0x00400000u
+#define DC_CS_EXEC_INHERIT_SIP 0x00800000u
+#define DC_CS_KILLED 0x01000000u
+#define DC_CS_DYLD_PLATFORM 0x02000000u
+#define DC_CS_PLATFORM_BINARY 0x04000000u
+#define DC_CS_PLATFORM_PATH 0x08000000u
+#define DC_CS_DEBUGGED 0x10000000u
+#define DC_CS_SIGNED 0x20000000u
+#define DC_CS_DEV_CODE 0x40000000u
+#define DC_CS_DATAVAULT_CONTROLLER 0x80000000u
+
+/* Parsed entitlement bits (mldr is the only XML parser). */
+#define DC_CS_ENT_ALLOW_DYLD_ENV 0x00000001u
+#define DC_CS_ENT_DISABLE_LV 0x00000002u
+#define DC_CS_ENT_CLEAR_LV 0x00000004u
+
+struct dc_cs_state {
+	uint32_t version;
+	uint32_t verified; /* a verifier ran for this task */
+	uint32_t valid;    /* verification succeeded */
+	uint32_t flags;
+	uint32_t darling_entitlements; /* DC_CS_ENT_* */
+	uint32_t lv_required;          /* effective library-validation policy */
+	uint32_t sip_enabled;          /* Darling SIP prototype (DARLING_SIP_ENFORCE) */
+	uint32_t signing_enforce;      /* DARLING_CODESIGN_ENFORCE=1 for debug mediation */
+
+	uint32_t hash_type;
+	uint32_t page_size_log2;
+	uint32_t cdhash_len;
+	uint32_t teamid_len;   /* strlen(teamid), 0 when absent */
+	uint32_t identity_len; /* strlen(identity), 0 when absent */
+	uint32_t blob_len;
+	uint32_t entitlements_len;
+	uint32_t der_entitlements_len;
+
+	uint64_t generation; /* darlingserver eternal ID for pid-reuse checks */
+	uint64_t code_limit;
+	uint64_t image_offset; /* active slice offset (CS_OPS_PIDOFFSET) */
+	uint64_t image_dev;
+	uint64_t image_ino;
+	uint64_t image_size;
+	uint64_t image_mtime;
+	uint64_t image_ctime;
+
+	uint8_t cdhash[DC_CS_CDHASH_LEN];
+	char teamid[DC_CS_TEAMID_MAX];
+	char identity[DC_CS_IDENTITY_MAX];
+	char image_path[DC_CS_PATH_MAX];
+} __attribute__((packed));
+
+/* mldr-only view: the fixed state plus pointers into mldr's address space. */
+struct dc_cs_local_state {
+	struct dc_cs_state state;
+	const uint8_t *blob;
+	const uint8_t *entitlements;
+	const uint8_t *der_entitlements;
+};
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _DARLINGSERVER_CS_STATE_H_ */
diff --git a/internal-include/darlingserver/cs_verify.hpp b/internal-include/darlingserver/cs_verify.hpp
new file mode 100644
index 0000000..6eedb66
--- /dev/null
+++ b/internal-include/darlingserver/cs_verify.hpp
@@ -0,0 +1,43 @@
+/*
+ * cs_verify.hpp - server-side Mach-O signature verification for dyld's
+ * F_ADDFILESIGS_RETURN / F_CHECK_LV preflight.
+ */
+
+#ifndef _DARLINGSERVER_CS_VERIFY_HPP_
+#define _DARLINGSERVER_CS_VERIFY_HPP_
+
+#include <darlingserver/cs_state.h>
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace DarlingServer {
+	struct CsImageInfo {
+		struct dc_cs_state state = {};
+		std::vector<uint8_t> entitlements;
+	};
+
+	/*
+	 * Verify the Mach-O slice at `offset` in `fd`. Returns true when the
+	 * signature parses and every code page matches. On failure, `error`
+	 * carries a stable reason (and the returned info has valid=0).
+	 */
+	bool verifyCsImageFd(int fd, uint64_t offset, CsImageInfo* info, std::string* error);
+
+	/* True when an XML entitlement key is present and set to <true/>. */
+	bool entitlementIsTrue(const std::vector<uint8_t>& xml, const char* key);
+
+	/*
+	 * Apply the CS_REQUIRE_LV / CS_RUNTIME policy. A target is acceptable
+	 * when the main executable does not require library validation, has the
+	 * disable-library-validation entitlement, shares its team ID, is a
+	 * platform binary, or both sides are ad-hoc with no team ID (Darling's
+	 * own runtime libraries).
+	 */
+	bool csImageAllowsLibraryValidation(const struct dc_cs_state& mainState,
+	    const std::vector<uint8_t>& mainEntitlements,
+	    const CsImageInfo& target, std::string* error);
+};
+
+#endif
diff --git a/src/cs_verify.cpp b/src/cs_verify.cpp
new file mode 100644
index 0000000..137572a
--- /dev/null
+++ b/src/cs_verify.cpp
@@ -0,0 +1,486 @@
+/**
+ * This file is part of Darling.
+ *
+ * Server-side Mach-O signature verification used by F_ADDFILESIGS_RETURN and
+ * F_CHECK_LV. The parser is the same bounded dc_codesign implementation used
+ * by mldr and tools/dc-codesign; darlingserver links OpenSSL for its digests.
+ */
+
+#include <darlingserver/cs_verify.hpp>
+#include <darlingserver/server.hpp>
+#include <darlingserver/trustcache.hpp>
+
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <limits.h>
+#include <cstdlib>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <exception>
+#include <memory>
+#include <new>
+#include <utility>
+#include <map>
+#include <mutex>
+#include <vector>
+
+extern "C" {
+#include "dc_codesign.h"
+}
+
+namespace {
+	struct CacheKey {
+		uint64_t dev;
+		uint64_t ino;
+		uint64_t size;
+		uint64_t mtime;
+		uint64_t ctime;
+		uint64_t offset;
+
+		bool operator<(const CacheKey& other) const {
+			if (dev != other.dev) return dev < other.dev;
+			if (ino != other.ino) return ino < other.ino;
+			if (size != other.size) return size < other.size;
+			if (mtime != other.mtime) return mtime < other.mtime;
+			if (ctime != other.ctime) return ctime < other.ctime;
+			return offset < other.offset;
+		}
+	};
+
+	struct CacheEntry {
+		DarlingServer::CsImageInfo info;
+		uint64_t lastUse;
+	};
+
+	constexpr size_t MAX_CACHE_ENTRIES = 64;
+	std::mutex cacheMutex;
+	std::map<CacheKey, CacheEntry> cache;
+	uint64_t cacheClock = 0;
+
+	const uint8_t* findBytes(const uint8_t* data, size_t len, const char* needle) {
+		size_t needleLen = strlen(needle);
+		size_t i;
+
+		if (needleLen == 0 || len < needleLen)
+			return nullptr;
+		for (i = 0; i + needleLen <= len; i++) {
+			if (memcmp(data + i, needle, needleLen) == 0)
+				return data + i;
+		}
+		return nullptr;
+	}
+
+	bool keyIsTrue(const uint8_t* data, size_t len, const char* key) {
+		char needle[320];
+		const char* match;
+		const char* end;
+		size_t needleLen;
+
+		if (data == nullptr || len == 0)
+			return false;
+		if (snprintf(needle, sizeof(needle), "<key>%s</key>", key) >= (int) sizeof(needle))
+			return false;
+		needleLen = strlen(needle);
+		match = (const char*) findBytes(data, len, needle);
+		if (match == nullptr)
+			return false;
+		match += needleLen;
+		end = (const char*) data + len;
+		while (match < end && (*match == ' ' || *match == '\t' || *match == '\r' || *match == '\n'))
+			match++;
+		return (end - match >= 7 && memcmp(match, "<true/>", 7) == 0) ||
+		       (end - match >= 8 && memcmp(match, "<true />", 8) == 0);
+	}
+
+	uint32_t flagsFromImage(const struct dc_image& img, bool valid) {
+		uint32_t flags = DC_CS_SIGNED;
+
+		if (valid)
+			flags |= DC_CS_VALID;
+		flags |= img.cd_flags & (DC_CS_ADHOC | DC_CS_HARD | DC_CS_KILL |
+		    DC_CS_CHECK_EXPIRATION | DC_CS_RESTRICT | DC_CS_ENFORCEMENT |
+		    DC_CS_REQUIRE_LV | DC_CS_RUNTIME | DC_CS_LINKER_SIGNED);
+		if (keyIsTrue(img.entitlements, img.entitlements_len, "get-task-allow") ||
+		    keyIsTrue(img.entitlements, img.entitlements_len, "com.apple.security.get-task-allow"))
+			flags |= DC_CS_GET_TASK_ALLOW;
+		if (keyIsTrue(img.entitlements, img.entitlements_len, "com.apple.private.security.installer"))
+			flags |= DC_CS_INSTALLER;
+		return flags;
+	}
+
+	bool readExact(int fd, uint64_t fileOffset, void* buffer, size_t length) {
+		uint8_t* out = static_cast<uint8_t*>(buffer);
+		size_t done = 0;
+
+		while (done < length) {
+			ssize_t got = pread(fd, out + done, length - done, (off_t) (fileOffset + done));
+			if (got <= 0)
+				return false;
+			done += (size_t) got;
+		}
+		return true;
+	}
+
+	uint32_t readLE32(const uint8_t* p) {
+		return (uint32_t) p[0] | ((uint32_t) p[1] << 8) |
+		    ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24);
+	}
+
+	uint32_t readBE32(const uint8_t* p) {
+		return ((uint32_t) p[0] << 24) | ((uint32_t) p[1] << 16) |
+		    ((uint32_t) p[2] << 8) | (uint32_t) p[3];
+	}
+
+	uint64_t readBE64(const uint8_t* p) {
+		return ((uint64_t) readBE32(p) << 32) | readBE32(p + 4);
+	}
+
+	uint32_t readWord(const uint8_t* p, bool bigEndian) {
+		return bigEndian ? readBE32(p) : readLE32(p);
+	}
+
+	bool findSignatureRange(int fd, uint64_t offset, uint64_t sliceSize,
+	    std::vector<uint8_t>* prefix, uint64_t* signatureOffset,
+	    uint64_t* signatureSize, std::string* error) {
+		static constexpr uint64_t MAX_LOAD_COMMANDS = 64ull * 1024ull * 1024ull;
+		uint8_t header[32];
+		uint32_t magic, ncmds, sizeofcmds;
+		bool is64, bigEndian;
+		size_t headerSize;
+		uint64_t p, found = 0;
+
+		if (sliceSize < 4) {
+			if (error) *error = "image is too small to be a Mach-O";
+			return false;
+		}
+		if (!readExact(fd, offset, header, 4)) {
+			if (error) *error = "cannot read image header";
+			return false;
+		}
+		magic = readLE32(header);
+		switch (magic) {
+		case 0xfeedfacfu:
+			is64 = true; bigEndian = false; break;
+		case 0xcffaedfeu:
+			is64 = true; bigEndian = true; break;
+		case 0xfeedfaceu:
+			is64 = false; bigEndian = false; break;
+		case 0xcefaedfeu:
+			is64 = false; bigEndian = true; break;
+		default:
+			if (error) *error = "not a thin Mach-O image";
+			return false;
+		}
+		headerSize = is64 ? 32 : 28;
+		if (sliceSize < headerSize) {
+			if (error) *error = "truncated Mach-O header";
+			return false;
+		}
+		if (!readExact(fd, offset, header, headerSize)) {
+			if (error) *error = "cannot read image header";
+			return false;
+		}
+		ncmds = readWord(header + 16, bigEndian);
+		sizeofcmds = readWord(header + 20, bigEndian);
+		if ((uint64_t) headerSize + sizeofcmds > sliceSize ||
+		    sizeofcmds > MAX_LOAD_COMMANDS) {
+			if (error) *error = "load commands are out of range";
+			return false;
+		}
+
+		try {
+			prefix->resize(headerSize + sizeofcmds);
+		} catch (const std::exception&) {
+			if (error) *error = "cannot allocate load commands";
+			return false;
+		}
+		memcpy(prefix->data(), header, headerSize);
+		if (sizeofcmds > 0 &&
+		    !readExact(fd, offset + headerSize, prefix->data() + headerSize, sizeofcmds)) {
+			if (error) *error = "cannot read load commands";
+			return false;
+		}
+
+		p = headerSize;
+		for (uint32_t i = 0; i < ncmds; i++) {
+			uint32_t cmd, cmdsize;
+
+			if (p + 8 > prefix->size()) {
+				if (error) *error = "load command header is out of range";
+				return false;
+			}
+			cmd = readWord(prefix->data() + p, bigEndian);
+			cmdsize = readWord(prefix->data() + p + 4, bigEndian);
+			if (cmdsize < 8 || p + cmdsize > prefix->size()) {
+				if (error) *error = "invalid load command size";
+				return false;
+			}
+			if (cmd == DC_LC_CODE_SIGNATURE) {
+				if (cmdsize < 16) {
+					if (error) *error = "LC_CODE_SIGNATURE is too small";
+					return false;
+				}
+				*signatureOffset = readWord(prefix->data() + p + 8, bigEndian);
+				*signatureSize = readWord(prefix->data() + p + 12, bigEndian);
+				found++;
+			}
+			p += cmdsize;
+		}
+		if (found != 1) {
+			if (error) *error = found ? "multiple LC_CODE_SIGNATURE commands"
+			    : "no LC_CODE_SIGNATURE (unsigned image)";
+			return false;
+		}
+		if (*signatureOffset > sliceSize || *signatureSize > sliceSize - *signatureOffset ||
+		    *signatureSize < 12) {
+			if (error) *error = "signature range is outside the image";
+			return false;
+		}
+		return true;
+	}
+
+	uint64_t codeLimitFromSignature(const std::vector<uint8_t>& signature) {
+		static constexpr uint32_t CD_VERSION_CODELIMIT64 = 0x20300u;
+		const uint8_t* data = signature.data();
+		uint64_t limit = 0;
+		uint32_t length, count;
+
+		if (signature.size() < 12 || readBE32(data) != DC_CSMAGIC_EMBEDDED_SIGNATURE)
+			return 0;
+		length = readBE32(data + 4);
+		count = readBE32(data + 8);
+		if (length > signature.size() || 12ull + (uint64_t) count * 8 > length)
+			return 0;
+		for (uint32_t i = 0; i < count; i++) {
+			uint32_t type = readBE32(data + 12 + i * 8);
+			uint32_t blobOffset = readBE32(data + 16 + i * 8);
+			uint32_t cdLength, version;
+			uint64_t candidate;
+			const uint8_t* cd;
+
+			if (type != DC_BLOB_CODEDIRECTORY || blobOffset > length ||
+			    length - blobOffset < 44)
+				continue;
+			cd = data + blobOffset;
+			if (readBE32(cd) != DC_CSMAGIC_CODEDIRECTORY)
+				continue;
+			cdLength = readBE32(cd + 4);
+			if (cdLength < 44 || cdLength > length - blobOffset)
+				continue;
+			version = readBE32(cd + 8);
+			candidate = readBE32(cd + 32);
+			if (version >= CD_VERSION_CODELIMIT64 && cdLength >= 64) {
+				uint64_t candidate64 = readBE64(cd + 56);
+				if (candidate64)
+					candidate = candidate64;
+			}
+			if (candidate > limit)
+				limit = candidate;
+		}
+		return limit;
+	}
+}
+
+bool DarlingServer::verifyCsImageFd(int fd, uint64_t offset, CsImageInfo* info, std::string* error) {
+	struct stat st;
+	CacheKey key;
+	struct dc_image img;
+	std::unique_ptr<uint8_t[]> snapshot;
+	char err[512];
+	int result;
+
+	if (fd < 0) {
+		if (error) *error = "invalid file descriptor";
+		return false;
+	}
+	if (fstat(fd, &st) != 0 || st.st_size <= 0) {
+		if (error) *error = "cannot stat image";
+		return false;
+	}
+	if (offset >= (uint64_t) st.st_size) {
+		if (error) *error = "image offset is outside the file";
+		return false;
+	}
+
+	key.dev = (uint64_t) st.st_dev;
+	key.ino = (uint64_t) st.st_ino;
+	key.size = (uint64_t) st.st_size;
+	key.mtime = (uint64_t) st.st_mtim.tv_sec * 1000000000ull + (uint64_t) st.st_mtim.tv_nsec;
+	key.ctime = (uint64_t) st.st_ctim.tv_sec * 1000000000ull + (uint64_t) st.st_ctim.tv_nsec;
+	key.offset = offset;
+
+	{
+		std::lock_guard<std::mutex> lock(cacheMutex);
+		auto it = cache.find(key);
+		if (it != cache.end()) {
+			it->second.lastUse = ++cacheClock;
+			*info = it->second.info;
+			if (!info->state.valid && error)
+				*error = "cached signature verification failed";
+			return info->state.valid;
+		}
+	}
+
+	/* Read only the Mach-O metadata, signature, and hashed pages through
+	 * code_limit. The gap between code_limit and the signature is left
+	 * uninitialized because the parser never reads it. */
+	{
+		static constexpr uint64_t MAX_IMAGE_BYTES = 512ull * 1024ull * 1024ull;
+		std::vector<uint8_t> prefix;
+		std::vector<uint8_t> signature;
+		uint64_t signatureOffset = 0, signatureSize = 0;
+		uint64_t sliceSize = (uint64_t) st.st_size - offset;
+		uint64_t signatureEnd, codeLimit, extent;
+
+		if (!findSignatureRange(fd, offset, sliceSize, &prefix, &signatureOffset,
+			&signatureSize, error))
+			return false;
+		try {
+			signature.resize((size_t) signatureSize);
+		} catch (const std::exception&) {
+			if (error) *error = "cannot allocate signature buffer";
+			return false;
+		}
+		if (!readExact(fd, offset + signatureOffset, signature.data(), signature.size())) {
+			if (error) *error = "cannot read signature";
+			return false;
+		}
+		signatureEnd = signatureOffset + signatureSize;
+		codeLimit = codeLimitFromSignature(signature);
+		if (codeLimit == 0 || codeLimit > sliceSize)
+			codeLimit = signatureEnd;
+		extent = std::max(codeLimit, signatureEnd);
+		extent = std::max<uint64_t>(extent, prefix.size());
+		if (extent > MAX_IMAGE_BYTES) {
+			if (error) *error = "image is too large to verify";
+			return false;
+		}
+		snapshot.reset(new (std::nothrow) uint8_t[(size_t) extent]);
+		if (!snapshot) {
+			if (error) *error = "cannot allocate image snapshot";
+			return false;
+		}
+		if (codeLimit > 0 && !readExact(fd, offset, snapshot.get(), (size_t) codeLimit)) {
+			if (error) *error = "cannot read image";
+			return false;
+		}
+		memcpy(snapshot.get(), prefix.data(), prefix.size());
+		memcpy(snapshot.get() + signatureOffset, signature.data(), signature.size());
+
+		/* The descriptor may name a file that changed while it was read. */
+		{
+			struct stat after;
+			if (fstat(fd, &after) != 0 || after.st_size != st.st_size ||
+			    after.st_dev != st.st_dev || after.st_ino != st.st_ino ||
+			    after.st_mtim.tv_sec != st.st_mtim.tv_sec ||
+			    after.st_mtim.tv_nsec != st.st_mtim.tv_nsec ||
+			    after.st_ctim.tv_sec != st.st_ctim.tv_sec ||
+			    after.st_ctim.tv_nsec != st.st_ctim.tv_nsec) {
+				if (error) *error = "image changed while it was read";
+				return false;
+			}
+		}
+
+		err[0] = '\0';
+		result = dc_parse(snapshot.get(), (size_t) extent, &img, err, sizeof(err));
+		if (result == 0)
+			result = dc_verify_pages(&img, err, sizeof(err));
+	}
+
+	CsImageInfo parsed = {};
+	parsed.state.version = DC_CS_STATE_VERSION;
+	parsed.state.verified = 1;
+	parsed.state.valid = (result == 0);
+	parsed.state.image_dev = (uint64_t) st.st_dev;
+	parsed.state.image_ino = (uint64_t) st.st_ino;
+	parsed.state.image_size = (uint64_t) st.st_size;
+	parsed.state.image_mtime = key.mtime;
+	parsed.state.image_offset = offset;
+	{
+		char linkPath[64];
+		char filePath[PATH_MAX];
+		ssize_t pathLen;
+		snprintf(linkPath, sizeof(linkPath), "/proc/self/fd/%d", fd);
+		pathLen = readlink(linkPath, filePath, sizeof(filePath) - 1);
+		if (pathLen > 0) {
+			filePath[pathLen] = '\0';
+			snprintf(parsed.state.image_path, sizeof(parsed.state.image_path), "%s", filePath);
+		}
+	}
+	if (result == 0) {
+		parsed.state.flags = flagsFromImage(img, true);
+		parsed.state.hash_type = img.hash_type;
+		parsed.state.page_size_log2 = img.page_size_log2;
+		parsed.state.code_limit = img.code_limit;
+		parsed.state.cdhash_len = DC_CS_CDHASH_LEN;
+		memcpy(parsed.state.cdhash, img.cdhash, DC_CS_CDHASH_LEN);
+		if (img.teamid[0] != '\0') {
+			parsed.state.teamid_len = strlen(img.teamid);
+			snprintf(parsed.state.teamid, sizeof(parsed.state.teamid), "%s", img.teamid);
+		}
+		if (img.identifier[0] != '\0') {
+			parsed.state.identity_len = strlen(img.identifier);
+			snprintf(parsed.state.identity, sizeof(parsed.state.identity), "%s", img.identifier);
+		}
+		if (img.entitlements_len > 0 && img.entitlements_len <= DC_CS_MAX_ENTITLEMENTS)
+			parsed.entitlements.assign(img.entitlements, img.entitlements + img.entitlements_len);
+	} else {
+		parsed.state.flags = 0;
+	}
+
+	{
+		std::lock_guard<std::mutex> lock(cacheMutex);
+		if (cache.size() >= MAX_CACHE_ENTRIES) {
+			auto oldest = cache.begin();
+			for (auto it = cache.begin(); it != cache.end(); ++it) {
+				if (it->second.lastUse < oldest->second.lastUse)
+					oldest = it;
+			}
+			cache.erase(oldest);
+		}
+		cache[key] = CacheEntry{parsed, ++cacheClock};
+	}
+	*info = std::move(parsed);
+	if (result != 0) {
+		if (error) *error = err[0] ? err : "code signature verification failed";
+		return false;
+	}
+	return true;
+}
+
+bool DarlingServer::entitlementIsTrue(const std::vector<uint8_t>& xml, const char* key) {
+	return keyIsTrue(xml.empty() ? nullptr : xml.data(), xml.size(), key);
+}
+
+bool DarlingServer::csImageAllowsLibraryValidation(const struct dc_cs_state& mainState,
+    const std::vector<uint8_t>& mainEntitlements,
+    const CsImageInfo& target, std::string* error) {
+	if ((mainState.darling_entitlements & DC_CS_ENT_DISABLE_LV) ||
+	    entitlementIsTrue(mainEntitlements, "com.apple.security.cs.disable-library-validation"))
+		return true;
+
+	if (!mainState.lv_required)
+		return true;
+
+	if (!target.state.valid) {
+		if (error) *error = "target image is not validly signed";
+		return false;
+	}
+	if (target.state.flags & DC_CS_PLATFORM_BINARY)
+		return true;
+	if (target.state.valid && trustCacheContains(target.state.cdhash, nullptr))
+		return true;
+	if (mainState.teamid_len > 0 && target.state.teamid_len > 0 &&
+	    strcmp(mainState.teamid, target.state.teamid) == 0)
+		return true;
+	if (mainState.teamid_len == 0 && target.state.teamid_len == 0 &&
+	    (target.state.flags & DC_CS_ADHOC))
+		return true;
+
+	if (error) *error = "target image has a different team ID";
+	return false;
+}
diff --git a/src/dc_codesign.c b/src/dc_codesign.c
new file mode 100644
index 0000000..d075704
--- /dev/null
+++ b/src/dc_codesign.c
@@ -0,0 +1,595 @@
+/*
+ * dc_codesign.c - bounded Mach-O code signature parser.
+ *
+ * See dc_codesign.h for scope. Every offset read from the file is validated
+ * against the containing blob before use; malformed input returns -1 with a
+ * reason instead of reading out of bounds.
+ */
+
+#include "dc_codesign.h"
+
+#include <openssl/evp.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#define CD_MIN_SIZE 44u
+#define CD_V_SCATTER 0x20100u
+#define CD_V_TEAMID 0x20200u
+#define CD_V_CODELIMIT64 0x20300u
+#define CD_V_EXECSEG 0x20400u
+#define CD_V_RUNTIME 0x20500u
+
+static uint32_t be32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	       ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static uint64_t be64(const uint8_t *p)
+{
+	return ((uint64_t)be32(p) << 32) | be32(p + 4);
+}
+
+static uint32_t le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint32_t rd32(const struct dc_image *img, const uint8_t *p)
+{
+	return img->big_endian ? be32(p) : le32(p);
+}
+
+static bool in_range(uint64_t total, uint64_t off, uint64_t len)
+{
+	return off <= total && len <= total - off;
+}
+
+static int fail(char *err, size_t errlen, const char *fmt, ...)
+{
+	va_list ap;
+
+	if (err && errlen) {
+		va_start(ap, fmt);
+		vsnprintf(err, errlen, fmt, ap);
+		va_end(ap);
+	}
+	return -1;
+}
+
+const char *dc_hash_name(uint32_t hash_type)
+{
+	switch (hash_type) {
+	case DC_HASHTYPE_SHA1: return "sha1";
+	case DC_HASHTYPE_SHA256: return "sha256";
+	case DC_HASHTYPE_SHA256_TRUNCATED: return "sha256-truncated";
+	case DC_HASHTYPE_SHA384: return "sha384";
+	default: return "unknown";
+	}
+}
+
+const char *dc_blob_type_name(uint32_t type)
+{
+	switch (type) {
+	case DC_BLOB_CODEDIRECTORY: return "CodeDirectory";
+	case DC_BLOB_REQUIREMENTS: return "Requirements";
+	case DC_BLOB_ENTITLEMENTS: return "Entitlements";
+	case DC_BLOB_DER_ENTITLEMENTS: return "DEREntitlements";
+	case DC_BLOB_CMS: return "CMSSignature";
+	default: return "other";
+	}
+}
+
+void dc_flags_to_string(uint32_t flags, char *out, size_t outlen)
+{
+	static const struct { uint32_t bit; const char *name; } names[] = {
+		{ 0x00000001, "CS_VALID" },
+		{ 0x00000002, "CS_ADHOC" },
+		{ 0x00000004, "CS_GET_TASK_ALLOW" },
+		{ 0x00000008, "CS_INSTALLER" },
+		{ 0x00000100, "CS_HARD" },
+		{ 0x00000200, "CS_KILL" },
+		{ 0x00000400, "CS_CHECK_EXPIRATION" },
+		{ 0x00000800, "CS_RESTRICT" },
+		{ 0x00001000, "CS_ENFORCEMENT" },
+		{ 0x00002000, "CS_REQUIRE_LV" },
+		{ 0x00004000, "CS_ENTITLEMENTS_VALIDATED" },
+		{ 0x00010000, "CS_RUNTIME" },
+		{ 0x00020000, "CS_LINKER_SIGNED" },
+	};
+	size_t used = 0;
+
+	if (!outlen)
+		return;
+	out[0] = '\0';
+	for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (!(flags & names[i].bit))
+			continue;
+		int n = snprintf(out + used, outlen - used, "%s%s",
+				 used ? "," : "", names[i].name);
+		if (n < 0 || (size_t)n >= outlen - used)
+			break;
+		used += (size_t)n;
+	}
+	if (!used)
+		snprintf(out, outlen, "0x%08x", flags);
+}
+
+static int hash_data(uint32_t hash_type, const uint8_t *buf, size_t len,
+		     uint8_t *out, size_t outcap, size_t *outlen)
+{
+	const EVP_MD *md;
+	unsigned int mdlen = 0;
+	uint8_t tmp[EVP_MAX_MD_SIZE];
+
+	switch (hash_type) {
+	case DC_HASHTYPE_SHA1: md = EVP_sha1(); break;
+	case DC_HASHTYPE_SHA256:
+	case DC_HASHTYPE_SHA256_TRUNCATED: md = EVP_sha256(); break;
+	case DC_HASHTYPE_SHA384: md = EVP_sha384(); break;
+	default: return -1;
+	}
+
+	if (EVP_Digest(buf, len, tmp, &mdlen, md, NULL) != 1)
+		return -1;
+
+	size_t want = mdlen;
+	if (hash_type == DC_HASHTYPE_SHA256_TRUNCATED)
+		want = 20;
+	if (want > outcap)
+		return -1;
+	memcpy(out, tmp, want);
+	if (outlen)
+		*outlen = want;
+	return 0;
+}
+
+static int expected_hash_size(uint32_t hash_type, uint32_t *size)
+{
+	switch (hash_type) {
+	case DC_HASHTYPE_SHA1: *size = 20; return 0;
+	case DC_HASHTYPE_SHA256: *size = 32; return 0;
+	case DC_HASHTYPE_SHA256_TRUNCATED: *size = 20; return 0;
+	case DC_HASHTYPE_SHA384: *size = 48; return 0;
+	default: return -1;
+	}
+}
+
+static int find_signature(struct dc_image *img, uint64_t *off, uint64_t *len,
+			  char *err, size_t errlen)
+{
+	uint32_t magic;
+	size_t header_size;
+	uint32_t ncmds, sizeofcmds;
+	uint64_t p;
+	unsigned found = 0;
+
+	if (img->size < 4)
+		return fail(err, errlen, "file shorter than a Mach-O magic");
+
+	magic = le32(img->data);
+	switch (magic) {
+	case 0xfeedfacfu:
+		img->is_64 = true;
+		img->big_endian = false;
+		break;
+	case 0xcffaedfeu:
+		img->is_64 = true;
+		img->big_endian = true;
+		break;
+	case 0xfeedfaceu:
+		img->is_64 = false;
+		img->big_endian = false;
+		break;
+	case 0xcefaedfeu:
+		img->is_64 = false;
+		img->big_endian = true;
+		break;
+	default:
+		return fail(err, errlen, "not a thin Mach-O (magic 0x%08x)", magic);
+	}
+
+	header_size = img->is_64 ? 32 : 28;
+	if (img->size < header_size)
+		return fail(err, errlen, "truncated Mach-O header");
+
+	img->cputype = rd32(img, img->data + 4);
+	ncmds = rd32(img, img->data + 16);
+	sizeofcmds = rd32(img, img->data + 20);
+
+	if (!in_range(img->size, header_size, sizeofcmds))
+		return fail(err, errlen, "sizeofcmds runs past end of file");
+
+	p = header_size;
+	for (uint32_t i = 0; i < ncmds; i++) {
+		if (!in_range(img->size, p, 8))
+			return fail(err, errlen, "load command header out of range");
+
+		uint32_t cmd = rd32(img, img->data + p);
+		uint32_t cmdsize = rd32(img, img->data + p + 4);
+
+		if (cmdsize < 8 || !in_range(img->size, p, cmdsize))
+			return fail(err, errlen, "bad load command size %u", cmdsize);
+
+		if (cmd == DC_LC_CODE_SIGNATURE) {
+			if (cmdsize < 16)
+				return fail(err, errlen, "LC_CODE_SIGNATURE too small");
+			*off = rd32(img, img->data + p + 8);
+			*len = rd32(img, img->data + p + 12);
+			found++;
+		}
+		p += cmdsize;
+	}
+
+	if (!found)
+		return fail(err, errlen, "no LC_CODE_SIGNATURE (unsigned image)");
+	if (found > 1)
+		return fail(err, errlen, "multiple LC_CODE_SIGNATURE commands");
+
+	if (!in_range(img->size, *off, *len))
+		return fail(err, errlen, "signature range outside the file");
+	if (*len < 12)
+		return fail(err, errlen, "signature smaller than a SuperBlob header");
+
+	return 0;
+}
+
+static int parse_superblob(struct dc_image *img, char *err, size_t errlen)
+{
+	const uint8_t *sb = img->data + img->sig_offset;
+	uint32_t magic = be32(sb);
+	uint32_t length = be32(sb + 4);
+	uint32_t count = be32(sb + 8);
+	uint64_t index_end;
+
+	if (magic != DC_CSMAGIC_EMBEDDED_SIGNATURE)
+		return fail(err, errlen, "bad SuperBlob magic 0x%08x", magic);
+	if (length < 12 || length > img->sig_size)
+		return fail(err, errlen, "SuperBlob length %u outside signature", length);
+	if (count == 0 || count > DC_MAX_BLOBS)
+		return fail(err, errlen, "unsupported blob count %u", count);
+
+	index_end = 12ull + 8ull * count;
+	if (index_end > length)
+		return fail(err, errlen, "blob index runs past SuperBlob");
+
+	img->superblob_length = length;
+	img->blob_count = count;
+
+	for (uint32_t i = 0; i < count; i++) {
+		const uint8_t *e = sb + 12 + 8 * i;
+		uint32_t type = be32(e);
+		uint32_t off = be32(e + 4);
+		uint64_t blen;
+
+		if (off < index_end || !in_range(length, off, 8))
+			return fail(err, errlen, "blob %u offset out of range", i);
+
+		blen = be32(sb + off + 4);
+		if (blen < 8 || !in_range(length, off, blen))
+			return fail(err, errlen, "blob %u length out of range", i);
+
+		img->blobs[i].type = type;
+		img->blobs[i].offset = off;
+		img->blobs[i].length = (uint32_t)blen;
+		img->blobs[i].magic = be32(sb + off);
+	}
+	return 0;
+}
+
+static int verify_special_blob(struct dc_image *img, uint32_t blob_type,
+			       uint32_t slot, uint32_t magic,
+			       char *err, size_t errlen)
+{
+	const struct dc_blob *blob = NULL;
+	const uint8_t *blob_data;
+	const uint8_t *slot_hash;
+	uint8_t digest[EVP_MAX_MD_SIZE];
+	size_t digest_len = 0;
+	uint32_t i;
+
+	if (!img->cd)
+		return fail(err, errlen, "CodeDirectory not parsed");
+
+	for (i = 0; i < img->blob_count; i++) {
+		if (img->blobs[i].type != blob_type)
+			continue;
+		if (blob != NULL)
+			return fail(err, errlen, "duplicate blob type %u", blob_type);
+		blob = &img->blobs[i];
+	}
+
+	if (slot > img->n_special_slots) {
+		/* The CodeDirectory does not reserve this slot. */
+		return blob == NULL ? 0 : fail(err, errlen, "special slot -%u missing", slot);
+	}
+	if ((uint64_t)slot * img->hash_size > img->hash_off)
+		return fail(err, errlen, "special slot -%u outside hash area", slot);
+
+	slot_hash = img->cd + img->hash_off - slot * img->hash_size;
+	if (blob == NULL) {
+		for (i = 0; i < img->hash_size; i++) {
+			if (slot_hash[i] != 0)
+				return fail(err, errlen,
+					    "special slot -%u is set but the blob is absent", slot);
+		}
+		return 0;
+	}
+
+	if (blob->magic != magic)
+		return fail(err, errlen, "special blob type %u has magic 0x%08x",
+			    blob_type, blob->magic);
+	blob_data = img->data + img->sig_offset + blob->offset;
+	if (be32(blob_data + 4) != blob->length)
+		return fail(err, errlen, "special blob type %u length mismatch", blob_type);
+	if (hash_data(img->hash_type, blob_data, blob->length, digest,
+		      sizeof(digest), &digest_len) != 0 ||
+	    digest_len != img->hash_size ||
+	    memcmp(digest, slot_hash, img->hash_size) != 0)
+		return fail(err, errlen, "special slot -%u hash mismatch", slot);
+	return 0;
+}
+
+static int parse_codedirectory(struct dc_image *img, char *err, size_t errlen)
+{
+	const uint8_t *cd = NULL;
+	uint32_t cd_len = 0;
+	uint64_t need;
+	uint32_t hash_off, ident_off, n_special, n_code;
+	uint32_t code_limit32 = 0;
+	uint64_t code_limit = 0;
+
+	for (uint32_t i = 0; i < img->blob_count; i++) {
+		if (img->blobs[i].type == DC_BLOB_CODEDIRECTORY) {
+			if (cd)
+				return fail(err, errlen, "multiple CodeDirectory blobs");
+			cd = img->data + img->sig_offset + img->blobs[i].offset;
+			cd_len = img->blobs[i].length;
+		}
+	}
+	if (!cd)
+		return fail(err, errlen, "no CodeDirectory blob");
+
+	if (cd_len < CD_MIN_SIZE)
+		return fail(err, errlen, "CodeDirectory shorter than v0 header");
+	if (be32(cd) != DC_CSMAGIC_CODEDIRECTORY)
+		return fail(err, errlen, "bad CodeDirectory magic");
+	if (be32(cd + 4) != cd_len)
+		return fail(err, errlen, "CodeDirectory length field mismatch");
+
+	img->cd = cd;
+	img->cd_len = cd_len;
+	img->cd_version = be32(cd + 8);
+	img->cd_flags = be32(cd + 12);
+	hash_off = be32(cd + 16);
+	ident_off = be32(cd + 20);
+	n_special = be32(cd + 24);
+	n_code = be32(cd + 28);
+	code_limit32 = be32(cd + 32);
+	img->hash_size = cd[36];
+	img->hash_type = cd[37];
+	img->hash_off = hash_off;
+	img->page_size_log2 = cd[39];
+	img->n_special_slots = n_special;
+	img->n_code_slots = n_code;
+	img->code_limit = code_limit32;
+
+	if (be32(cd + 40) != 0)
+		return fail(err, errlen, "spare2 is not zero");
+
+	need = CD_MIN_SIZE;
+	if (img->cd_version >= CD_V_SCATTER)
+		need += 4;
+	if (img->cd_version >= CD_V_TEAMID)
+		need += 4;
+	if (img->cd_version >= CD_V_CODELIMIT64)
+		need += 4 + 8;
+	if (img->cd_version >= CD_V_EXECSEG)
+		need += 8 + 8 + 8;
+	if (img->cd_version >= CD_V_RUNTIME)
+		need += 4 + 4;
+	if (cd_len < need)
+		return fail(err, errlen, "CodeDirectory v0x%x truncated (need %llu)",
+			    img->cd_version, (unsigned long long)need);
+
+	if (img->hash_type == 0)
+		return fail(err, errlen, "unknown hash type %u", img->hash_type);
+	{
+		uint32_t want = 0;
+		if (expected_hash_size(img->hash_type, &want) != 0)
+			return fail(err, errlen, "unknown hash type %u", img->hash_type);
+		if (img->hash_size != want)
+			return fail(err, errlen, "hash size %u does not match type %s",
+				    img->hash_size, dc_hash_name(img->hash_type));
+	}
+
+	if (img->page_size_log2 < 9 || img->page_size_log2 > 30)
+		return fail(err, errlen, "invalid page size 2^%u", img->page_size_log2);
+
+	if (img->cd_version >= CD_V_CODELIMIT64) {
+		uint64_t limit64 = be64(cd + 56);
+		if (limit64)
+			code_limit = limit64;
+	}
+	if (code_limit == 0)
+		code_limit = code_limit32;
+	if (code_limit == 0)
+		return fail(err, errlen, "code limit is zero (no signed executable content)");
+	if (code_limit > img->size)
+		return fail(err, errlen, "code limit %llu beyond file size %zu",
+			    (unsigned long long)code_limit, img->size);
+	img->code_limit = code_limit;
+
+	if (ident_off == 0 || ident_off >= cd_len)
+		return fail(err, errlen, "identifier offset out of range");
+	{
+		size_t n = strnlen((const char *)cd + ident_off, cd_len - ident_off);
+		if (n == cd_len - ident_off)
+			return fail(err, errlen, "identifier is not NUL-terminated");
+		if (n >= sizeof(img->identifier))
+			return fail(err, errlen, "identifier too long");
+		memcpy(img->identifier, cd + ident_off, n + 1);
+	}
+
+	img->teamid[0] = '\0';
+	if (img->cd_version >= CD_V_TEAMID) {
+		uint32_t team_off = be32(cd + 48);
+		if (team_off) {
+			if (team_off >= cd_len)
+				return fail(err, errlen, "team id offset out of range");
+			size_t n = strnlen((const char *)cd + team_off, cd_len - team_off);
+			if (n == cd_len - team_off)
+				return fail(err, errlen, "team id is not NUL-terminated");
+			if (n >= sizeof(img->teamid))
+				return fail(err, errlen, "team id too long");
+			memcpy(img->teamid, cd + team_off, n + 1);
+		}
+	}
+
+	if ((uint64_t)n_special * img->hash_size > hash_off)
+		return fail(err, errlen, "special slots overlap header");
+	if (hash_off > cd_len ||
+	    (uint64_t)hash_off + (uint64_t)n_code * img->hash_size > cd_len)
+		return fail(err, errlen, "code slots run past CodeDirectory");
+
+	{
+		uint64_t page = 1ull << img->page_size_log2;
+		uint64_t want_slots = code_limit ? (code_limit + page - 1) / page : 0;
+		if (want_slots != n_code)
+			return fail(err, errlen,
+				    "slot count %u does not match code limit %llu / page %llu",
+				    n_code, (unsigned long long)code_limit,
+				    (unsigned long long)page);
+	}
+
+	{
+		uint8_t full[EVP_MAX_MD_SIZE];
+		size_t flen = 0;
+
+		if (hash_data(img->hash_type, cd, cd_len, full, sizeof(full), &flen) != 0 ||
+		    flen < DC_CDHASH_LEN) {
+			return fail(err, errlen, "failed to hash CodeDirectory");
+		}
+		memcpy(img->cdhash, full, DC_CDHASH_LEN);
+	}
+	if (hash_data(DC_HASHTYPE_SHA1, cd, cd_len, img->cd_sha1,
+		      sizeof(img->cd_sha1), NULL) != 0)
+		return fail(err, errlen, "failed to compute SHA-1 of CodeDirectory");
+	if (hash_data(DC_HASHTYPE_SHA256, cd, cd_len, img->cd_sha256,
+		      sizeof(img->cd_sha256), NULL) != 0)
+		return fail(err, errlen, "failed to compute SHA-256 of CodeDirectory");
+
+	/* Special slots bind requirements and entitlement blobs to the
+	 * CodeDirectory. Verify the complete blob (including its 8-byte
+	 * generic header) and reject a non-zero slot with no blob. */
+	if (verify_special_blob(img, DC_BLOB_REQUIREMENTS, 2,
+				DC_CSMAGIC_REQUIREMENTS, err, errlen) != 0 ||
+	    verify_special_blob(img, DC_BLOB_ENTITLEMENTS, 5,
+				DC_CSMAGIC_EMBEDDED_ENTITLEMENTS, err, errlen) != 0 ||
+	    verify_special_blob(img, DC_BLOB_DER_ENTITLEMENTS, 7,
+				DC_CSMAGIC_EMBEDDED_DER_ENTITLEMENTS, err, errlen) != 0)
+		return -1;
+
+	/* Embedded entitlements, both XML (type 5) and DER (type 7). */
+	for (uint32_t i = 0; i < img->blob_count; i++) {
+		const struct dc_blob *b = &img->blobs[i];
+		if (b->type != DC_BLOB_ENTITLEMENTS && b->type != DC_BLOB_DER_ENTITLEMENTS)
+			continue;
+		if (b->length <= 8)
+			return fail(err, errlen, "empty entitlements blob");
+		if (b->type == DC_BLOB_ENTITLEMENTS) {
+			if (b->magic != DC_CSMAGIC_EMBEDDED_ENTITLEMENTS)
+				return fail(err, errlen, "bad entitlements magic 0x%08x", b->magic);
+			img->entitlements = img->data + img->sig_offset + b->offset + 8;
+			img->entitlements_len = b->length - 8;
+		} else {
+			if (b->magic != DC_CSMAGIC_EMBEDDED_DER_ENTITLEMENTS)
+				return fail(err, errlen, "bad DER entitlements magic 0x%08x", b->magic);
+			img->der_entitlements = img->data + img->sig_offset + b->offset + 8;
+			img->der_entitlements_len = b->length - 8;
+		}
+	}
+
+	return 0;
+}
+
+int dc_parse(const uint8_t *data, size_t size, struct dc_image *img,
+	     char *err, size_t errlen)
+{
+	int r;
+
+	if (!data || !img)
+		return fail(err, errlen, "null argument");
+	memset(img, 0, sizeof(*img));
+	img->data = data;
+	img->size = size;
+
+	r = find_signature(img, &img->sig_offset, &img->sig_size, err, errlen);
+	if (r != 0)
+		return r;
+	r = parse_superblob(img, err, errlen);
+	if (r != 0)
+		return r;
+	return parse_codedirectory(img, err, errlen);
+}
+
+int dc_verify_pages(struct dc_image *img, char *err, size_t errlen)
+{
+	uint64_t page_size;
+	uint32_t hash_off;
+
+	if (!img || !img->cd)
+		return fail(err, errlen, "image not parsed");
+
+	/* Re-check the special slots here as well: callers that parse once and
+	 * verify later must not use entitlements that are not bound to the
+	 * CodeDirectory. */
+	if (verify_special_blob(img, DC_BLOB_REQUIREMENTS, 2,
+				DC_CSMAGIC_REQUIREMENTS, err, errlen) != 0 ||
+	    verify_special_blob(img, DC_BLOB_ENTITLEMENTS, 5,
+				DC_CSMAGIC_EMBEDDED_ENTITLEMENTS, err, errlen) != 0 ||
+	    verify_special_blob(img, DC_BLOB_DER_ENTITLEMENTS, 7,
+				DC_CSMAGIC_EMBEDDED_DER_ENTITLEMENTS, err, errlen) != 0)
+		return -1;
+
+	page_size = 1ull << img->page_size_log2;
+	hash_off = be32(img->cd + 16);
+
+	img->pages_total = img->n_code_slots;
+	img->pages_failed = 0;
+	img->first_bad_page = 0;
+
+	for (uint32_t i = 0; i < img->n_code_slots; i++) {
+		uint64_t off = (uint64_t)i * page_size;
+		uint64_t remain;
+		size_t len;
+		uint8_t digest[64];
+		size_t dlen = 0;
+		const uint8_t *want = img->cd + hash_off + (size_t)i * img->hash_size;
+
+		if (off >= img->code_limit) {
+			img->pages_failed++;
+			if (!img->first_bad_page)
+				img->first_bad_page = i + 1;
+			continue;
+		}
+		remain = img->code_limit - off;
+		len = remain > page_size ? (size_t)page_size : (size_t)remain;
+		if (hash_data(img->hash_type, img->data + off, len,
+			      digest, sizeof(digest), &dlen) != 0 ||
+		    dlen != img->hash_size ||
+		    memcmp(digest, want, img->hash_size) != 0) {
+			img->pages_failed++;
+			if (!img->first_bad_page)
+				img->first_bad_page = i + 1;
+		}
+	}
+
+	img->pages_verified = true;
+	if (img->pages_failed)
+		return fail(err, errlen, "%u of %u code pages failed verification (first: %u)",
+			    img->pages_failed, img->pages_total, img->first_bad_page);
+	return 0;
+}
diff --git a/src/dc_codesign.h b/src/dc_codesign.h
new file mode 100644
index 0000000..f272720
--- /dev/null
+++ b/src/dc_codesign.h
@@ -0,0 +1,120 @@
+/*
+ * dc_codesign.h - bounded parser for Mach-O code signatures.
+ *
+ * Part of the phase-M1 work in docs/security/SIP_AMFI_IMPLEMENTATION_PLAN.md.
+ * The parser is deliberately read-only and allocation-free: it points into the
+ * caller's file buffer and validates every offset before use.
+ *
+ * Hashing uses OpenSSL here. When this code moves into libsystem_kernel the
+ * hash backend must be swapped for CommonCrypto/corecrypto; the parser and the
+ * validation rules stay the same.
+ */
+
+#ifndef DC_CODESIGN_H
+#define DC_CODESIGN_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define DC_CDHASH_LEN 20
+#define DC_MAX_BLOBS 64
+#define DC_IDENT_MAX 256
+#define DC_TEAMID_MAX 64
+
+/* CS_SuperBlob magics (big-endian on disk). */
+#define DC_CSMAGIC_EMBEDDED_SIGNATURE 0xfade0cc0u
+#define DC_CSMAGIC_CODEDIRECTORY 0xfade0c02u
+#define DC_CSMAGIC_REQUIREMENTS 0xfade0c01u
+#define DC_CSMAGIC_EMBEDDED_ENTITLEMENTS 0xfade7171u
+#define DC_CSMAGIC_EMBEDDED_DER_ENTITLEMENTS 0xfade7172u
+#define DC_CSMAGIC_BLOBWRAPPER 0xfade0b01u
+
+/* SuperBlob slot types. */
+#define DC_BLOB_CODEDIRECTORY 0u
+#define DC_BLOB_REQUIREMENTS 2u
+#define DC_BLOB_ENTITLEMENTS 5u
+#define DC_BLOB_DER_ENTITLEMENTS 7u
+#define DC_BLOB_CMS 0x10000u
+
+/* Mach-O. */
+#define DC_LC_CODE_SIGNATURE 0x1du
+
+/* CodeDirectory hash types. */
+#define DC_HASHTYPE_SHA1 1u
+#define DC_HASHTYPE_SHA256 2u
+#define DC_HASHTYPE_SHA256_TRUNCATED 3u
+#define DC_HASHTYPE_SHA384 4u
+
+struct dc_blob {
+	uint32_t type;
+	uint32_t offset;
+	uint32_t length;
+	uint32_t magic;
+};
+
+struct dc_image {
+	const uint8_t *data;
+	size_t size;
+
+	bool is_64;
+	bool big_endian;
+	uint32_t cputype;
+
+	uint64_t sig_offset;
+	uint64_t sig_size;
+	uint32_t superblob_length;
+	uint32_t blob_count;
+	struct dc_blob blobs[DC_MAX_BLOBS];
+
+	/* CodeDirectory, pointing into the file buffer. */
+	const uint8_t *cd;
+	size_t cd_len;
+	uint32_t cd_version;
+	uint32_t cd_flags;
+	uint32_t hash_type;
+	uint32_t hash_size;
+	uint32_t hash_off;
+	uint32_t page_size_log2;
+	uint32_t n_special_slots;
+	uint32_t n_code_slots;
+	uint64_t code_limit;
+	char identifier[DC_IDENT_MAX];
+	char teamid[DC_TEAMID_MAX];
+
+	/* Digests of the CodeDirectory blob. */
+	uint8_t cdhash[DC_CDHASH_LEN];
+	uint8_t cd_sha1[20];
+	uint8_t cd_sha256[32];
+
+	/* Embedded entitlements (type 5) and DER entitlements (type 7). */
+	const uint8_t *entitlements;
+	size_t entitlements_len;
+	const uint8_t *der_entitlements;
+	size_t der_entitlements_len;
+
+	/* Page-hash verification (filled by dc_verify_pages). */
+	bool pages_verified;
+	uint32_t pages_total;
+	uint32_t pages_failed;
+	uint32_t first_bad_page;
+};
+
+/*
+ * Parse a Mach-O image and its embedded signature. Returns 0 on success,
+ * -1 on error (err is always NUL-terminated).
+ */
+int dc_parse(const uint8_t *data, size_t size, struct dc_image *img,
+	     char *err, size_t errlen);
+
+/*
+ * Verify every code page hash against the CodeDirectory. Requires a parsed
+ * image. Returns 0 when all pages match, -1 otherwise.
+ */
+int dc_verify_pages(struct dc_image *img, char *err, size_t errlen);
+
+const char *dc_hash_name(uint32_t hash_type);
+const char *dc_blob_type_name(uint32_t type);
+void dc_flags_to_string(uint32_t flags, char *out, size_t outlen);
+
+#endif /* DC_CODESIGN_H */
diff --git a/internal-include/darlingserver/trustcache.hpp b/internal-include/darlingserver/trustcache.hpp
new file mode 100644
index 0000000..28c2109
--- /dev/null
+++ b/internal-include/darlingserver/trustcache.hpp
@@ -0,0 +1,16 @@
+#ifndef _DARLINGSERVER_TRUSTCACHE_HPP_
+#define _DARLINGSERVER_TRUSTCACHE_HPP_
+
+#include <cstdint>
+#include <string>
+
+namespace DarlingServer {
+	/*
+	 * Check a 20-byte cdhash against the local, Ed25519-signed trust store at
+	 * $prefix/var/db/darling/trustcache. Returns false when the store or key
+	 * is absent, malformed, rolled back, or does not contain the hash.
+	 */
+	bool trustCacheContains(const uint8_t cdhash[20], std::string* error);
+};
+
+#endif
diff --git a/src/trustcache.cpp b/src/trustcache.cpp
new file mode 100644
index 0000000..cc22e1c
--- /dev/null
+++ b/src/trustcache.cpp
@@ -0,0 +1,256 @@
+/**
+ * This file is part of Darling.
+ *
+ * Local (Darling-only) authenticated trust store. The store format is shared
+ * with tools/dc-trustcache.py; it is deliberately not Apple's trust cache.
+ */
+
+#include <darlingserver/trustcache.hpp>
+#include <darlingserver/server.hpp>
+
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <limits.h>
+#include <cstdlib>
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+	constexpr uint32_t kMagic = 0x44544331u; /* "DTC1" */
+	constexpr uint32_t kVersion = 1;
+	constexpr size_t kIssuerLen = 32;
+	constexpr size_t kHeaderSize = 4 + 4 + 8 + kIssuerLen + 4;
+	constexpr size_t kEntrySize = 24;
+	constexpr size_t kSignatureLen = 64;
+
+	uint32_t le32(const uint8_t* p) {
+		return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+		       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+	}
+
+	uint64_t le64(const uint8_t* p) {
+		uint64_t value = 0;
+		for (int i = 7; i >= 0; i--)
+			value = (value << 8) | p[i];
+		return value;
+	}
+
+	std::mutex generationMutex;
+	std::unordered_map<std::string, uint64_t> lastGeneration;
+
+	bool rootlessUserNamespace() {
+		std::ifstream map("/proc/self/uid_map");
+		unsigned long inside = 0, outside = 0, count = 0;
+
+		if (map >> inside >> outside >> count)
+			return inside == 0 && outside != 0 && count != 0;
+		return false;
+	}
+
+	std::string trustDirectory() {
+		/* In a rootless user namespace uid 0 is the host user; every path that
+		 * user can write is also writable by a guest. There is no authenticated
+		 * store boundary in that mode yet. */
+		if (rootlessUserNamespace())
+			return "";
+		const char* override = getenv("DARLING_TRUST_DIR");
+		if (override != nullptr && override[0] != '\0')
+			return override;
+		if (geteuid() == 0)
+			return "/etc/darling";
+		return "";
+	}
+
+	bool outsidePrefix(const std::string& directory) {
+		std::string prefix = DarlingServer::Server::sharedInstance().prefix();
+		char resolvedDirectory[PATH_MAX];
+		char resolvedPrefix[PATH_MAX];
+		std::string d, p;
+
+		if (realpath(directory.c_str(), resolvedDirectory) == nullptr ||
+		    realpath(prefix.c_str(), resolvedPrefix) == nullptr)
+			return false;
+		d = resolvedDirectory;
+		p = resolvedPrefix;
+		if (p.empty())
+			return true;
+		if (d == p)
+			return false;
+		if (d.size() > p.size() && d.compare(0, p.size(), p) == 0 && d[p.size()] == '/')
+			return false;
+		return true;
+	}
+
+	bool rootOwned(const std::string& path, bool directory) {
+		struct stat st;
+		if (lstat(path.c_str(), &st) != 0)
+			return false;
+		if (directory ? !S_ISDIR(st.st_mode) : !S_ISREG(st.st_mode))
+			return false;
+		if (st.st_uid != 0)
+			return false;
+		return (st.st_mode & (S_IWGRP | S_IWOTH)) == 0;
+	}
+
+	uint64_t persistedGeneration(const std::string& storePath) {
+		std::ifstream file(storePath + ".lastgen");
+		uint64_t generation = 0;
+		if (file)
+			file >> generation;
+		return generation;
+	}
+
+	void persistGeneration(const std::string& storePath, uint64_t generation) {
+		std::string path = storePath + ".lastgen";
+		std::string temporary = path + ".tmp";
+		{
+			std::ofstream file(temporary, std::ios::trunc);
+			if (!file)
+				return;
+			file << generation << "\n";
+		}
+		if (std::rename(temporary.c_str(), path.c_str()) != 0)
+			std::remove(temporary.c_str());
+	}
+
+	bool verifySignature(const std::vector<uint8_t>& payload,
+	    const uint8_t* signature, size_t signatureLen, const std::string& pubPath) {
+		BIO* bio = BIO_new_file(pubPath.c_str(), "r");
+		EVP_PKEY* key;
+		EVP_MD_CTX* ctx;
+		bool ok = false;
+
+		if (bio == nullptr)
+			return false;
+		key = PEM_read_bio_PUBKEY(bio, nullptr, nullptr, nullptr);
+		BIO_free(bio);
+		if (key == nullptr)
+			return false;
+		ctx = EVP_MD_CTX_new();
+		if (ctx == nullptr) {
+			EVP_PKEY_free(key);
+			return false;
+		}
+		if (EVP_DigestVerifyInit(ctx, nullptr, nullptr, nullptr, key) == 1)
+			ok = EVP_DigestVerify(ctx, signature, signatureLen,
+			    payload.data(), payload.size()) == 1;
+		EVP_MD_CTX_free(ctx);
+		EVP_PKEY_free(key);
+		return ok;
+	}
+}
+
+bool DarlingServer::trustCacheContains(const uint8_t cdhash[20], std::string* error) {
+	std::string trustDir = trustDirectory();
+	std::string storePath;
+	std::string pubPath;
+	std::ifstream file;
+	std::vector<uint8_t> data;
+	struct stat st;
+	std::string storeDir;
+
+	if (trustDir.empty()) {
+		if (error) *error = "no trust-store directory is available";
+		return false;
+	}
+	storePath = trustDir + "/trustcache";
+	pubPath = storePath + ".pub";
+	storeDir = trustDir;
+
+	if (!outsidePrefix(storeDir)) {
+		if (error) *error = "trust store must live outside the writable prefix";
+		return false;
+	}
+	if (!rootOwned(storeDir, true) || !rootOwned(storePath, false) ||
+	    !rootOwned(pubPath, false)) {
+		if (error) *error = "trust store is not root-owned and write-protected";
+		return false;
+	}
+
+	file.open(storePath, std::ios::binary);
+	uint64_t generation;
+	uint32_t count;
+	size_t entriesEnd;
+	uint32_t signatureLength;
+
+	if (!file) {
+		if (error) *error = "trust store not present";
+		return false;
+	}
+	file.seekg(0, std::ios::end);
+	auto size = file.tellg();
+	if (size < 0 || (uint64_t) size > 64ull * 1024ull * 1024ull) {
+		if (error) *error = "trust store is too large";
+		return false;
+	}
+	file.seekg(0, std::ios::beg);
+	data.resize((size_t) size);
+	if (!file.read((char*) data.data(), data.size()) ||
+	    data.size() < kHeaderSize + 4) {
+		if (error) *error = "cannot read trust store";
+		return false;
+	}
+
+	if (le32(data.data()) != kMagic || le32(data.data() + 4) != kVersion) {
+		if (error) *error = "bad trust-store magic or version";
+		return false;
+	}
+	generation = le64(data.data() + 8);
+	if (memcmp(data.data() + 16, "darling-local", 13) != 0) {
+		if (error) *error = "trust store is not darling-local";
+		return false;
+	}
+	count = le32(data.data() + 48);
+	if (count > (data.size() - kHeaderSize) / kEntrySize) {
+		if (error) *error = "trust-store entry count is out of range";
+		return false;
+	}
+	entriesEnd = kHeaderSize + (size_t) count * kEntrySize;
+	if (entriesEnd + 4 > data.size()) {
+		if (error) *error = "trust-store entries are truncated";
+		return false;
+	}
+	signatureLength = le32(data.data() + entriesEnd);
+	if (signatureLength != kSignatureLen ||
+	    entriesEnd + 4 + signatureLength != data.size()) {
+		if (error) *error = "bad trust-store signature length";
+		return false;
+	}
+	if (!verifySignature(std::vector<uint8_t>(data.begin(), data.begin() + entriesEnd),
+	        data.data() + entriesEnd + 4, signatureLength, pubPath)) {
+		if (error) *error = "trust-store signature does not verify";
+		return false;
+	}
+
+	{
+		std::lock_guard<std::mutex> lock(generationMutex);
+		auto it = lastGeneration.find(storePath);
+		uint64_t persisted = persistedGeneration(storePath);
+		uint64_t previous = it == lastGeneration.end() ? persisted : it->second;
+		if (generation < previous) {
+			if (error) *error = "trust-store generation rolled back";
+			return false;
+		}
+		lastGeneration[storePath] = generation;
+		if (generation > persisted)
+			persistGeneration(storePath, generation);
+	}
+
+	for (uint32_t i = 0; i < count; i++) {
+		const uint8_t* entry = data.data() + kHeaderSize + (size_t) i * kEntrySize;
+		if (memcmp(entry, cdhash, 20) == 0)
+			return true;
+	}
+	if (error) *error = "cdhash is not in the trust store";
+	return false;
+}
