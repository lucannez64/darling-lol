+// at startup and a branch per request when off. callFromMessage runs on the server's single message loop thread.
+static void callStatsRecord(unsigned number, int pid, int tid) {
+	static const char* path = getenv("DSERVER_CALL_STATS");
+	if (!path || !path[0]) {
+		return;
