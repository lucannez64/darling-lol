+void DarlingServer::Call::SetCsState::processCall() {
+	int code = 0;
+	uint64_t generation = 0;
+
+	if (auto thread = _thread.lock()) {
+		if (auto process = thread->process()) {
+			struct dc_cs_state state;
+			if (_body.state == 0) {
+				code = -EINVAL;
+			} else if (!process->readMemory((uintptr_t) _body.state, &state, sizeof(state), &code)) {
+				code = -code;
+			} else if (!csStateLayoutValid(&state, _body.blob_size, _body.entitlements_size, _body.der_entitlements_size)) {
+				code = -EINVAL;
+			} else {
+				std::vector<uint8_t> blob(_body.blob_size);
+				std::vector<uint8_t> entitlements(_body.entitlements_size);
+				std::vector<uint8_t> derEntitlements(_body.der_entitlements_size);
+
+				if (!blob.empty() && !process->readMemory((uintptr_t) _body.blob, blob.data(), blob.size(), &code)) {
+					code = -code;
+				} else if (!entitlements.empty() && !process->readMemory((uintptr_t) _body.entitlements, entitlements.data(), entitlements.size(), &code)) {
+					code = -code;
+				} else if (!derEntitlements.empty() && !process->readMemory((uintptr_t) _body.der_entitlements, derEntitlements.data(), derEntitlements.size(), &code)) {
+					code = -code;
+				} else if (!process->setCsState(state,
+				    blob.empty() ? nullptr : blob.data(), blob.size(),
+				    entitlements.empty() ? nullptr : entitlements.data(), entitlements.size(),
+				    derEntitlements.empty() ? nullptr : derEntitlements.data(), derEntitlements.size())) {
+					/* Registration is one-shot per checkin/exec; a process
+					 * must not revalidate itself after MARKINVALID or a
+					 * cross-process flag clear. */
+					code = -EPERM;
+				} else {
+					generation = process->eternalID();
+				}
+			}
+		} else {
+			code = -ESRCH;
+		}
+	} else {
+		code = -ESRCH;
+	}
+
+	_sendReply(code, generation);
+}
