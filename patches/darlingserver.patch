+void DarlingServer::Call::VerifyCsImage::processCall() {
+	int code = 0;
+	int valid = 0;
+	int lvOk = 1;
+	uint64_t coveredLength = 0;
+	uint32_t flags = 0;
+
+	if (auto thread = _thread.lock()) {
+		if (auto process = thread->process()) {
+			CsImageInfo target;
+			std::string error;
+			valid = verifyCsImageFd(_body.fd, _body.offset, &target, &error) ? 1 : 0;
+			/* Only report coverage actually verified by the parser. */
+			coveredLength = target.state.code_limit;
+			flags = target.state.flags;
+
+			if (_body.check_lv) {
+				struct dc_cs_state mainState = {};
+				std::vector<uint8_t> blob;
+				std::vector<uint8_t> mainEntitlements;
+				std::vector<uint8_t> derEntitlements;
+				process->copyCsState(&mainState, &blob, &mainEntitlements, &derEntitlements);
+				lvOk = csImageAllowsLibraryValidation(mainState, mainEntitlements, target, &error) ? 1 : 0;
+			}
+
+			if ((!valid || !lvOk) && _body.error_message != 0 && _body.error_message_size > 0) {
+				size_t len = std::min<size_t>(error.size() + 1, _body.error_message_size);
+				if (!process->writeMemory((uintptr_t) _body.error_message, error.c_str(), len, &code))
+					code = -code;
+			}
+		} else {
+			code = -ESRCH;
+		}
+	} else {
+		code = -ESRCH;
+	}
+
+	_sendReply(code, valid, lvOk, coveredLength, flags);
+}
