+	++byThreadCall[{tid, number}];
+	++byThread[{pid, tid}];
+	++total;
+
+	auto now = std::chrono::steady_clock::now();
+	if (now - last < std::chrono::seconds(5)) {
+		return;
+	}
+	double seconds = std::chrono::duration<double>(now - last).count();
+	last = now;
+
+	if (FILE* file = fopen(path, "a")) {
+		fprintf(file, "calls: %lu in %.1fs (%.0f/s)\n  by call number:", total, seconds, total / seconds);
+		std::vector<std::pair<unsigned long, unsigned>> numbers;
+		for (auto& [num, count]: byNumber) numbers.push_back({count, num});
+		std::sort(numbers.rbegin(), numbers.rend());
+		for (size_t i = 0; i < numbers.size() && i < 12; ++i) fprintf(file, " #%u=%lu", numbers[i].second, numbers[i].first);
+		fprintf(file, "\n  by pid/tid:");
+		std::vector<std::pair<unsigned long, std::pair<int, int>>> threads;
+		for (auto& [id, count]: byThread) threads.push_back({count, id});
+		std::sort(threads.rbegin(), threads.rend());
+		for (size_t i = 0; i < threads.size() && i < 12; ++i) fprintf(file, " %d/%d=%lu", threads[i].second.first, threads[i].second.second, threads[i].first);
+		fprintf(file, "\n  by tid/call:");
+		std::vector<std::pair<unsigned long, std::pair<int, unsigned>>> pairs;
+		for (auto& [id, count]: byThreadCall) pairs.push_back({count, id});
+		std::sort(pairs.rbegin(), pairs.rend());
+		for (size_t i = 0; i < pairs.size() && i < 24; ++i) fprintf(file, " %d:#%u=%lu", pairs[i].second.first, pairs[i].second.second, pairs[i].first);
