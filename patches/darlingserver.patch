+void DarlingServer::Call::UpdateCsState::processCall() {
+	static constexpr uint32_t settableFlags =
+	    DC_CS_HARD | DC_CS_EXEC_SET_HARD | DC_CS_KILL | DC_CS_EXEC_SET_KILL |
+	    DC_CS_RESTRICT | DC_CS_REQUIRE_LV | DC_CS_ENFORCEMENT |
+	    DC_CS_EXEC_SET_ENFORCEMENT |
+	    /* Set internally by MARKINVALID/MARKKILL after the process is killed. */
+	    DC_CS_KILLED;
+	static constexpr uint32_t clearableFlags =
+	    DC_CS_VALID | DC_CS_INSTALLER | DC_CS_DATAVAULT_CONTROLLER |
+	    DC_CS_EXEC_INHERIT_SIP | DC_CS_REQUIRE_LV | DC_CS_FORCED_LV |
+	    DC_CS_KILLED;
+	int code = 0;
+	uint32_t flags = 0;
+
+	if ((_body.set_flags & ~settableFlags) != 0 ||
+	    (_body.clear_flags & ~clearableFlags) != 0 ||
+	    _body.valid < -1 || _body.valid > 0) {
+		_sendReply(-EINVAL, 0);
+		return;
+	}
+
+	if (auto thread = _thread.lock()) {
+		if (auto caller = thread->process()) {
+			if (auto maybeTargetProcess = processRegistry().lookupEntryByNSID(_body.pid)) {
+				auto target = *maybeTargetProcess;
+				bool isSelf = (caller == target);
+				if (!isSelf) {
+					struct dc_cs_state targetState = {};
+					std::vector<uint8_t> blob;
+					std::vector<uint8_t> entitlements;
+					std::vector<uint8_t> derEntitlements;
+					target->copyCsState(&targetState, &blob, &entitlements, &derEntitlements);
+					if (caller->uid() != 0 &&
+					    (targetState.flags & DC_CS_GET_TASK_ALLOW) == 0) {
+						code = -EPERM;
+					}
+				}
+				if (code == 0)
+					flags = target->updateCsFlags(_body.set_flags, _body.clear_flags, _body.valid);
+			} else {
+				code = ESRCH;
+			}
+		} else {
+			code = -ESRCH;
+		}
+	} else {
+		code = -ESRCH;
+	}
+
+	_sendReply(code, flags);
+}
