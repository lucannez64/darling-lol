+
+uint32_t DarlingServer::Process::updateCsFlags(uint32_t setFlags, uint32_t clearFlags, int valid) {
+	std::unique_lock lock(_csMutex);
+	uint32_t flags = (_csState.flags | setFlags) & ~clearFlags;
+
+	if (setFlags & DC_CS_REQUIRE_LV)
+		_csState.lv_required = 1;
+	if (clearFlags & (DC_CS_REQUIRE_LV | DC_CS_FORCED_LV))
+		_csState.lv_required = 0;
+	if (valid == 0) {
+		_csState.valid = 0;
+		flags &= ~DC_CS_VALID;
+	}
+	/* valid == 1 is intentionally ignored: only a verifier may restore
+	 * validity, never an update RPC. */
+	if (!_csState.valid || !_csState.verified)
+		flags &= ~DC_CS_VALID;
+	_csState.flags = flags;
+	return flags;
+};
+
+bool DarlingServer::Process::signingEnforce() const {
+	std::shared_lock lock(_csMutex);
+	return _csState.signing_enforce != 0;
+}
+
+bool DarlingServer::Process::allowsDebugFrom(const Process& caller, bool nameOnly) const {
+	/* The target's own policy is authoritative; a caller cannot opt out of
+	 * an enforced target's protection by launching itself with off/warn. */
+	if (!signingEnforce())
+		return true;
+	if (this == &caller)
+		return true;
+	/* Root is privileged only when both the host credential and the
+	 * guest-visible uid are root. This keeps rootful host-root debugging
+	 * working while preventing a guest that merely requested uid 0 from
+	 * becoming a debugger authority. */
+	if (!rootlessUserNamespace() && caller.hostUid() == 0 && caller.uid() == 0)
+		return true;
+	if (nameOnly && caller.uid() == uid())
+		return true;
+	std::shared_lock lock(_csMutex);
+	return _csState.verified != 0 && (_csState.flags & DC_CS_GET_TASK_ALLOW) != 0;
+}
