+void DarlingServer::Call::GetCsState::processCall() {
+	int code = 0;
+	uint64_t blobLen = 0;
+	uint64_t entitlementsLen = 0;
+	uint64_t derEntitlementsLen = 0;
+	struct dc_cs_state state = {};
+	state.version = DC_CS_STATE_VERSION;
+
+	if (auto callingThread = _thread.lock()) {
+		if (auto callingProcess = callingThread->process()) {
+			if (_body.state == 0) {
+				code = -EINVAL;
+			} else if (auto maybeTargetProcess = processRegistry().lookupEntryByNSID(_body.pid)) {
+				auto targetProcess = *maybeTargetProcess;
+				std::vector<uint8_t> blob;
+				std::vector<uint8_t> entitlements;
+				std::vector<uint8_t> derEntitlements;
+				targetProcess->copyCsState(&state, &blob, &entitlements, &derEntitlements);
+				blobLen = blob.size();
+				entitlementsLen = entitlements.size();
+				derEntitlementsLen = derEntitlements.size();
+
+				if (!callingProcess->writeMemory((uintptr_t) _body.state, &state, sizeof(state), &code)) {
+					code = -code;
+				} else if (_body.blob != 0 && _body.blob_size > 0 && !blob.empty()) {
+					size_t len = std::min<size_t>(blob.size(), _body.blob_size);
+					if (!callingProcess->writeMemory((uintptr_t) _body.blob, blob.data(), len, &code)) {
+						code = -code;
+					}
+				}
+				if (code == 0 && _body.entitlements != 0 && _body.entitlements_size > 0 && !entitlements.empty()) {
+					size_t len = std::min<size_t>(entitlements.size(), _body.entitlements_size);
+					if (!callingProcess->writeMemory((uintptr_t) _body.entitlements, entitlements.data(), len, &code)) {
+						code = -code;
+					}
+				}
+				if (code == 0 && _body.der_entitlements != 0 && _body.der_entitlements_size > 0 && !derEntitlements.empty()) {
+					size_t len = std::min<size_t>(derEntitlements.size(), _body.der_entitlements_size);
+					if (!callingProcess->writeMemory((uintptr_t) _body.der_entitlements, derEntitlements.data(), len, &code)) {
+						code = -code;
+					}
+				}
+			} else {
+				// An unverified process is not the same thing as a missing one.
+				code = ESRCH;
+			}
+		} else {
+			code = -ESRCH;
+		}
+	} else {
+		code = -ESRCH;
+	}
+
+	_sendReply(code, blobLen, entitlementsLen, derEntitlementsLen);
+}
