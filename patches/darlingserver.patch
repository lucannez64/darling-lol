+	std::unique_lock lock(_csMutex);
+	if (!_allowCsStateRegistration.exchange(false))
+		return false;
+	_csState = state;
+	_csState.version = DC_CS_STATE_VERSION;
+	_csState.generation = eternalID();
+	_csState.blob_len = (uint32_t) blobLen;
+	_csState.entitlements_len = (uint32_t) entitlementsLen;
+	_csState.der_entitlements_len = (uint32_t) derEntitlementsLen;
+	if (blobLen > 0)
+		_csBlob.assign(blob, blob + blobLen);
+	else
+		_csBlob.clear();
+	if (entitlementsLen > 0)
+		_csEntitlements.assign(entitlements, entitlements + entitlementsLen);
+	else
