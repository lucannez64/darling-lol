+// NSURLSession reports transport failures in NSURLErrorDomain. The CFNetwork loader below returns the raw
+// stream error (Secure Transport status, errno, host lookup code); callers that classify failures by
+// NSURLError code would treat every one of them as an unknown error. Unrecognised errors pass through.
+static NSError *_NSURLSessionTransportError(NSError *error, NSURLRequest *request)
+{
+    if (error == nil || [[error domain] isEqualToString:NSURLErrorDomain])
+        return error;
+    NSString *domain = [error domain];
+    NSInteger code = [error code];
+    NSInteger mapped = 0;
+    if ([domain isEqualToString:@"SSL"] || ([domain isEqualToString:NSOSStatusErrorDomain] && code <= -9800 && code >= -9899)) {
+        switch (code) {
+            case -9807: case -9812: case -9813: case -9843: mapped = NSURLErrorServerCertificateUntrusted; break;
+            case -9814: mapped = NSURLErrorServerCertificateHasBadDate; break;
+            case -9815: mapped = NSURLErrorServerCertificateNotYetValid; break;
+            default: mapped = NSURLErrorSecureConnectionFailed; break;
+        }
+    } else if ([domain isEqualToString:@"POSIX"] || [domain isEqualToString:NSPOSIXErrorDomain]) {
+        switch (code) {
+            case 50: case 51: case 61: case 64: case 65: mapped = NSURLErrorCannotConnectToHost; break; // ENETDOWN, ENETUNREACH, ECONNREFUSED, EHOSTDOWN, EHOSTUNREACH
+            case 60: mapped = NSURLErrorTimedOut; break;                                             // ETIMEDOUT
+            case 32: case 53: case 54: mapped = NSURLErrorNetworkConnectionLost; break;              // EPIPE, ECONNABORTED, ECONNRESET
+            default: break;
+        }
+    } else if ([domain isEqualToString:@"NetDB"] || ([domain isEqualToString:@"com.apple.cfnetwork"] && (code == 1 || code == 2))) {
+        mapped = NSURLErrorCannotFindHost;                                                          // kCFHostErrorHostNotFound, kCFHostErrorUnknown
+    }
+    if (mapped == 0)
+        return error;
+    NSMutableDictionary *info = [NSMutableDictionary dictionaryWithObject:error forKey:NSUnderlyingErrorKey];
+    NSURL *url = [request URL];
+    if (url) {
+        [info setObject:url forKey:NSURLErrorFailingURLErrorKey];
+        [info setObject:[url absoluteString] forKey:NSURLErrorFailingURLStringErrorKey];
+    }
+    return [NSError errorWithDomain:NSURLErrorDomain code:mapped userInfo:info];
+}
