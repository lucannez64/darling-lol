+
+// macOS SDK NSURLCache.h: the default shared cache has 4 MB of memory and
+// 20 MB of disk at ~/Library/Caches/<bundle id>.
+static NSUInteger NSURLCacheDefaultMemoryCapacity = 4 * 1024 * 1024;
+static NSUInteger NSURLCacheDefaultDiskCapacity = 20 * 1024 * 1024;
+
+// ~/Library/<folder>/<main bundle identifier>, or the process name when the
+// process has no bundle identifier.
+NSString* _NSURLStorageDirectory(NSString* folder)
+{
+    NSString* name = [[NSBundle mainBundle] bundleIdentifier];
+    if ([name length] == 0) {
+        name = [[NSProcessInfo processInfo] processName];
+    }
+    if ([name length] == 0 || [name rangeOfString:@"/"].location != NSNotFound) {
+        return nil;
+    }
+    NSString* home = NSHomeDirectory();
+    if ([home length] == 0) {
+        return nil;
+    }
+    return [[[home stringByAppendingPathComponent:@"Library"]
+                   stringByAppendingPathComponent:folder]
+                   stringByAppendingPathComponent:name];
+}
 
