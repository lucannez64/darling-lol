+static NSString* sanitizeGpuName(std::string rawName) {
+	const char* envOverride = getenv("DARLING_METAL_GPU_NAME");
+	if (envOverride && envOverride[0] != '\0') {
+		return [NSString stringWithUTF8String:envOverride];
+	}
+
+	// Strip driver annotations like " (RADV NAVI21)", " (LLVM ...)", etc.
+	size_t paren = rawName.find('(');
+	if (paren != std::string::npos) {
+		rawName = rawName.substr(0, paren);
+	}
+	while (!rawName.empty() && isspace((unsigned char)rawName.back())) {
+		rawName.pop_back();
+	}
+
+	// If string is empty or contains forbidden emulator strings:
+	if (rawName.empty() ||
+	    rawName.find("Darling") != std::string::npos ||
+	    rawName.find("Indium") != std::string::npos ||
+	    rawName.find("llvmpipe") != std::string::npos ||
+	    rawName.find("softpipe") != std::string::npos) {
+		return @"AMD Radeon Pro 5500M";
+	}
+
+	// Mac Metal officially supports AMD, Apple Silicon, and Intel.
+	// If the GPU is NVIDIA (unsupported on macOS Big Sur+) or something non-Mac:
+	if (rawName.find("NVIDIA") != std::string::npos ||
+	    rawName.find("GeForce") != std::string::npos ||
+	    rawName.find("Intel Arc") != std::string::npos) {
+		return @"AMD Radeon Pro 5700 XT";
+	}
+
+	return [NSString stringWithUTF8String:rawName.c_str()];
+}
