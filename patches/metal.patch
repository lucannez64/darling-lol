+++ b/src/Metal/MTLArgument.mm
@@ -0,0 +1,78 @@
+#import <Metal/MTLArgumentInternal.h>
+@implementation MTLStructMember
+@synthesize name=_name, offset=_offset;
+- (instancetype)initWithName:(NSString*)name offset:(NSUInteger)offset { self=[super init]; if(self){_name=[name copy];_offset=offset;}return self; }
+- (void)dealloc { [_name release];[super dealloc]; }
+@end
+@implementation MTLStructType
+@synthesize members=_members;
+- (instancetype)initWithMembers:(NSArray*)members { self=[super init];if(self)_members=[members copy];return self; }
+- (MTLStructMember*)memberByName:(NSString*)name { for(MTLStructMember* member in _members) if([member.name isEqualToString:name])return member; return nil; }
+- (void)dealloc { [_members release];[super dealloc]; }
+@end
+@implementation MTLArgument
+@synthesize name=_name, type=_type, index=_index, bufferAlignment=_bufferAlignment, bufferDataSize=_bufferDataSize, bufferStructType=_bufferStructType;
+- (BOOL)isActive { return YES; }
+#if DARLING_METAL_ENABLED
+- (instancetype)initWithInfo:(const Iridium::ArgumentInfo&)info {
+    self=[super init];if(self){
+        _name=[[NSString alloc] initWithUTF8String:info.name.c_str()];_index=info.index;
+        _type=info.type==Iridium::BindingType::Buffer ? MTLArgumentTypeBuffer : (info.type==Iridium::BindingType::Texture ? MTLArgumentTypeTexture : MTLArgumentTypeSampler);
+        _bufferAlignment=info.alignment;_bufferDataSize=info.size;
+        if(!info.members.empty()){
+            NSMutableArray* members=[NSMutableArray new];
+            for(const auto& member:info.members){ MTLStructMember* object=[[MTLStructMember alloc] initWithName:[NSString stringWithUTF8String:member.name.c_str()] offset:member.offset];[members addObject:object];[object release]; }
+            _bufferStructType=[[MTLStructType alloc] initWithMembers:members];[members release];
+        }
+    }return self;
+}
+#endif
+- (void)dealloc { [_name release];[_bufferStructType release];[super dealloc]; }
+@end
+#if DARLING_METAL_ENABLED
+static NSArray* argumentsForFunction(std::shared_ptr<Indium::Function> function) {
+    NSMutableArray* result=[NSMutableArray array];
+    if(function)for(const auto& info:function->argumentInfo()){
+        MTLArgument* argument=[[MTLArgument alloc] initWithInfo:info];[result addObject:argument];[argument release];
+    }
+    return result;
+}
+#endif
+@implementation MTLComputePipelineReflection
+@synthesize arguments=_arguments;
+#if DARLING_METAL_ENABLED
+- (instancetype)initWithFunction:(std::shared_ptr<Indium::Function>)function { self=[super init];if(self)_arguments=[argumentsForFunction(function) copy];return self; }
+#endif
+- (void)dealloc { [_arguments release];[super dealloc]; }
+@end
+@implementation MTLRenderPipelineReflection
+@synthesize vertexArguments=_vertexArguments, fragmentArguments=_fragmentArguments;
+#if DARLING_METAL_ENABLED
+- (instancetype)initWithVertexFunction:(std::shared_ptr<Indium::Function>)vertex fragmentFunction:(std::shared_ptr<Indium::Function>)fragment {
+    return [self initWithVertexFunction:vertex fragmentFunction:fragment vertexDescriptor:nil];
+}
+// Metal lists the vertex buffers that feed [[stage_in]] among the vertex arguments, as buffers named "vertexBuffer.<index>"
+// (the game derives which vertex streams to bind from them).
+- (instancetype)initWithVertexFunction:(std::shared_ptr<Indium::Function>)vertex fragmentFunction:(std::shared_ptr<Indium::Function>)fragment vertexDescriptor:(MTLVertexDescriptor*)vertexDescriptor {
+    self=[super init];if(self){
+        NSMutableArray* vertexArguments=[argumentsForFunction(vertex) mutableCopy];
+        NSMutableIndexSet* seen=[NSMutableIndexSet indexSet];
+        for(NSUInteger attribute=0;vertexDescriptor&&attribute<31;++attribute){
+            MTLVertexAttributeDescriptor* description=vertexDescriptor.attributes[attribute];
+            if(description.format==MTLVertexFormatInvalid||[seen containsIndex:description.bufferIndex])continue;
+            [seen addIndex:description.bufferIndex];
+            Iridium::ArgumentInfo info;
+            info.type=Iridium::BindingType::Buffer;
+            info.index=description.bufferIndex;
+            info.name="vertexBuffer."+std::to_string(description.bufferIndex);
+            info.size=vertexDescriptor.layouts[description.bufferIndex].stride;
+            info.alignment=4;
+            MTLArgument* argument=[[MTLArgument alloc] initWithInfo:info];[vertexArguments addObject:argument];[argument release];
+        }
+        _vertexArguments=vertexArguments;
+        _fragmentArguments=[argumentsForFunction(fragment) copy];
+    }return self;
+}
+#endif
+- (void)dealloc { [_vertexArguments release];[_fragmentArguments release];[super dealloc]; }
+@end
