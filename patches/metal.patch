+#if DARLING_METAL_ENABLED
+// Diagnostic (/tmp/metal-debug-timing): are the texture uploads carrying data? Sample the start of each source.
+static void MTLDebugUpload(id<MTLBuffer> source, NSUInteger offset, id<MTLTexture> destination, NSUInteger level, MTLSize size)
+{
+	if (!MTLTimingEnabled()) {
+		return;
+	}
+	const uint8_t* bytes = (const uint8_t*) source.contents;
+	if (!bytes) {
+		MTLTraceTiming("upload_sourceNotCPUVisible", 0);
+		return;
+	}
+	NSUInteger available = source.length > offset ? source.length - offset : 0;
+	NSUInteger probe = std::min<NSUInteger>(available, 4096);
+	NSUInteger nonZero = 0;
+	for (NSUInteger i = 0; i < probe; ++i) if (bytes[offset + i]) ++nonZero;
+	char name[64];
+	snprintf(name, sizeof(name), "upload_%s_f%lu", nonZero ? "data" : "ZERO", (unsigned long) destination.pixelFormat);
+	MTLTraceTiming(name, 0);
+	static unsigned long logged = 0;
+	if (!nonZero && destination.width >= 256 && ++logged <= 60) {
+		if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+			fprintf(log, "zero-upload tex=%lux%lu fmt=%lu mips=%lu level=%lu size=%lux%lu srcOffset=%lu\n", (unsigned long) destination.width, (unsigned long) destination.height, (unsigned long) destination.pixelFormat,
+				(unsigned long) destination.mipmapLevelCount, (unsigned long) level, (unsigned long) size.width, (unsigned long) size.height, (unsigned long) offset);
+			fclose(log);
+		}
+	}
+}
+#endif
