diff --git a/include/Metal/MTLExceptionBridge.h b/include/Metal/MTLExceptionBridge.h
new file mode 100644
--- /dev/null
+++ b/include/Metal/MTLExceptionBridge.h
@@ -0,0 +1,23 @@
+#pragma once
+#import <Foundation/Foundation.h>
+#include <cstdio>
+#include <exception>
+#include <string>
+
+// Metal reports failures with nil and an NSError, while the Indium backend reports them with C++
+// exceptions, which the callers of the Metal API do not expect. Call from a catch block: builds the
+// NSError from the active exception and records it in the guest's /tmp/metal-errors.log.
+static inline NSError* MTLErrorFromCurrentException(const char* where)
+{
+	std::string message = "unknown error";
+	try { throw; }
+	catch (const std::exception& e) { message = e.what(); }
+	catch (...) {}
+
+	if (FILE* log = fopen("/tmp/metal-errors.log", "a")) {
+		fprintf(log, "%s: %s\n", where, message.c_str());
+		fclose(log);
+	}
+	return [NSError errorWithDomain: @"MTLLibraryErrorDomain" code: 3
+	                       userInfo: @{NSLocalizedDescriptionKey: [NSString stringWithUTF8String: message.c_str()]}];
+}
diff --git a/include/Metal/MTLTrace.h b/include/Metal/MTLTrace.h
new file mode 100644
--- /dev/null
+++ b/include/Metal/MTLTrace.h
@@ -0,0 +1,106 @@
+#pragma once
+#include <atomic>
+#include <cstdio>
+#include <unistd.h>
+#include <ctime>
+#include <map>
+#include <mutex>
+#include <string>
+
+// All the Metal diagnostics (counters, render-pass descriptions, the magenta overrides, drawable readbacks) are
+// off unless /tmp/metal-debug-trace exists when the process starts.
+inline bool MTLDebugEnabled()
+{
+	static const bool enabled = access("/tmp/metal-debug-trace", F_OK) == 0;
+	return enabled;
+}
+
+// Total draw calls seen so far, used to attribute draws to render passes.
+inline std::atomic<unsigned long>& MTLTraceDrawTotal()
+{
+	static std::atomic<unsigned long> total { 0 };
+	return total;
+}
+
+// Diagnostic event counters, appended to the guest's /tmp/metal-trace.log every few seconds.
+inline void MTLTraceCount(const char* name)
+{
+	static const bool countDraws = MTLDebugEnabled() || access("/tmp/metal-debug-timing", F_OK) == 0 || access("/tmp/metal-debug-snapshotdraws", F_OK) == 0;
+	if (countDraws && name[0] == 'd' && name[1] == 'r' && name[2] == 'a' && name[3] == 'w') {
+		++MTLTraceDrawTotal();
+	}
+	if (!MTLDebugEnabled()) {
+		return;
+	}
+
+	static std::mutex lock;
+	static std::map<std::string, unsigned long> counts;
+	static time_t last = 0;
+
+	std::lock_guard<std::mutex> guard(lock);
+	++counts[name];
+
+	time_t now = time(nullptr);
+	if (now - last >= 3) {
+		last = now;
+		if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+			fprintf(log, "counts@%ld:", (long) now);
+			for (auto& count: counts) {
+				fprintf(log, " %s=%lu", count.first.c_str(), count.second);
+			}
+			fprintf(log, "\n");
+			fclose(log);
+		}
+	}
+}
+
+// Cheap aggregated timings (flag file /tmp/metal-debug-timing in the guest when the process starts), printed every 5 s.
+inline void MTLTraceTiming(const char* what, double seconds)
+{
+	static const bool enabled = access("/tmp/metal-debug-timing", F_OK) == 0;
+	if (!enabled) {
+		return;
+	}
+	struct Stat { double sum = 0, max = 0; unsigned long count = 0; };
+	static std::mutex lock;
+	static std::map<std::string, Stat> stats;
+	static time_t last = 0;
+	std::lock_guard<std::mutex> guard(lock);
+	Stat& stat = stats[what];
+	stat.sum += seconds;
+	stat.count++;
+	if (seconds > stat.max) stat.max = seconds;
+	time_t now = time(nullptr);
+	if (now - last >= 5) {
+		last = now;
+		if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+			fprintf(log, "mtl-timing@%ld:", (long) now);
+			for (auto& entry: stats) {
+				fprintf(log, " %s[n=%lu avg=%.1fms max=%.1fms]", entry.first.c_str(), entry.second.count, entry.second.sum / entry.second.count * 1000, entry.second.max * 1000);
+			}
+			fprintf(log, "\n");
+			fclose(log);
+		}
+		stats.clear();
+	}
+}
+
+inline bool MTLTimingEnabled()
+{
+	static const bool enabled = access("/tmp/metal-debug-timing", F_OK) == 0;
+	return enabled;
+}
+
+inline double MTLTraceNow()
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec + ts.tv_nsec / 1e9;
+}
+
+// Draw-state tracking (cheap bookkeeping for the draw log): on with the trace flag, or with /tmp/metal-debug-draws.
+inline bool MTLDrawTracking()
+{
+	static const bool enabled = MTLDebugEnabled() || access("/tmp/metal-debug-draws", F_OK) == 0;
+	return enabled;
+}
