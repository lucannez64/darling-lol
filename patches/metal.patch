+    if (descriptor && object_getClass(descriptor) == [MTLVertexAttributeDescriptor class]) _concrete |= bit; else _concrete &= ~bit;
+    // see MTLVertexBufferLayoutDescriptorArray -setObject:atIndexedSubscript: for the rule
+    if (_owner) {
+        if (!descriptor) {
+            _owner->_attrDirty &= ~bit;
+            _owner->_attrPinned &= ~bit;
+        } else {
+            const int tracking = MTLVertexAttributeItemIsExactClass(descriptor)
+                ? MTLVertexSlotTrackingFor(descriptor->_dirtyWord, descriptor->_dirtyBit, &_owner->_attrDirty, bit)
+                : 2;
+            if (tracking == 1) _owner->_attrDirty |= bit; else _owner->_attrPinned |= bit;
+        }
+    }
+}
+- (id)copyWithZone:(NSZone*)zone {
+    MTLVertexAttributeDescriptorArray* copy = [[[self class] allocWithZone:zone] init];
+    for (int i = 0; i < 31; ++i) if (_items[i]) copy->_items[i] = [_items[i] copy];
+    copy->_present = _present;
+    copy->_concrete = _concrete; // -copy of a concrete item returns the same class
+    return copy;
+}
+@end
+// The reset work itself, kept in a static so the host model can run the shipping code (see
+// tools/riot-metal-bind-model/extract-vertex-reset.py): the mask words name the slots whose values
+// may differ from the defaults, and the helpers write exactly those, in ascending slot order.
+static void MTLVertexDescriptorResetMarks(MTLVertexDescriptor* descriptor)
+{
+    const uint32_t layouts = descriptor->_layoutDirty | descriptor->_layoutPinned;
+    const uint32_t attributes = descriptor->_attrDirty | descriptor->_attrPinned;
+    descriptor->_layoutDirty = descriptor->_layoutPinned;
+    descriptor->_attrDirty = descriptor->_attrPinned;
+    MTLVertexBufferLayoutArrayResetSlots(descriptor->_layouts, layouts);
+    MTLVertexAttributeArrayResetSlots(descriptor->_attributes, attributes);
+    if (MTLVertexDescriptorResetCounters()) {
+        MTLVertexDescriptorResetCount(__builtin_popcount(layouts) + __builtin_popcount(attributes),
+                __builtin_popcount(descriptor->_layouts->_present & ~layouts) + __builtin_popcount(descriptor->_attributes->_present & ~attributes));
+    }
+}
+// Guest diagnosis, same shape as the bind counters in MTLRenderCommandEncoder.mm: with
+// /tmp/metal-debug-binds (or the trace flag) present every reset reports how many slots it had to
+// write and how many it left at the defaults, so the next match measures what the marks save.
+// The flag is tested inline at the call site, so an ordinary match pays one load and a branch.
+@implementation MTLVertexDescriptor
+@synthesize layouts = _layouts;
+@synthesize attributes = _attributes;
++ (instancetype)vertexDescriptor { return [[[self alloc] init] autorelease]; }
+- (instancetype)init { self = [super init]; if (self) [self reset]; return self; }
+- (void)dealloc {
+    // an item (or an array) a caller kept must not reach this descriptor's storage after this
+    MTLVertexBufferLayoutArrayRevokeItems(_layouts, &_layoutDirty);
+    MTLVertexAttributeArrayRevokeItems(_attributes, &_attrDirty);
+    [_layouts release]; [_attributes release]; [super dealloc];
+}
+- (void)reset {
+    if (_layouts && _attributes) {
+        // Only the slots whose values may differ from the defaults are written, in the same
+        // ascending order as before; the rest were left at the defaults by the previous reset (or
+        // hold a fresh item), so writing them would change nothing. The dirty marks are cleared as
+        // the slots are written; the pinned marks stay (their items are written every time).
+        MTLVertexDescriptorResetMarks(self);
+        return;
+    }
+    [_layouts release]; [_attributes release];
+    _layouts = [MTLVertexBufferLayoutDescriptorArray new];
+    _attributes = [MTLVertexAttributeDescriptorArray new];
+    ((MTLVertexBufferLayoutDescriptorArray*)_layouts)->_owner = self;
+    ((MTLVertexAttributeDescriptorArray*)_attributes)->_owner = self;
+    _attrDirty = 0; _attrPinned = 0; _layoutDirty = 0; _layoutPinned = 0;
+}
+- (id)copyWithZone:(NSZone*)zone {
+    MTLVertexDescriptor* copy = [[[self class] allocWithZone:zone] init];
+    [copy->_layouts release]; [copy->_attributes release];
+    copy->_layouts = [_layouts copy]; copy->_attributes = [_attributes copy];
+    // the copied items are new objects nothing tracks; bind them to the copy and let its resets
+    // write every slot they occupy (a copy is rare, and this keeps it exact without tracking it)
+    MTLVertexBufferLayoutDescriptorArray* layouts = copy->_layouts;
+    MTLVertexAttributeDescriptorArray* attributes = copy->_attributes;
+    layouts->_owner = copy;
+    attributes->_owner = copy;
+    copy->_layoutPinned = layouts->_present;
+    copy->_attrPinned = attributes->_present;
+    return copy;
+}
+#if DARLING_METAL_ENABLED
+- (Indium::VertexDescriptor)asIndiumDescriptor {
+    static Class attributeClass = [MTLVertexAttributeDescriptor class];
+    static Class layoutClass = [MTLVertexBufferLayoutDescriptor class];
+    Indium::VertexDescriptor result;
+    for (NSUInteger i = 0; i < 31; ++i) {
+        MTLVertexAttributeDescriptor* attr = [_attributes existingObjectAtIndex: i];
+        if (!attr) continue;
+        const bool concrete = object_getClass(attr) == attributeClass;
+        const auto format = concrete ? attr->_format : attr.format;
+        if (format == MTLVertexFormatInvalid) continue;
+        const auto offset = concrete ? attr->_offset : attr.offset;
+        const auto index = concrete ? attr->_bufferIndex : attr.bufferIndex;
+        result.attributes[i] = {static_cast<Indium::VertexFormat>(format), offset, index};
+        MTLVertexBufferLayoutDescriptor* layout = _layouts[index];
+        if (object_getClass(layout) == layoutClass)
+            result.layouts[index] = {layout->_stride, static_cast<Indium::VertexStepFunction>(layout->_stepFunction), layout->_stepRate};
+        else
+            result.layouts[index] = {layout.stride, static_cast<Indium::VertexStepFunction>(layout.stepFunction), layout.stepRate};
+    }
+    return result;
 }
-
 #endif
-
 @end
