+static void MTLDebugLogDraw(const char* kind, unsigned long count, unsigned long instances, unsigned long indexType, long baseVertex, id<MTLBuffer> indexBuffer, NSUInteger indexOffset)
+{
+	if (!MTLDebugEnabled()) {
+		// Light mode: only while /tmp/metal-snapshot exists, log up to 300 draws with their bindings
+		static unsigned long lightLogged = 0;
+		static unsigned long checks = 0;
+		static bool armed = false;
+        static std::string captureTag;
+        // re-read a few times a second: this runs for every draw, and a guest fopen is several host syscalls
+        if (checks++ % 4096 == 0) {
+            armed = false;
+            if (FILE* file = fopen("/tmp/metal-snapshot", "r")) {
+                char tag[48] = {};
+                if (fgets(tag, sizeof(tag), file)) {
+                    if (captureTag != tag) { captureTag = tag; lightLogged = 0; }
+                    armed = true;
+                }
+                fclose(file);
+            }
+        }
+		if (!armed || lightLogged >= 300) {
+			return;
+		}
+		++lightLogged;
+		MTLDebugDumpBindings(2000 + lightLogged);
+		{
+			// Save the raw blocks of a few block-compressed textures (decoded offline) to check the stored image
+			static std::vector<void*> dumped;
+			for (int i = 0; i < 31; ++i) {
+				id<MTLTexture> texture = debugDrawState.fragmentTextures[i];
+				unsigned long format = texture ? (unsigned long) texture.pixelFormat : 0;
+				bool bc = format == 130 || format == 131 || format == 134 || format == 135;
+				if (!bc || texture.width < 128 || dumped.size() >= 8 || std::find(dumped.begin(), dumped.end(), (void*) texture) != dumped.end()) continue;
+				dumped.push_back((void*) texture);
+				NSUInteger level = std::min<NSUInteger>(1, texture.mipmapLevelCount - 1);
+				NSUInteger width = std::max<NSUInteger>(1, texture.width >> level), height = std::max<NSUInteger>(1, texture.height >> level);
+				NSUInteger blocksX = (width + 3) / 4, blocksY = (height + 3) / 4, blockBytes = (format == 130 || format == 131) ? 8 : 16;
+				NSUInteger rowBytes = blocksX * blockBytes, total = rowBytes * blocksY;
+				id<MTLCommandQueue> queue = [[texture device] newCommandQueue];
+				id<MTLBuffer> readback = [[texture device] newBufferWithLength: total options: MTLResourceStorageModeShared];
+				id<MTLCommandBuffer> commandBuffer = [queue commandBuffer];
+				id<MTLBlitCommandEncoder> blit = [commandBuffer blitCommandEncoder];
+				[blit copyFromTexture: texture sourceSlice: 0 sourceLevel: level sourceOrigin: MTLOriginMake(0, 0, 0) sourceSize: MTLSizeMake(width, height, 1)
+				             toBuffer: readback destinationOffset: 0 destinationBytesPerRow: rowBytes destinationBytesPerImage: total];
+				[blit endEncoding];
+				[commandBuffer commit];
+				[commandBuffer waitUntilCompleted];
+				char path[128];
+				snprintf(path, sizeof(path), "/tmp/tex-%02zu-%lux%lu-f%lu-level%lu.bc", dumped.size(), (unsigned long) width, (unsigned long) height, format, (unsigned long) level);
+				if (FILE* out = fopen(path, "wb")) { fwrite(readback.contents, 1, total, out); fclose(out); }
+				[readback release];
+				[queue release];
+			}
+		}
+		if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+			fprintf(log, "draw #%lu %s count=%lu inst=%lu baseVtx=%ld pso=%p ds=%p cull=%ld wind=%ld\n", 2000 + lightLogged, kind, count, instances, baseVertex, debugDrawState.pipeline, debugDrawState.depthStencil, debugDrawState.cull, debugDrawState.winding);
+			fprintf(log, "reflect pso=%p frag:%s\n", debugDrawState.pipeline, MTLDebugReflectionFor(debugDrawState.pipeline).c_str());
+			fclose(log);
+		}
+		return;
+	}
+	static unsigned long drawn = 0;
+	static unsigned long bigDrawn = 0;
+	bool big = count >= 600 || instances > 1;
+	if (big && ++bigDrawn <= 120) {
+		MTLDebugDumpBindings(1000 + bigDrawn);
+	} else if (++drawn > 400) {
+		return;
+	}
+	const MTLDebugDrawState& state = debugDrawState;
+	if (drawn == 1 || drawn == 7 || drawn == 13 || drawn == 40) {
+		MTLDebugDumpBindings(drawn);
+		if (indexBuffer && indexBuffer.contents) {
+			if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+				const uint16_t* indices = (const uint16_t*)((const char*) indexBuffer.contents + indexOffset);
+				{
+					const unsigned char* base = (const unsigned char*) indexBuffer.contents;
+					NSUInteger from = indexOffset >= 256 ? indexOffset - 256 : 0;
+					fprintf(log, "  before-index bytes from %lu:", (unsigned long) from);
+					for (NSUInteger k = from; k < indexOffset + 16; k += 4) {
+						float f; memcpy(&f, base + k, 4);
+						unsigned u; memcpy(&u, base + k, 4);
+						fprintf(log, " %g/%08x", f, u);
+					}
+					fprintf(log, "\n");
+				}
+				fprintf(log, "  indices(type %lu, off %lu, len %lu):", indexType, (unsigned long) indexOffset, (unsigned long) indexBuffer.length);
+				for (int k = 0; k < 12; ++k) fprintf(log, " %u", indices[k]);
+				fprintf(log, "\n");
+				fclose(log);
+			}
+		}
+	}
+	if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+		fprintf(log, "draw #%lu %s count=%lu inst=%lu idxType=%lu baseVtx=%ld pso=%p ds=%p vp=(%.0f %.0f %.0f %.0f %.2f %.2f) sc=(%lu %lu %lu %lu) cull=%ld wind=%ld fill=%ld\n",
+			drawn, kind, count, instances, indexType, baseVertex, state.pipeline, state.depthStencil,
+			state.viewport.originX, state.viewport.originY, state.viewport.width, state.viewport.height, state.viewport.znear, state.viewport.zfar,
+			(unsigned long) state.scissor.x, (unsigned long) state.scissor.y, (unsigned long) state.scissor.width, (unsigned long) state.scissor.height,
+			state.cull, state.winding, state.fill);
+		fclose(log);
+	}
+}
+#endif
