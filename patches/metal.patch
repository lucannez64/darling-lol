+#if DARLING_METAL_ENABLED
+// Experiment: /tmp/metal-draw-limit holds N; every render pass then executes only its first N draws.
+static thread_local unsigned long passDrawIndex = 0;
+static bool MTLDrawLimited(unsigned long count)
+{
+	static std::atomic<unsigned long> calls { 0 };
+	static std::atomic<long> limit { -1 };
+	static std::atomic<long> minimum { 0 };
+	static std::atomic<long> maximum { -1 };
+	static const bool possible = access("/tmp/metal-debug-draws", F_OK) == 0 || MTLDebugEnabled();
+	if (!possible) {
+		return false;
+	}
+	if (calls.fetch_add(1) % 200 == 0) {
+		long value = -1;
+		if (FILE* file = fopen("/tmp/metal-draw-limit", "r")) {
+			if (fscanf(file, "%ld", &value) != 1) value = -1;
+			fclose(file);
+		}
+		limit = value;
+		long low = 0, high = -1;
+		if (FILE* file = fopen("/tmp/metal-draw-min", "r")) { if (fscanf(file, "%ld", &low) != 1) low = 0; fclose(file); }
+		if (FILE* file = fopen("/tmp/metal-draw-max", "r")) { if (fscanf(file, "%ld", &high) != 1) high = -1; fclose(file); }
+		minimum = low;
+		maximum = high;
+	}
+	// skip draws outside [min, max] index counts (experiment: which draws build which part of the picture)
+	if (count < (unsigned long) (long) minimum || (maximum >= 0 && count > (unsigned long) (long) maximum)) {
+		return true;
+	}
+	long n = limit;
+	return n >= 0 && ++passDrawIndex > (unsigned long) n;
+}
+#endif
