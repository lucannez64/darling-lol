+#if DARLING_METAL_ENABLED
+// Metal's render encoders start with every slot unbound, and a bind only replaces the value its slot
+// holds, so re-binding the identical value at the same slot cannot change what later draws see: the
+// call can be dropped before any of its work (the resource's shared_ptr copy and its atomic refcount,
+// the Indium op, and the first touch of both objects). These records are what the setters compare
+// against.
+//
+// A record holds the *Indium* object's address (`shared_ptr::get()`, see MTLBindKey), never the
+// Objective-C wrapper's address. The wrapper is not a stable identity: the game may release it while
+// the Indium encoder still keeps the resource it wrapped alive, the allocator can then hand the same
+// address to a wrapper around a different resource (transient per-draw buffers do exactly that), and a
+// comparison on the wrapper's address would drop that new resource's bind -- every later draw would
+// keep using the old one (the ABA problem). The Indium encoder holds each resource it was given until
+// the encoder ends -- `FunctionResources::textures/buffers/samplers` store the shared_ptr the setter
+// received (command-encoder.private.hpp), and the pipeline is held by `_privatePSO`/`_pipelineOwners`
+// (render-command-encoder.cpp), on both the deferred and the direct encoder path -- so an Indium
+// address cannot be reused while it is recorded. The depth-stencil state is the one kind Indium does
+// not keep (its setter reads the descriptor and issues the Vulkan commands), so its record retains
+// one itself (`_depthStencilOwner`).
+//
+// `valid` marks the slots a value was recorded for: a slot that was never bound is always forwarded,
+// and setVertexBytes/setFragmentBytes (inline data in the same slot) just clears the mark.
+struct MTLBindObjectSlots {
+	const void* keys[31] = {};
+	uint32_t valid = 0;
+};
+
+struct MTLBindBufferSlots {
+	const void* keys[31] = {};
+	NSUInteger offsets[31] = {};
+	uint32_t valid = 0;
+};
+
+// The key a bind is recorded and compared under: the Indium object's address. Reading it out of the
+// accessor's const shared_ptr reference is one load of the wrapper's payload -- no copy, no atomic.
+template<class T>
+static inline const void* MTLBindKey(const std::shared_ptr<T>& object)
+{
+	return object.get();
+}
+
+// true: the slot already holds this value, so the caller can drop the call; false: forward it, and the
+// value is recorded so the next identical call can be dropped.
+static bool MTLBindObjectSlot(MTLBindObjectSlots& slots, NSUInteger index, const void* key)
+{
+	if (index >= 31) {
+		return false;
+	}
+	const uint32_t bit = 1u << index;
+	if ((slots.valid & bit) && slots.keys[index] == key) {
+		return true;
+	}
+	slots.keys[index] = key;
+	slots.valid |= bit;
+	return false;
+}
+
+static bool MTLBindBufferSlot(MTLBindBufferSlots& slots, NSUInteger index, const void* key, NSUInteger offset)
+{
+	if (index >= 31) {
+		return false;
+	}
+	const uint32_t bit = 1u << index;
+	if ((slots.valid & bit) && slots.keys[index] == key && slots.offsets[index] == offset) {
+		return true;
+	}
+	slots.keys[index] = key;
+	slots.offsets[index] = offset;
+	slots.valid |= bit;
+	return false;
+}
+
+// The offset belongs to the buffer's slot state, so an unchanged one is dropped the same way.
+static bool MTLBindBufferOffset(MTLBindBufferSlots& slots, NSUInteger index, NSUInteger offset)
+{
+	if (index >= 31 || !(slots.valid & (1u << index))) {
+		return false;
+	}
+	if (slots.offsets[index] == offset) {
+		return true;
+	}
+	slots.offsets[index] = offset;
+	return false;
+}
+
+static void MTLBindForgetBufferSlot(MTLBindBufferSlots& slots, NSUInteger index)
+{
+	if (index < 31) {
+		slots.valid &= ~(1u << index);
+	}
+}
+
+// endEncoding: nothing may be bound after it, and the Indium encoder releases the resources it held,
+// so no record -- and no address a record kept meaningful -- survives the pass.
+static void MTLBindForgetAll(MTLBindObjectSlots& slots)
+{
+	slots = MTLBindObjectSlots {};
+}
+
+static void MTLBindForgetAll(MTLBindBufferSlots& slots)
+{
+	slots = MTLBindBufferSlots {};
+}
+
+// Diagnostic (guest flag /tmp/metal-debug-binds, or the full trace flag): count the dropped re-binds.
+// The setters test MTLBindSkipsEnabled() inline first, so a dropped call pays one load and a branch
+// rather than the counter's call frame; MTLBindSkipCount then appends the totals to the trace log on
+// the same 3 s interval as the other counters.
+static bool MTLBindSkipsEnabled()
+{
+	static const bool enabled = MTLDebugEnabled() || access("/tmp/metal-debug-binds", F_OK) == 0;
+	return enabled;
+}
+
+static void MTLBindSkipCount(const char* what)
+{
+	static const bool enabled = MTLDebugEnabled() || access("/tmp/metal-debug-binds", F_OK) == 0;
+	if (!enabled) {
+		return;
+	}
+	static std::mutex lock;
+	static std::map<std::string, unsigned long> counts;
+	static time_t last = 0;
+	std::lock_guard<std::mutex> guard(lock);
+	++counts[what];
+	time_t now = time(nullptr);
+	if (now - last >= 3) {
+		last = now;
+		if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+			fprintf(log, "bind-skips@%ld:", (long) now);
+			for (auto& count: counts) {
+				fprintf(log, " %s=%lu", count.first.c_str(), count.second);
+			}
+			fprintf(log, "\n");
+			fclose(log);
+		}
+	}
+}
+#endif
 
+#if DARLING_METAL_ENABLED
+// Live experiments (guest flag files, re-read every few hundred state changes): /tmp/metal-flag-nocull, -flipwind, -nodepth
+static bool MTLLiveFlag(int which)
+{
+	static std::atomic<unsigned long> calls { 0 };
+	static std::atomic<unsigned> state { 0 };
+	static const bool possible = access("/tmp/metal-debug-draws", F_OK) == 0 || MTLDebugEnabled();
+	if (!possible) {
+		return false;
+	}
+	if (calls.fetch_add(1) % 100 == 0) {
+		unsigned value = 0;
+		if (access("/tmp/metal-flag-nocull", F_OK) == 0) value |= 1;
+		if (access("/tmp/metal-flag-flipwind", F_OK) == 0) value |= 2;
+		if (access("/tmp/metal-flag-nodepth", F_OK) == 0) value |= 4;
+		state = value;
+	}
+	return (state & (1u << which)) != 0;
+}
