+static void MTLDebugDumpFloats(FILE* log, const char* what, int index, const void* bytes, size_t available)
+{
+	fprintf(log, "  %s[%d]:", what, index);
+	const float* floats = (const float*) bytes;
+	for (size_t i = 0; i < 16 && (i + 1) * 4 <= available; ++i) {
+		fprintf(log, " %g", floats[i]);
+	}
+	fprintf(log, "\n");
+}
+
+static void MTLDebugDumpBindings(unsigned long drawn)
+{
+	const MTLDebugDrawState& state = debugDrawState;
+	FILE* log = fopen("/tmp/metal-trace.log", "a");
+	if (!log) {
+		return;
+	}
+	fprintf(log, "bindings at draw #%lu\n", drawn);
+	for (int i = 0; i < 31; ++i) {
+		if (state.vertexBuffers[i]) {
+			id<MTLBuffer> buffer = state.vertexBuffers[i];
+			const char* contents = (const char*) buffer.contents;
+			fprintf(log, "  vbuf[%d] len=%lu off=%lu contents=%s\n", i, (unsigned long) buffer.length, (unsigned long) state.vertexOffsets[i], contents ? "cpu" : "none");
+			if (contents && state.vertexOffsets[i] < buffer.length) {
+				MTLDebugDumpFloats(log, "vdata", i, contents + state.vertexOffsets[i], buffer.length - state.vertexOffsets[i]);
+			}
+		}
+		if (state.vertexBytesLength[i]) {
+			MTLDebugDumpFloats(log, "vbytes", i, state.vertexBytes[i], std::min<size_t>(64, state.vertexBytesLength[i]));
+		}
+		if (state.fragmentBuffers[i]) {
+			id<MTLBuffer> buffer = state.fragmentBuffers[i];
+			const char* contents = (const char*) buffer.contents;
+			fprintf(log, "  fbuf[%d] len=%lu off=%lu contents=%s\n", i, (unsigned long) buffer.length, (unsigned long) state.fragmentOffsets[i], contents ? "cpu" : "none");
+			if (contents && state.fragmentOffsets[i] < buffer.length) {
+				MTLDebugDumpFloats(log, "fdata", i, contents + state.fragmentOffsets[i], buffer.length - state.fragmentOffsets[i]);
+			}
+		}
+		if (state.fragmentBytesLength[i]) {
+			MTLDebugDumpFloats(log, "fbytes", i, state.fragmentBytes[i], std::min<size_t>(64, state.fragmentBytesLength[i]));
+		}
+		if (state.fragmentTextures[i]) {
+			id<MTLTexture> texture = state.fragmentTextures[i];
+			unsigned long width = texture.width, height = texture.height, format = texture.pixelFormat;
+			unsigned long lit = 0, alpha = 0, total = 0;
+			bool read = MTLDebugEnabled() && (format == 80 || format == 81 || format == 70 || format == 71) && width * height <= 4096 * 4096;
+			if (read) {
+				id<MTLCommandQueue> queue = [[texture device] newCommandQueue];
+				id<MTLBuffer> readback = [[texture device] newBufferWithLength: width * height * 4 options: MTLResourceStorageModeShared];
+				id<MTLCommandBuffer> commandBuffer = [queue commandBuffer];
+				id<MTLBlitCommandEncoder> blit = [commandBuffer blitCommandEncoder];
+				[blit copyFromTexture: texture sourceSlice: 0 sourceLevel: 0 sourceOrigin: MTLOriginMake(0, 0, 0)
+				           sourceSize: MTLSizeMake(width, height, 1) toBuffer: readback destinationOffset: 0
+				destinationBytesPerRow: width * 4 destinationBytesPerImage: width * height * 4];
+				[blit endEncoding];
+				[commandBuffer commit];
+				[commandBuffer waitUntilCompleted];
+				const uint8_t* bytes = (const uint8_t*) readback.contents;
+				for (unsigned long k = 0; k < width * height * 4; k += 4) {
+					++total;
+					if (bytes[k] | bytes[k + 1] | bytes[k + 2]) ++lit;
+					if (bytes[k + 3]) ++alpha;
+				}
+				[readback release];
+				[queue release];
+			}
+			fprintf(log, "  ftex[%d] ptr=%p %lux%lu type=%lu mips=%lu len=%lu samples=%lu fmt=%lu%s litRGB=%lu alphaNonZero=%lu of %lu\n", i, (void*) texture, width, height, (unsigned long) texture.textureType, (unsigned long) texture.mipmapLevelCount, (unsigned long) texture.arrayLength, (unsigned long) texture.sampleCount, format, read ? "" : " (not read)", lit, alpha, total);
+		}
+	}
+	fclose(log);
+}
