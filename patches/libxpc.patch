+/* Pipe servers (including launchd) identify callers using the kernel trailer,
+ * just as connection receivers do. Serialized payloads carry no caller identity.
+ * Only the server receive paths attach it: the server cannot tell which
+ * requests its demuxers will authenticate (launchd's routines all do).
+ * Replies keep their previous empty token, which Libinfo's OpenDirectory
+ * reply check (_valid_token) already accepts.
+ */
+static audit_token_t* pipe_audit_token(mach_msg_header_t* header) {
+	mach_msg_trailer_t* trailer = (mach_msg_trailer_t*)((char*)header + round_msg(header->msgh_size));
+	if (trailer->msgh_trailer_type == MACH_MSG_TRAILER_FORMAT_0 && trailer->msgh_trailer_size >= sizeof(mach_msg_audit_trailer_t)) {
+		return &((mach_msg_audit_trailer_t*)trailer)->msgh_audit;
+	}
+	return NULL;
+}
+
 XPC_CLASS_SYMBOL_DECL(pipe);
 
