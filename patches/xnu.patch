diff --git a/darling/src/libsystem_kernel/emulation/include/common/cpu_topology.h b/darling/src/libsystem_kernel/emulation/include/common/cpu_topology.h
new file mode 100644
index 0000000..8ae1665
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/common/cpu_topology.h
@@ -0,0 +1,272 @@
+#ifndef DARLING_COMMON_CPU_TOPOLOGY_H
+#define DARLING_COMMON_CPU_TOPOLOGY_H
+
+#include <stdbool.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/common/simple.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+
+/*
+ * darling-lol: the host's real CPU topology for the hw.* / machdep.cpu.* sysctls.
+ *
+ * The guest used to be told the fixed MacBookPro16,1 configuration (8 logical
+ * and 8 physical CPUs). The game and the clients size their worker pools from
+ * hw.ncpu / hw.activecpu, so on this 6-core/12-thread host the game created 7
+ * workers where the same PC runs 12 threads under Windows. Report what the
+ * host really has instead, while the emulated Mac identity (hw.model, brand
+ * string) stays unchanged.
+ *
+ * Values are cached once per process. avail/active reflect the process's
+ * affinity mask (cgroup or taskset restrictions); max values reflect the
+ * online CPUs. The host flag file /tmp/rclol-fixed-cpu-count (checked once
+ * with a raw access() syscall) restores the old fixed values for A/B runs.
+ */
+
+/* From src/xnu_syscall/bsd/helper/misc/sysctl_proc.c */
+bool read_string(const char* path, char* dst, int maxlen);
+
+#define DARLING_CPU_FIXED_COUNT 8
+#define DARLING_CPU_MASK_BYTES 128 /* 1024 CPUs, enough for any League host */
+#define DARLING_CPU_MAX_SCAN 256
+
+/* The A/B opt-out flag file; the host check overrides the path. */
+#ifndef DARLING_CPU_FIXED_FLAG
+#define DARLING_CPU_FIXED_FLAG "/tmp/rclol-fixed-cpu-count"
+#endif
+
+struct darling_cpu_topology
+{
+	unsigned int online;             /* CPUs online on the host (hw.ncpu) */
+	unsigned int available;          /* CPUs this process may run on (hw.activecpu) */
+	unsigned int physical_online;    /* physical cores among the online CPUs */
+	unsigned int physical_available; /* physical cores among the available CPUs */
+	bool fixed;                      /* the opt-out flag file is present */
+	bool detected;                   /* the host answered; false means "use the old 8s" */
+};
+
+/* Number of CPUs in a sysfs list such as "0-1,4-5" or "0,6" */
+static inline unsigned int darling_cpu_count_list(const char* list)
+{
+	unsigned int count = 0;
+	const char* p = list;
+
+	for (;;)
+	{
+		unsigned long long first = 0, last;
+		const char* start;
+
+		while (*p == ',' || *p == ' ' || *p == '\t' || *p == '\n')
+			++p;
+		start = p;
+		while (*p >= '0' && *p <= '9')
+			first = first * 10 + (unsigned int)(*p++ - '0');
+		if (p == start)
+			break;
+
+		last = first;
+		if (*p == '-')
+		{
+			++p;
+			last = 0;
+			while (*p >= '0' && *p <= '9')
+				last = last * 10 + (unsigned int)(*p++ - '0');
+		}
+
+		if (last >= first && last - first < 4096)
+			count += (unsigned int)(last - first + 1);
+
+		if (*p != ',' && *p != ' ' && *p != '\t' && *p != '\n')
+			break;
+	}
+
+	return count;
+}
+
+static inline bool darling_cpu_mask_has(const unsigned char* mask, long mask_bytes, unsigned int cpu)
+{
+	long byte = (long)(cpu >> 3);
+
+	if (byte >= mask_bytes)
+		return false;
+	return (mask[byte] & (1u << (cpu & 7))) != 0;
+}
+
+static inline unsigned int darling_cpu_mask_count(const unsigned char* mask, long mask_bytes)
+{
+	unsigned int count = 0;
+
+	for (long i = 0; i < mask_bytes; ++i)
+		count += (unsigned int)__builtin_popcount(mask[i]);
+
+	return count;
+}
+
+/*
+ * Count distinct (physical_package_id, core_id) pairs among the CPUs in
+ * [0, online). With a mask, only the CPUs it selects are counted and their
+ * pair count is returned through available_cores. Returns the total pair
+ * count, or 0 when the host does not expose the topology (the caller then
+ * falls back to an SMT estimate).
+ */
+static inline unsigned int darling_cpu_scan_cores(const unsigned char* mask, long mask_bytes,
+		unsigned int online, unsigned int* available_cores)
+{
+	unsigned long long pairs[DARLING_CPU_MAX_SCAN], available_pairs[DARLING_CPU_MAX_SCAN];
+	unsigned int pair_count = 0, available_count = 0;
+
+	if (available_cores != NULL)
+		*available_cores = 0;
+	if (online > DARLING_CPU_MAX_SCAN)
+		return 0;
+
+	for (unsigned int cpu = 0; cpu < online; ++cpu)
+	{
+		char path[112], buf[32];
+		unsigned long long package, core, pair;
+		bool seen = false;
+
+		__simple_sprintf(path, "/sys/devices/system/cpu/cpu%u/topology/physical_package_id", cpu);
+		if (!read_string(path, buf, sizeof(buf)))
+			return 0;
+		package = __simple_atoi(buf, NULL);
+
+		__simple_sprintf(path, "/sys/devices/system/cpu/cpu%u/topology/core_id", cpu);
+		if (!read_string(path, buf, sizeof(buf)))
+			return 0;
+		core = __simple_atoi(buf, NULL);
+
+		pair = (package << 32) | (core & 0xffffffffull);
+
+		for (unsigned int i = 0; i < pair_count; ++i)
+		{
+			if (pairs[i] == pair)
+			{
+				seen = true;
+				break;
+			}
+		}
+		if (!seen)
+			pairs[pair_count++] = pair;
+
+		if (mask != NULL && darling_cpu_mask_has(mask, mask_bytes, cpu))
+		{
+			seen = false;
+			for (unsigned int i = 0; i < available_count; ++i)
+			{
+				if (available_pairs[i] == pair)
+				{
+					seen = true;
+					break;
+				}
+			}
+			if (!seen)
+				available_pairs[available_count++] = pair;
+		}
+	}
+
+	if (available_cores != NULL)
+		*available_cores = available_count;
+	return pair_count;
+}
+
+/* SMT estimate from cpu0's sibling list, used when the per-CPU scan fails. */
+static inline unsigned int darling_cpu_smt_estimate(unsigned int online)
+{
+	char buf[128];
+	unsigned int siblings;
+
+	if (!read_string("/sys/devices/system/cpu/cpu0/topology/thread_siblings_list", buf, sizeof(buf)))
+		return 0;
+
+	siblings = darling_cpu_count_list(buf);
+	if (siblings == 0 || online % siblings != 0)
+		return 0;
+	return online / siblings;
+}
+
+static inline void darling_cpu_topology_probe(struct darling_cpu_topology* topo)
+{
+	unsigned char mask[DARLING_CPU_MASK_BYTES];
+	char buf[512];
+	long mask_bytes;
+
+	*topo = (struct darling_cpu_topology) { 0 };
+
+	/* The A/B opt-out is a host flag file, like the other darling-lol opt-ins. */
+	if (LINUX_SYSCALL(__NR_access, DARLING_CPU_FIXED_FLAG, 0) == 0)
+	{
+		topo->fixed = true;
+		return;
+	}
+
+	if (read_string("/sys/devices/system/cpu/online", buf, sizeof(buf)))
+		topo->online = darling_cpu_count_list(buf);
+	else if (read_string("/sys/devices/system/cpu/present", buf, sizeof(buf)))
+		topo->online = darling_cpu_count_list(buf);
+
+	mask_bytes = LINUX_SYSCALL(__NR_sched_getaffinity, 0, (long)sizeof(mask), mask);
+	if (mask_bytes > 0)
+	{
+		if (mask_bytes > (long)sizeof(mask))
+			mask_bytes = (long)sizeof(mask);
+		topo->available = darling_cpu_mask_count(mask, mask_bytes);
+	}
+	else
+	{
+		mask_bytes = 0;
+	}
+
+	if (topo->online == 0)
+		topo->online = topo->available;
+	if (topo->available == 0)
+		topo->available = topo->online;
+	if (topo->online == 0)
+		return; /* detection failed: the caller keeps the fixed 8s */
+
+	if (topo->available > topo->online)
+		topo->available = topo->online;
+
+	topo->physical_online = darling_cpu_scan_cores(NULL, 0, topo->online, NULL);
+	if (topo->physical_online == 0)
+		topo->physical_online = darling_cpu_smt_estimate(topo->online);
+	/* libmalloc divides logical by physical and only accepts ratios 1/2/4. */
+	if (topo->physical_online == 0 || topo->online % topo->physical_online != 0)
+		topo->physical_online = topo->online;
+
+	if (mask_bytes > 0)
+	{
+		unsigned int available_cores = 0;
+		unsigned int total = darling_cpu_scan_cores(mask, mask_bytes, topo->online, &available_cores);
+
+		topo->physical_available = (total > 0) ? available_cores : topo->physical_online;
+	}
+	else
+	{
+		topo->physical_available = topo->physical_online;
+	}
+	if (topo->physical_available > topo->physical_online)
+		topo->physical_available = topo->physical_online;
+
+	topo->detected = true;
+}
+
+/* Cached for the life of the process; the probe runs at most once per copy. */
+static inline const struct darling_cpu_topology* darling_host_cpu_topology(void)
+{
+	static struct darling_cpu_topology cached;
+	static int decided;
+
+	if (__atomic_load_n(&decided, __ATOMIC_ACQUIRE) == 0)
+	{
+		struct darling_cpu_topology probe;
+
+		darling_cpu_topology_probe(&probe);
+		cached = probe;
+		__atomic_store_n(&decided, 1, __ATOMIC_RELEASE);
+	}
+
+	return &cached;
+}
+
+#endif // DARLING_COMMON_CPU_TOPOLOGY_H
diff --git a/darling/src/libsystem_kernel/emulation/include/common/private_mutex.h b/darling/src/libsystem_kernel/emulation/include/common/private_mutex.h
new file mode 100644
index 0000000..5379dd4
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/common/private_mutex.h
@@ -0,0 +1,20 @@
+#ifndef DARLING_EMULATION_PRIVATE_MUTEX_H
+#define DARLING_EMULATION_PRIVATE_MUTEX_H
+#include <darling/emulation/linux_premigration/ext/futex.h>
+/* Bootstrap-safe private mutex. Kernel emulation must not export placeholder
+ * os_unfair_lock functions: umbrella lookup can bind app calls to those stubs
+ * instead of libplatform, silently removing allocator mutual exclusion. */
+typedef struct { int value; } emulation_mutex;
+#define EMULATION_MUTEX_INITIALIZER {0}
+static inline void emulation_mutex_lock(emulation_mutex *mutex) {
+    int expected = 0;
+    if (__atomic_compare_exchange_n(&mutex->value, &expected, 1, 0,
+                                    __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;
+    while (__atomic_exchange_n(&mutex->value, 2, __ATOMIC_ACQUIRE) != 0)
+        __linux_futex_reterr(&mutex->value, FUTEX_WAIT | 128, 2, 0, 0, 0);
+}
+static inline void emulation_mutex_unlock(emulation_mutex *mutex) {
+    if (__atomic_exchange_n(&mutex->value, 0, __ATOMIC_RELEASE) == 2)
+        __linux_futex_reterr(&mutex->value, FUTEX_WAKE | 128, 1, 0, 0, 0);
+}
+#endif
diff --git a/darling/src/libsystem_kernel/emulation/include/common/slowwait.h b/darling/src/libsystem_kernel/emulation/include/common/slowwait.h
new file mode 100644
index 0000000..c310159
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/common/slowwait.h
@@ -0,0 +1,55 @@
+#ifndef _DARLING_SLOWWAIT_H_
+#define _DARLING_SLOWWAIT_H_
+/* darling-lol diagnostic: with /tmp/metal-debug-timing present, log main-thread blocking waits over 400 ms. */
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/common/simple.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+
+/* darling-lol diagnostic: with /tmp/metal-debug-timing present, log mach semaphore waits that block for more than
+ * 400 ms, with the caller's frame-pointer chain, to /tmp/semwait.log. */
+static inline int slowwait_enabled(void)
+{
+	static int state = -1;
+	if (state < 0) {
+		state = LINUX_SYSCALL(__NR_access, "/tmp/metal-debug-timing", 0) == 0 ? 1 : 0;
+	}
+	return state;
+}
+
+static inline unsigned long long slowwait_now(void)
+{
+	struct { long tv_sec; long tv_nsec; } ts;
+	LINUX_SYSCALL(__NR_clock_gettime, 1, &ts);
+	return (unsigned long long) ts.tv_sec * 1000000000ULL + (unsigned long long) ts.tv_nsec;
+}
+
+static inline void slowwait_log(const char* kind, unsigned int name, unsigned long long start, void** frame, unsigned int extra1, unsigned int extra2)
+{
+	unsigned long long elapsed = slowwait_now() - start;
+	/* only the main thread (tid == pid), the frame loop; other threads idle in these waits by design */
+	if (elapsed < 400ULL * 1000000ULL || LINUX_SYSCALL(__NR_gettid) != LINUX_SYSCALL(__NR_getpid)) {
+		return;
+	}
+	char line[512];
+	int n = __simple_sprintf(line, "%s name=%u x1=%x x2=%u ms=%llu tid=%d frames:", kind, name, extra1, extra2, elapsed / 1000000ULL, (int) LINUX_SYSCALL(__NR_gettid));
+	void** fp = frame;
+	for (int i = 0; i < 10 && fp && ((unsigned long) fp & 7) == 0; ++i) {
+		void* ret = fp[1];
+		n += __simple_sprintf(line + n, " %lx", (unsigned long) ret);
+		void** next = (void**) fp[0];
+		if (next <= fp || (unsigned long) next - (unsigned long) fp > 0x100000) {
+			break;
+		}
+		fp = next;
+	}
+	n += __simple_sprintf(line + n, "\n");
+	long fd = LINUX_SYSCALL(__NR_open, "/tmp/semwait.log", 02101 /* O_WRONLY|O_CREAT|O_APPEND */, 0666);
+	if (fd >= 0) {
+		LINUX_SYSCALL(__NR_write, fd, line, n);
+		LINUX_SYSCALL(__NR_close, fd);
+	}
+}
+
+
+
+#endif
