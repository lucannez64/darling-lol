index 0000000..05ac08f
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/sip.c
@@ -0,0 +1,286 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/misc/sip.h>
+
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/csr.h>
+#include <stdint.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/conversion/common_at.h>
+#include <darling/emulation/conversion/stat/common.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <darling/emulation/linux_premigration/vchroot_expand.h>
+
+#include <elfcalls.h>
+#include <darlingserver/cs_state.h>
+
+extern struct elf_calls* _elfcalls;
+
+int dc_sip_enabled(void) {
+	const struct dc_cs_local_state* local;
+
+	if (_elfcalls == NULL || _elfcalls->cs_state == NULL)
+		return 0;
+	local = _elfcalls->cs_state();
+	return local != NULL && local->state.sip_enabled != 0;
+}
+
+uint32_t dc_sip_csr_config(void) {
+	/* SIP off means every CSR_ALLOW_* bit is set. SIP on reports none. */
+	return dc_sip_enabled() ? 0 : CSR_VALID_FLAGS;
+}
+
+int dc_sip_check_csr(uint32_t bit) {
+	if (!dc_sip_enabled())
+		return 0;
+	return (dc_sip_csr_config() & bit) ? 0 : -EPERM;
+}
+
+static int has_path(const char* path, const char* component) {
+	size_t length = strlen(component);
+	const char* match = path;
+
+	while ((match = strstr(match, component)) != NULL) {
+		if (match[length] == '\0' || match[length] == '/')
+			return 1;
+		match += length;
+	}
+	return 0;
+}
+
+static int path_is(const char* path, const char* root) {
+	size_t length = strlen(root);
+	return strncmp(path, root, length) == 0 &&
+	       (path[length] == '\0' || path[length] == '/');
+}
+
+/* Lexically collapse "." and ".." before the policy check. vchroot_expand()
+ * resolves symlinks, but callers can still pass redundant components; without
+ * this, "/usr/local/../private/etc" would hit the /usr/local exception before
+ * the protected-path check. */
+static int normalize_path(const char* path, char* out, __SIZE_TYPE__ capacity) {
+	__SIZE_TYPE__ o = 0;
+	const char* p = path;
+
+	if (path == NULL || path[0] != '/' || capacity < 2)
+		return -1;
+	out[o++] = '/';
+	while (*p != '\0') {
+		const char* start;
+		__SIZE_TYPE__ length;
+
+		while (*p == '/')
+			p++;
+		if (*p == '\0')
+			break;
+		start = p;
+		while (*p != '\0' && *p != '/')
+			p++;
+		length = (__SIZE_TYPE__)(p - start);
+		if (length == 1 && start[0] == '.')
+			continue;
+		if (length == 2 && start[0] == '.' && start[1] == '.') {
+			if (o > 1) {
+				if (out[o - 1] == '/')
+					o--;
+				while (o > 1 && out[o - 1] != '/')
+					o--;
+			}
+			continue;
+		}
+		if (o > 1 && out[o - 1] != '/') {
+			if (o + 1 >= capacity)
+				return -1;
+			out[o++] = '/';
+		}
+		if (o + length >= capacity)
+			return -1;
+		memcpy(out + o, start, length);
+		o += length;
+	}
+	out[o] = '\0';
+	return 0;
+}
+
+
+/* SIP's hardlink defense is inode-based: a protected path registers its
+ * (dev, ino), and a write to an outside path with the same inode is denied.
+ * The fixed table is intentionally small; a full VFS would evict entries. */
+#define SIP_INODE_CAPACITY 4096
+struct sip_inode {
+	uint64_t dev;
+	uint64_t ino;
+};
+static struct sip_inode sip_inodes[SIP_INODE_CAPACITY];
+static __SIZE_TYPE__ sip_inode_count;
+static volatile int sip_inode_lock;
+static volatile int sip_inode_overflow;
+
+static void sip_inode_lock_acquire(void) {
+	while (__sync_lock_test_and_set(&sip_inode_lock, 1))
+		;
+}
+
+static void sip_inode_lock_release(void) {
+	__sync_lock_release(&sip_inode_lock);
+}
+
+static int sip_inode_is_protected(uint64_t dev, uint64_t ino) {
+	__SIZE_TYPE__ i;
+	int found = 0;
+
+	sip_inode_lock_acquire();
+	for (i = 0; i < sip_inode_count; i++) {
+		if (sip_inodes[i].dev == dev && sip_inodes[i].ino == ino) {
+			found = 1;
+			break;
+		}
+	}
+	sip_inode_lock_release();
+	return found;
+}
+
+static void sip_inode_remember(uint64_t dev, uint64_t ino) {
+	__SIZE_TYPE__ i;
+
+	sip_inode_lock_acquire();
+	for (i = 0; i < sip_inode_count; i++) {
+		if (sip_inodes[i].dev == dev && sip_inodes[i].ino == ino) {
+			sip_inode_lock_release();
+			return;
+		}
+	}
+	if (sip_inode_count < SIP_INODE_CAPACITY) {
+		sip_inodes[sip_inode_count].dev = dev;
+		sip_inodes[sip_inode_count].ino = ino;
+		sip_inode_count++;
+	} else {
+		sip_inode_overflow = 1;
+	}
+	sip_inode_lock_release();
+}
+
+#ifdef __NR_newfstatat
+#	define SIP_NR_STAT __NR_newfstatat
+#else
+#	define SIP_NR_STAT __NR_fstatat64
+#endif
+
+static int sip_stat_inode(const char* host_path, uint64_t* dev, uint64_t* ino) {
+	struct linux_stat st;
+
+	if (LINUX_SYSCALL(SIP_NR_STAT, LINUX_AT_FDCWD, host_path, &st, 0) < 0)
+		return -1;
+	*dev = (uint64_t) st.st_dev;
+	*ino = (uint64_t) st.st_ino;
+	return 0;
+}
+
+static void sip_remember_path(const char* host_path) {
+	uint64_t dev, ino;
+
+	if (host_path != NULL && sip_stat_inode(host_path, &dev, &ino) == 0)
+		sip_inode_remember(dev, ino);
+}
+
+int dc_sip_check_guest_write(const char* guest_path) {
+	if (!dc_sip_enabled() || guest_path == NULL)
+		return 0;
+	if (path_is(guest_path, "/usr/local"))
+		return 0;
+	if (sip_inode_overflow)
+		return -EPERM;
+	if (path_is(guest_path, "/System") || path_is(guest_path, "/bin") ||
+	    path_is(guest_path, "/sbin") || path_is(guest_path, "/usr") ||
+	    path_is(guest_path, "/private/etc") ||
+	    path_is(guest_path, "/private/var/db") ||
+	    path_is(guest_path, "/Library/Apple"))
+		return -EPERM;
+	return 0;
+}
+
+int dc_sip_check_fd(int fd) {
+	struct linux_stat st;
+	struct vchroot_fdpath_args args = { .fd = fd, .maxlen = sizeof(args.path) };
+	uint64_t dev = 0, ino = 0;
+	int check;
+
+	if (!dc_sip_enabled())
+		return 0;
+	if (LINUX_SYSCALL(__NR_fstat, fd, &st) == 0) {
+		dev = (uint64_t) st.st_dev;
+		ino = (uint64_t) st.st_ino;
+		if (sip_inode_is_protected(dev, ino))
+			return -EPERM;
+	}
+	if (vchroot_fdpath(&args) != 0)
+		return 0;
+	check = dc_sip_check_guest_write(args.path);
+	if (check != 0 && dev != 0)
+		sip_inode_remember(dev, ino);
+	return check;
+}
+
+int dc_sip_check_write(const char* host_path) {
+	char normalized[4096];
+	struct vchroot_unexpand_args unexpanded;
+	const char* path = host_path;
+	const char* host_stat_path = host_path;
+	int guest_path = 0;
+
+	if (!dc_sip_enabled() || host_path == NULL)
+		return 0;
+	if (normalize_path(host_path, normalized, sizeof(normalized)) == 0) {
+		path = normalized;
+		host_stat_path = normalized;
+	}
+
+	/* Map back to the guest namespace so a host prefix containing /System,
+	 * /usr or /bin cannot cause false refusals, and a user path such as
+	 * /Users/alice/System is not mistaken for the protected root. */
+	if (strlen(path) < sizeof(unexpanded.path)) {
+		strcpy(unexpanded.path, path);
+		if (vchroot_unexpand(&unexpanded) == 0 && unexpanded.path[0] == '/') {
+			path = unexpanded.path;
+			guest_path = 1;
+		}
+	}
+
+    // Inode restrictions survive all aliases, including /usr/local.
+    {
+        uint64_t dev, ino;
+        if (sip_stat_inode(host_stat_path, &dev, &ino) == 0 && sip_inode_is_protected(dev, ino))
+            return -EPERM;
+    }
+	if (guest_path) {
+		if (path_is(path, "/usr/local"))
+			return 0;
+		if (sip_inode_overflow)
+			return -EPERM;
+		if (path_is(path, "/System") || path_is(path, "/bin") ||
+		    path_is(path, "/sbin") || path_is(path, "/usr") ||
+		    path_is(path, "/private/etc") ||
+		    path_is(path, "/private/var/db") ||
+		    path_is(path, "/Library/Apple")) {
+			sip_remember_path(host_stat_path);
+			return -EPERM;
+		}
+		return 0;
+	}
+
+	/* Fallback for an uninitialized vchroot: be conservative. */
+	if (sip_inode_overflow)
+		return -EPERM;
+	if (has_path(path, "/System") || has_path(path, "/bin") ||
+	    has_path(path, "/sbin") || has_path(path, "/usr") ||
+	    has_path(path, "/private/etc") ||
+	    has_path(path, "/private/var/db") ||
+	    has_path(path, "/Library/Apple")) {
+		if (has_path(path, "/usr/local"))
+			return 0;
+		sip_remember_path(host_stat_path);
+		return -EPERM;
+	}
+	return 0;
+}
