+/* Called from sys_bsdthread_register (libpthread's per-process initialization). */
+__attribute__((visibility("hidden")))
+void __darling_core_isolate_main_thread(void)
+{
+	unsigned long long cookie = 0;
+	int expected = 0;
+	long err;
