+		} else if (__atomic_load_n(&slot->streak, __ATOMIC_RELAXED) < 1000000) {
+			__atomic_fetch_add(&slot->streak, 1, __ATOMIC_RELAXED);
+		}
+	} else {
+		__atomic_store_n(&slot->streak, 0, __ATOMIC_RELAXED);
+	}
+}
