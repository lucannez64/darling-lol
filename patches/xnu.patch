+
+/* darling-lol: core isolation for the game's initial thread.
+ *
+ * The game's main thread is the bottleneck (~80% of one core) and in the last matches 16% of its running time (up
+ * to 36% in fights) another thread of ours ran on its SMT sibling. Linux core scheduling (CONFIG_SCHED_CORE,
+ * prctl PR_SCHED_CORE, 5.13+) lets a task carry a cookie: tasks with different cookies (an untagged task has
+ * cookie 0) are never scheduled on the same physical core at the same time, the losing sibling is forced idle.
+ * The main thread creates a cookie of its own, so no other thread of the process, no darlingserver thread and no
+ * other process can share its core; the kernel keeps the rest of the system's SMT pairing as it was. On this host
+ * (first run 2026-10-14, build/perf-research/core-isolation/) two threads pinned to the two SMT siblings of one
+ * core did one thread's work when one was tagged and the other was not, and twice that when both were untagged or
+ * shared a cookie.
+ *
+ * A new thread inherits the cookie of the thread that created it (kernel core_sched.c: sched_core_fork()), so a
+ * thread created by the tagged main thread would carry the main cookie and could run on its core again. Every
+ * other thread of the process therefore shares one *other* cookie instead: the first one to start creates it and
+ * remembers its tid, later threads take it over with PR_SCHED_CORE_SHARE_FROM. They stay in one group (they may
+ * still share cores with each other, as before) and only the main thread becomes incompatible with everything
+ * else. Thread pools retire their threads, so if the recorded owner is gone (SHARE_FROM fails) the caller creates
+ * a fresh cookie and takes the role over. A forked child inherits the record as well, and the tid in it can then
+ * name a task of the parent (or of an unrelated process), so the record is only used while it belongs to the
+ * process reading it; a child's first thread takes the worker role over with a cookie of its own.
+ *
+ * Best effort throughout: if the prctl is unavailable (EINVAL/EPERM/ENODEV - host without CONFIG_SCHED_CORE, SMT
+ * off, or a kernel without the feature) nothing changes.
+ *
+ * Opt-in, only with the host file /tmp/rclol-core-isolation: in the first match with it on (2026-10-14, Hexgate,
+ * same minutes compared) the game fell from 118 to 103 fps. The main thread waited for a CPU 12.6% of the time
+ * (1% without) and the other game threads queued as well: forced idle siblings cost more on this busy 6-core host
+ * than the sharing they prevent.
+ * The decision is appended once per process to /tmp/rclol-game-decisions.log as
+ * "core_isolation=0|1 errno=<prctl result, -1 off, -2 registration was not on the initial thread> cookie=<hash>". */
+#define LCORE_PRCTL_SCHED_CORE 62 /* include/uapi/linux/prctl.h */
+#define LCORE_GET 0
+#define LCORE_CREATE 1        /* give the calling thread a cookie of its own */
+#define LCORE_SHARE_FROM 3    /* the calling thread takes over the cookie of the thread at arg3 */
+#define LCORE_SCOPE_THREAD 0
+
+static volatile int lcore_state;      /* 0 undecided, 1 on, -1 off */
+static volatile int lcore_main;       /* 0 not tried, 1 the initial thread has its own cookie, -1 it has none */
+static volatile int lcore_worker_tid; /* tid whose cookie the other threads share, 0 = none yet */
+static volatile int lcore_worker_pid; /* process that tid belongs to; a forked child must not use it */
+
+static void lcore_log(int on, long err, unsigned long long cookie)
+{
+	char line[128];
+	long log = LINUX_SYSCALL(__NR_open, "/tmp/rclol-game-decisions.log", 02101 /* O_WRONLY|O_CREAT|O_APPEND */, 0666);
+	if (log < 0)
+		return;
+	int len = __simple_sprintf(line, "pid=%d core_isolation=%d errno=%ld cookie=%llu\n",
+			(int) LINUX_SYSCALL(__NR_getpid), on, err, cookie);
+	LINUX_SYSCALL(__NR_write, log, line, len);
+	LINUX_SYSCALL(__NR_close, log);
+}
+
+static int lcore_decide(void)
+{
+	int state = __atomic_load_n(&lcore_state, __ATOMIC_ACQUIRE);
+	if (state != 0)
+		return state;
+	if (__darling_is_league_game() && LINUX_SYSCALL(__NR_access, "/tmp/rclol-core-isolation", 0) == 0)
+		state = 1;
+	else
+		state = -1;
+	__atomic_store_n(&lcore_state, state, __ATOMIC_RELEASE);
+	return state;
+}
