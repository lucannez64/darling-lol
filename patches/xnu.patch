+/* darling-lol: process-local Mach semaphores.
+ *
+ * Every semaphore_wait/semaphore_signal used to be a round trip to darlingserver: the caller sends a message and sleeps
+ * until the server thread has run and answered. League's job system and libdispatch use Mach semaphores to hand work to
+ * threads of the same process (about 19 such round trips per frame on the main thread alone, 2026-10-10), so each
+ * wake-up paid two extra context switches and the caller of semaphore_signal blocked for the server's turnaround.
+ *
+ * A semaphore created by this task (semaphore_create on mach_task_self) is now also kept here as a futex counter and
+ * all traps on it are served locally. The server-side object still exists, so the port name stays valid, but it is
+ * never signalled. Anything the table did not insert itself -- a name it has never seen, a semaphore created by or
+ * for another task, an inherited name in a fork child -- goes to the server path unchanged; the two are never mixed
+ * for one name.
+ *
+ * A slot is (name, generation, value). The generation changes on every assignment and on every destroy, and value+gen
+ * share one atomic word, so a waiter takes a token with a compare-exchange on that word: it can only ever consume a
+ * token of the generation it resolved, and a slot reused after a destroy -- even under the same port name -- is a
+ * different generation, which fails the compare-exchange or one of the generation/name checks every operation makes.
+ * KERN_TERMINATED on a slot that no longer names the resolved object is what Darwin returns for a semaphore that died
+ * while the call was in flight. A fork tombstones the child's copy of the table (see
+ * __darling_local_semaphores_after_fork): the child's IPC space is fresh, no inherited name is valid there.
+ *
+ * LIMITS: a semaphore whose right is sent to another process is signalled through the server on the other side and
+ * never reaches this counter (nothing in the game does this; the counters in build/perf-research/blocking are meant
+ * to prove it before this becomes default); a local wait cannot be interrupted by thread_abort/pthread_cancel (the
+ * server does not know about it), so only a signal, a destroy or its timeout ends one; semaphore_signal_thread with
+ * a specific thread answers KERN_NOT_WAITING. build/perf-research/lsem-fix/REPORT.md has the full list.
+ *
+ * On by default in the League game process only, unless the host file /tmp/rclol-no-local-semaphores exists
+ * (/tmp/rclol-local-semaphores, the former opt-in switch, is now a no-op). While it was on by default in every
+ * process (2026-10-10 22:22-23:50) LeagueClient died ~85 s after start in 3 of 4 checked launches
+ * ("mach_msg_overwrite failed -9", then dserver_rpc_interrupt_enter -9: its RPC descriptor had become invalid) and
+ * the client logged integrity-check errors; that mechanism is not understood, so the clients keep the server path. With the
+ * lifetime fixes above the game ran two full matches with it (2026-10-14: the main thread's server waits fell from
+ * 1.36 to 0.10 ms per frame, 39 to 15 blocks per frame). /tmp/rclol-local-semaphores-all turns it on for every
+ * process (probe tests). Decided once per process and logged
+ * once per game process to /tmp/rclol-game-decisions.log as local_semaphores=0|1. */
+#define LSEM_SLOTS 8192u
+#define LSEM_TOMB 0xffffffffu
+/* What a destroy leaves in the token word: a negative count, so no waiter and no signal can take it for a live
+ * token even if it resolved the slot while the destroy was still in flight (the generation and the name are only
+ * two more loads away from being visible; the value is the one the token compare-exchange goes through). */
+#define LSEM_TOMB_VALUE (-1)
+#define LSEM_FUTEX_WAIT 0
+#define LSEM_FUTEX_WAKE 1
+#define LSEM_FUTEX_PRIVATE 0x80u /* FUTEX_PRIVATE_FLAG: the word is always this process's own memory */
+/* The token count and the generation are one atomic word: lsem_wait takes a token with a compare-exchange on the
+ * pair, so the token can only come from the generation it checked. The low half is the futex word the syscalls
+ * address; every value write is a generation-checked compare-exchange, never a plain add. */
+union lsem_pv {
+	unsigned long long pair;
+	struct {
+		volatile int value;
+		volatile unsigned int gen;
+	} w;
+};
+_Static_assert(sizeof(union lsem_pv) == 8 && _Alignof(union lsem_pv) == 8,
+	"the token and the generation must share one naturally aligned atomic word");
+struct lsem {
+	union lsem_pv pv;
+	volatile unsigned int name;
+	volatile int waiters; /* a hint for the signal wake filter and signal_all's count; the futex protocol carries correctness */
+};
+/* The second semaphore of a combined wait_signal/timedwait_signal trap. XNU registers the wait on the wait semaphore
+ * and only then signals the signal semaphore (even when the wait did not block); a local wait signals it from inside
+ * the loop, at that same point (see lsem_post_signal). */
+struct lsem_post {
+	struct lsem* s; /* 0: not local, signal the name through the server */
+	unsigned int name;
+	unsigned int gen;
+	volatile int done;
+};
+static struct lsem lsems[LSEM_SLOTS];
+static volatile int lsem_state; /* 0 undecided, 1 on, -1 off */
+static volatile int lsem_lock;
+
+extern kern_return_t __darling_rpc_semaphore_create(mach_port_name_t task, mach_port_name_t* semaphore, int policy, int value);
+extern kern_return_t __darling_rpc_semaphore_destroy(mach_port_name_t task, mach_port_name_t semaphore);
+
