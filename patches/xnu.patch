+		expected = 0;
+		if (__atomic_compare_exchange_n(&lcore_worker_tid, &expected, me, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+			__atomic_store_n(&lcore_worker_pid, pid, __ATOMIC_RELEASE);
+			return; /* this thread owns the shared worker cookie from now on */
+		}
+		/* the published owner belongs to a process that no longer is this one (a forked child saw the
+		 * parent's record): it must not be used, the cookie created above becomes the shared one */
+		if (__atomic_load_n(&lcore_worker_pid, __ATOMIC_ACQUIRE) != pid) {
+			__atomic_store_n(&lcore_worker_tid, me, __ATOMIC_RELEASE);
+			__atomic_store_n(&lcore_worker_pid, pid, __ATOMIC_RELEASE);
+			return;
+		}
+		owner = expected; /* another thread of this process published its cookie first: join it */
+	}
+
+	if (owner == me)
+		return;
+	if (LINUX_SYSCALL5(__NR_prctl, LCORE_PRCTL_SCHED_CORE, LCORE_SHARE_FROM, owner, LCORE_SCOPE_THREAD, 0) == 0)
+		return;
+	/* the recorded owner is gone (retired worker, or a parent process after fork): take the role over */
+	if (LINUX_SYSCALL5(__NR_prctl, LCORE_PRCTL_SCHED_CORE, LCORE_CREATE, 0, LCORE_SCOPE_THREAD, 0) != 0)
+		return;
+	expected = owner;
+	if (__atomic_compare_exchange_n(&lcore_worker_tid, &expected, me, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		__atomic_store_n(&lcore_worker_pid, pid, __ATOMIC_RELEASE);
+		return;
+	}
+	if (expected != 0 && expected != me)
+		LINUX_SYSCALL5(__NR_prctl, LCORE_PRCTL_SCHED_CORE, LCORE_SHARE_FROM, expected, LCORE_SCOPE_THREAD, 0);
+}
+
+static void lsem_log(int on)
+{
+	char line[96];
+	long log = LINUX_SYSCALL(__NR_open, "/tmp/rclol-game-decisions.log", 02101 /* O_WRONLY|O_CREAT|O_APPEND */, 0666);
+	if (log < 0)
+		return;
+	int len = __simple_sprintf(line, "pid=%d local_semaphores=%d\n", (int) LINUX_SYSCALL(__NR_getpid), on);
+	LINUX_SYSCALL(__NR_write, log, line, len);
+	LINUX_SYSCALL(__NR_close, log);
+}
+
+static int lsem_decide(void)
+{
+	int state = __atomic_load_n(&lsem_state, __ATOMIC_ACQUIRE);
+	int on = 0;
+	int expected = 0;
+	if (state != 0)
+		return state;
+	if (LINUX_SYSCALL(__NR_access, "/tmp/rclol-local-semaphores-all", 0) == 0)
+		on = 1;
+	else if (LINUX_SYSCALL(__NR_access, "/tmp/rclol-no-local-semaphores", 0) != 0)
+		on = darling_is_league_game();
+	if (__atomic_compare_exchange_n(&lsem_state, &expected, on ? 1 : -1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		/* the one line per game process in the host file, next to core_isolation (lcore_log) */
+		if (darling_is_league_game())
+			lsem_log(on);
+		return on ? 1 : -1;
+	}
+	return __atomic_load_n(&lsem_state, __ATOMIC_ACQUIRE); /* another thread decided first */
+}
+
+static inline unsigned int lsem_hash(unsigned int name)
+{
+	return (name * 2654435761u) >> 19; /* 13 bits */
+}
+
+/* The generation the caller's lsem_find resolved. Every operation re-checks it, so work that started before a
+ * destroy can never land on the object that took the slot afterwards. */
+static inline unsigned int lsem_capture(struct lsem* s)
+{
+	return __atomic_load_n(&s->pv.w.gen, __ATOMIC_ACQUIRE);
+}
+
+static struct lsem* lsem_find(unsigned int name)
+{
+	if (__atomic_load_n(&lsem_state, __ATOMIC_ACQUIRE) != 1 || name == 0 || name == LSEM_TOMB)
+		return 0;
+	unsigned int i = lsem_hash(name);
+	for (unsigned int n = 0; n < LSEM_SLOTS; ++n, i = (i + 1) & (LSEM_SLOTS - 1)) {
+		unsigned int have = __atomic_load_n(&lsems[i].name, __ATOMIC_ACQUIRE);
+		if (have == name)
+			return &lsems[i];
+		if (have == 0)
+			return 0;
+	}
+	return 0;
+}
+
+static void lsem_table_lock(void)
+{
+	int expected = 0;
+	while (!__atomic_compare_exchange_n(&lsem_lock, &expected, 1, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+		LINUX_SYSCALL(__NR_futex, &lsem_lock, LSEM_FUTEX_WAIT | LSEM_FUTEX_PRIVATE, 1, 0UL, 0UL, 0);
+		expected = 0;
+	}
+}
+
+static void lsem_table_unlock(void)
+{
+	__atomic_store_n(&lsem_lock, 0, __ATOMIC_RELEASE);
+	LINUX_SYSCALL(__NR_futex, &lsem_lock, LSEM_FUTEX_WAKE | LSEM_FUTEX_PRIVATE, 1, 0UL, 0UL, 0);
+}
+
+static void lsem_insert(unsigned int name, int value)
+{
+	if (name == 0 || name == LSEM_TOMB)
+		return;
+	lsem_table_lock();
+	struct lsem* free_slot = 0;
+	struct lsem* found = 0;
+	unsigned int i = lsem_hash(name);
+	for (unsigned int n = 0; n < LSEM_SLOTS; ++n, i = (i + 1) & (LSEM_SLOTS - 1)) {
+		unsigned int have = lsems[i].name;
+		if (have == name) { found = &lsems[i]; break; }
+		if (have == LSEM_TOMB && !free_slot) free_slot = &lsems[i];
+		if (have == 0) { if (!free_slot) free_slot = &lsems[i]; break; }
+	}
+	if (!found) found = free_slot;
+	if (found) { /* a full table leaves the semaphore to the server */
+		/* The new generation and the initial value are one atomic word: a waiter that looked up the old
+		 * generation can never observe a half-updated slot, and no generation is ever handed out twice. */
+		unsigned long long old = __atomic_load_n(&found->pv.pair, __ATOMIC_RELAXED);
+		unsigned long long fresh = (((old >> 32) + 1) << 32) | (unsigned int) (value < 0 ? 0 : value);
+		__atomic_store_n(&found->pv.pair, fresh, __ATOMIC_RELEASE);
+		__atomic_store_n(&found->waiters, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&found->name, name, __ATOMIC_RELEASE);
+	}
+	lsem_table_unlock();
+}
+
+static void lsem_remove(unsigned int name)
+{
+	struct lsem* s = lsem_find(name);
+	if (!s)
+		return;
+	lsem_table_lock();
+	/* Between the find and the lock another thread may have destroyed (and re-created) the name: the slot then
+	 * holds an object this destroy was not called on, so leave it alone. */
+	if (__atomic_load_n(&s->name, __ATOMIC_ACQUIRE) != name) {
+		lsem_table_unlock();
+		return;
+	}
+	/* gen+1 and the tombstone value in one word: a waiter either took its token before this compare-exchange or it
+	 * sees the new generation (or the negative value) and returns KERN_TERMINATED; a waiter of a later object in
+	 * the slot can never see a generation it did not resolve. */
+	for (;;) {
+		unsigned long long old = __atomic_load_n(&s->pv.pair, __ATOMIC_SEQ_CST);
+		unsigned long long want = (((old >> 32) + 1) << 32) | (unsigned int) LSEM_TOMB_VALUE;
+		if (__atomic_compare_exchange_n(&s->pv.pair, &old, want, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+			break;
+	}
+	__atomic_store_n(&s->name, LSEM_TOMB, __ATOMIC_RELEASE);
+	__atomic_store_n(&s->waiters, 0, __ATOMIC_RELAXED);
+	LINUX_SYSCALL(__NR_futex, &s->pv.w.value, LSEM_FUTEX_WAKE | LSEM_FUTEX_PRIVATE, 0x7fffffff, 0UL, 0UL, 0);
+	lsem_table_unlock();
+}
+
+/* Returns KERN_TERMINATED when the slot no longer names the object the caller resolved: the check and the token are
+ * one compare-exchange on the generation+value word, so no token is ever added to the object that took the slot. */
+static kern_return_t lsem_signal(struct lsem* s, unsigned int name, unsigned int gen)
+{
+	for (;;) {
+		unsigned long long old = __atomic_load_n(&s->pv.pair, __ATOMIC_SEQ_CST);
+		if ((unsigned int) (old >> 32) != gen || __atomic_load_n(&s->name, __ATOMIC_ACQUIRE) != name)
+			return KERN_TERMINATED;
+		if ((int) (unsigned int) old < 0)
+			return KERN_TERMINATED; /* the tombstone value: the object is being destroyed */
+		if (__atomic_compare_exchange_n(&s->pv.pair, &old, old + 1, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+			break;
+	}
+	if (__atomic_load_n(&s->waiters, __ATOMIC_SEQ_CST) > 0)
+		LINUX_SYSCALL(__NR_futex, &s->pv.w.value, LSEM_FUTEX_WAKE | LSEM_FUTEX_PRIVATE, 1, 0UL, 0UL, 0);
+	return KERN_SUCCESS;
+}
+
+static kern_return_t lsem_signal_all(struct lsem* s, unsigned int name, unsigned int gen)
+{
+	for (;;) {
+		unsigned long long old = __atomic_load_n(&s->pv.pair, __ATOMIC_SEQ_CST);
+		int n;
+		if ((unsigned int) (old >> 32) != gen || __atomic_load_n(&s->name, __ATOMIC_ACQUIRE) != name)
+			return KERN_TERMINATED;
+		if ((int) (unsigned int) old < 0)
+			return KERN_TERMINATED; /* the tombstone value: the object is being destroyed */
+		/* wake everybody who is waiting now; nothing is left over for later waiters (XNU resets the count, and
+		 * the trap version banks no count when nobody waits) */
+		n = __atomic_load_n(&s->waiters, __ATOMIC_SEQ_CST);
+		if (n <= 0)
+			return KERN_SUCCESS;
+		if (__atomic_compare_exchange_n(&s->pv.pair, &old, old + (unsigned int) n, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+			LINUX_SYSCALL(__NR_futex, &s->pv.w.value, LSEM_FUTEX_WAKE | LSEM_FUTEX_PRIVATE, n, 0UL, 0UL, 0);
+			return KERN_SUCCESS;
+		}
+	}
+}
+
+static kern_return_t lsem_signal_thread(struct lsem* s, unsigned int name, unsigned int gen, unsigned int thread_name)
+{
+	unsigned long long old = __atomic_load_n(&s->pv.pair, __ATOMIC_SEQ_CST);
+	if ((unsigned int) (old >> 32) != gen || __atomic_load_n(&s->name, __ATOMIC_ACQUIRE) != name ||
+	    (int) (unsigned int) old < 0)
+		return KERN_TERMINATED;
+	if (thread_name != 0)
+		return KERN_NOT_WAITING; /* a specific thread is not addressable here; see the header comment */
+	if (__atomic_load_n(&s->waiters, __ATOMIC_SEQ_CST) <= 0)
+		return KERN_NOT_WAITING; /* nobody waiting: XNU banks no count here either */
+	return lsem_signal(s, name, gen);
+}
+
+/* Signal the signal semaphore of a combined trap, once, at the point XNU would (after the wait on the other
+ * semaphore registered itself, or after it already succeeded). */
+static kern_return_t lsem_post_signal(struct lsem_post* post)
+{
+	if (!post || __atomic_exchange_n(&post->done, 1, __ATOMIC_ACQ_REL))
+		return KERN_SUCCESS;
+	if (post->s)
+		return lsem_signal(post->s, post->name, post->gen);
+	return semaphore_signal_trap_impl(post->name); /* not local: signal it through the server */
+}
+
+/* timeout: nanoseconds, or -1 to wait forever. (name, gen) is what the caller's lsem_find resolved. */
+static kern_return_t lsem_wait(struct lsem* s, unsigned int name, unsigned int gen, long long timeout_ns, struct lsem_post* post)
+{
+	struct { long tv_sec; long tv_nsec; } now, rel;
+	long long deadline = 0;
+	if (timeout_ns >= 0) {
+		LINUX_SYSCALL(__NR_clock_gettime, 1 /* CLOCK_MONOTONIC */, &now);
+		deadline = now.tv_sec * 1000000000ll + now.tv_nsec + timeout_ns;
+	}
+	for (;;) {
+		/* both the generation and the name have to match: a slot reused for a different object, even one that
+		 * got the same port name again, must not be waited on (Darwin terminated the object we resolved) */
+		if ((unsigned int) __atomic_load_n(&s->pv.w.gen, __ATOMIC_ACQUIRE) != gen ||
+		    __atomic_load_n(&s->name, __ATOMIC_ACQUIRE) != name) {
+			(void) lsem_post_signal(post); /* XNU signals the signal semaphore even when the wait fails */
+			return KERN_TERMINATED;
+		}
+		unsigned long long old = __atomic_load_n(&s->pv.pair, __ATOMIC_SEQ_CST);
+		if ((unsigned int) (old >> 32) != gen)
+			continue; /* the slot changed while we looked at it: the top of the loop reports it */
+		int v = (int) (unsigned int) old;
+		if (v < 0) {
+			/* the destroy tombstone: a trap that resolved the slot while the destroy was in flight must
+			 * report the death, never take the tombstone for a token */
+			(void) lsem_post_signal(post);
+			return KERN_TERMINATED;
+		}
+		if (v > 0) {
+			/* take the token only if value and generation still belong to this object: the compare-exchange
+			 * is on the whole pair, so a reused slot cannot hand its token to this waiter */
+			if (__atomic_compare_exchange_n(&s->pv.pair, &old, old - 1, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+				kern_return_t kr = lsem_post_signal(post);
+				/* the wait succeeded; XNU swallows a dead signal semaphore in this case */
+				return (kr == KERN_SUCCESS || kr == KERN_TERMINATED) ? KERN_SUCCESS : kr;
+			}
+			continue;
+		}
+		void* ts = 0;
+		if (timeout_ns >= 0) {
+			LINUX_SYSCALL(__NR_clock_gettime, 1, &now);
+			long long left = deadline - (now.tv_sec * 1000000000ll + now.tv_nsec);
+			if (left <= 0) {
+				kern_return_t kr = lsem_post_signal(post);
+				return (kr == KERN_SUCCESS || kr == KERN_TERMINATED) ? KERN_OPERATION_TIMED_OUT : kr;
+			}
+			rel.tv_sec = left / 1000000000ll;
+			rel.tv_nsec = left % 1000000000ll;
+			ts = &rel;
+		}
+		/* register (signal_all and signal_thread see us) and only then release the signal semaphore, as XNU does */
+		__atomic_add_fetch(&s->waiters, 1, __ATOMIC_SEQ_CST);
+		if (post) {
+			kern_return_t kr = lsem_post_signal(post);
+			if (kr != KERN_SUCCESS) {
+				__atomic_sub_fetch(&s->waiters, 1, __ATOMIC_SEQ_CST);
+				return kr;
+			}
+		}
+		LINUX_SYSCALL(__NR_futex, &s->pv.w.value, LSEM_FUTEX_WAIT | LSEM_FUTEX_PRIVATE, 0, ts, 0UL, 0);
+		__atomic_sub_fetch(&s->waiters, 1, __ATOMIC_SEQ_CST);
+	}
+}
+
+VISIBLE
+kern_return_t semaphore_create(mach_port_name_t task, mach_port_name_t* semaphore, int policy, int value)
+{
+	kern_return_t kr = __darling_rpc_semaphore_create(task, semaphore, policy, value);
+	if (kr == KERN_SUCCESS && task == mach_task_self()) {
+		int state = __atomic_load_n(&lsem_state, __ATOMIC_ACQUIRE);
+		if (state == 0)
+			state = lsem_decide();
+		if (state == 1)
+			lsem_insert(*semaphore, value);
+	}
+	return kr;
+}
+
+VISIBLE
+kern_return_t semaphore_destroy(mach_port_name_t task, mach_port_name_t semaphore)
+{
+	if (task == mach_task_self())
+		lsem_remove(semaphore);
+	return __darling_rpc_semaphore_destroy(task, semaphore);
+}
+
+/* darling-lol: the child of fork() has a fresh IPC space (duct-tape ipc_task_init creates an empty one), so a
+ * semaphore name inherited from the parent is not valid in the child. Without this reset the inherited table would
+ * serve the child's traps for those names locally: a wait would succeed without any object behind it (or block where
+ * the server would answer KERN_INVALID_NAME), and a signal would be a no-op the parent (a different address space
+ * after fork) never sees. Runs in the forking thread right after the host fork, before any other thread of the child
+ * exists: the table has no waiters to wake, and the lock (possibly held by a parent thread that does not exist in the
+ * child) can simply be dropped. */
+__attribute__((visibility("hidden")))
+void __darling_local_semaphores_after_fork(void)
+{
+	if (__atomic_load_n(&lsem_state, __ATOMIC_ACQUIRE) != 1)
+		return;
+	for (unsigned int i = 0; i < LSEM_SLOTS; ++i) {
+		unsigned int have = lsems[i].name;
+		if (have != 0 && have != LSEM_TOMB) {
+			unsigned long long old = __atomic_load_n(&lsems[i].pv.pair, __ATOMIC_RELAXED);
+			__atomic_store_n(&lsems[i].pv.pair, (((old >> 32) + 1) << 32) | 0, __ATOMIC_RELEASE);
+			__atomic_store_n(&lsems[i].name, LSEM_TOMB, __ATOMIC_RELEASE);
+			__atomic_store_n(&lsems[i].waiters, 0, __ATOMIC_RELAXED);
+		}
+	}
+	lsem_lock = 0;
+}
+
+/* darling-lol: mach_vm_region_recurse on the caller's own task, answered in the process.
+ *
+ * darlingserver answers this call from the kernel's PROCMAP_QUERY ioctl on /proc/<pid>/maps (duct-tape memory.c
+ * mach_vm_region_recurse + Process::memoryRegionInfo/getNextRegion). In a League match one thread asks ~9,000 times a
+ * second, which kept two server threads at 60% each and made every other RPC of the game queue behind it (server
+ * 120% CPU in a fresh match, 2026-10-10). The same ioctl on /proc/self/maps returns the same record without the round
+ * trip; the reply is built exactly as the server builds it. Other tasks and failures of the ioctl still go to the server.
+ * Game process only; host file /tmp/rclol-no-local-region turns it off, /tmp/rclol-local-region-all enables it for
+ * every process (probe tests). Refreshed every 1024 queries for live A/B. */
+struct lregion_query {
+	unsigned long long size, query_flags, query_addr, vma_start, vma_end, vma_flags, vma_page_size, vma_offset, inode;
+	unsigned int dev_major, dev_minor, vma_name_size, build_id_size;
+	unsigned long long vma_name_addr, build_id_addr;
+};
+#define LREGION_IOCTL 0xC0686611ul /* PROCMAP_QUERY = _IOWR('f', 17, struct procmap_query), 104 bytes */
+#define LREGION_SHORT_INFO_COUNT 12 /* VM_REGION_SUBMAP_SHORT_INFO_COUNT_64 */
+struct lregion_short_info {
+	int protection, max_protection;
+	unsigned int inheritance;
+	unsigned long long offset;
+	unsigned int user_tag, ref_count;
+	unsigned short shadow_depth;
+	unsigned char external_pager, share_mode;
+	int is_submap, behavior;
+	unsigned int object_id;
+	unsigned short user_wired_count;
+} __attribute__((packed, aligned(4)));
+static volatile int lregion_state; /* 0 undecided, 1 on, -1 off */
+static unsigned int lregion_calls;
+static volatile int lregion_refresh;
+static volatile int lregion_maps_fd = -1;
+static volatile int lregion_maps_pid;
+_Static_assert(sizeof(struct lregion_query) == 104, "PROCMAP_QUERY ABI");
+_Static_assert(sizeof(struct lregion_short_info) == 48, "short region reply ABI");
+
+extern kern_return_t __darling_rpc_mach_vm_region_recurse(mach_port_name_t target, unsigned long long* address, unsigned long long* size,
+	unsigned int* depth, int* info, unsigned int* infoCnt);
+
+/* Pacing. The one heavy caller is a loop that asks again as soon as it has an answer: through the server it made
+ * ~9,000 calls a second using 17% of a core; answered locally without a pause it made several times more, took 85% of a
+ * core, and fights got slower (61 vs 68 fps, 2026-10-10) although the server load halved. A call that follows the
+ * previous one within the pace interval waits out the rest of it, so the call rate stays what it was through the
+ * server while neither the server nor a core is spent on it. Isolated calls are not delayed. Host file
+ * /tmp/rclol-region-pace-us overrides the interval (0 = no pacing). */
+#define LREGION_DEFAULT_PACE_US 50 /* plus ~50 us of timer slack: ~105 us per call, the rate measured through the server */
+static volatile long lregion_pace_us = LREGION_DEFAULT_PACE_US;
+static volatile unsigned long long lregion_last_ns;
+
+static void lregion_pace(void)
+{
+	long pace = __atomic_load_n(&lregion_pace_us, __ATOMIC_RELAXED);
+	if (pace <= 0)
+		return;
+	struct { long tv_sec; long tv_nsec; } now, rest;
+	LINUX_SYSCALL(__NR_clock_gettime, 1 /* CLOCK_MONOTONIC */, &now);
+	unsigned long long t = now.tv_sec * 1000000000ull + now.tv_nsec;
+	unsigned long long last = __atomic_exchange_n(&lregion_last_ns, t, __ATOMIC_RELAXED);
+	unsigned long long interval = (unsigned long long) pace * 1000ull;
+	if (t >= last && t - last < interval) {
+		rest.tv_sec = 0;
+		rest.tv_nsec = (long) (interval - (t - last));
+		LINUX_SYSCALL(__NR_nanosleep, &rest, 0UL);
+		LINUX_SYSCALL(__NR_clock_gettime, 1, &now);
+		__atomic_store_n(&lregion_last_ns, now.tv_sec * 1000000000ull + now.tv_nsec, __ATOMIC_RELAXED);
+	}
+}
+
+VISIBLE
+kern_return_t mach_vm_region_recurse(mach_port_name_t target, unsigned long long* address, unsigned long long* size,
+	unsigned int* depth, int* info, unsigned int* infoCnt)
+{
+	int state = __atomic_load_n(&lregion_state, __ATOMIC_ACQUIRE);
+	/* The switches are re-read a few times per second only in a process where the feature can be on (same-match A/B).
+	 * Everywhere else the first decision is final and this function makes no further system calls of its own:
+	 * LeagueClient runs the same scanner, and periodic file opens there were the one new behaviour in that process
+	 * when it died twice with an invalid RPC descriptor (2026-10-10). */
+	if (state == 0 || (lregion_refresh && (__atomic_fetch_add(&lregion_calls, 1, __ATOMIC_RELAXED) & 1023) == 0)) {
+		if (state == 0)
+			lregion_refresh = LINUX_SYSCALL(__NR_access, "/tmp/rclol-local-region-all", 0) == 0 || darling_is_league_game();
+		if (LINUX_SYSCALL(__NR_access, "/tmp/rclol-local-region-all", 0) == 0)
+			state = 1;
+		else if (LINUX_SYSCALL(__NR_access, "/tmp/rclol-no-local-region", 0) != 0 && darling_is_league_game())
+			state = 1;
+		else
+			state = -1;
+		__atomic_store_n(&lregion_state, state, __ATOMIC_RELEASE);
+		/* pacing in microseconds (host file, optional): see below */
+		long pfd = LINUX_SYSCALL(__NR_open, "/tmp/rclol-region-pace-us", 0, 0);
+		if (pfd >= 0) {
+			char digits[16];
+			long n = LINUX_SYSCALL(__NR_read, pfd, digits, sizeof(digits) - 1);
+			LINUX_SYSCALL(__NR_close, pfd);
+			long value = 0;
+			for (long i = 0; i < n && digits[i] >= '0' && digits[i] <= '9'; ++i) value = value * 10 + (digits[i] - '0');
