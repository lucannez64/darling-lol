+{
+	if (m->inqueue != 0 || m->prepost != 0)
+		return;
+	struct lmtx** link = &lmtx_buckets[bucket];
+	while (*link && *link != m)
+		link = &(*link)->next;
+	if (*link)
+		*link = m->next;
+	m->addr = 0;
+	lmtx_lock(&lmtx_pool_lock);
+	m->next = lmtx_free;
+	lmtx_free = m;
+	lmtx_unlock(&lmtx_pool_lock);
+}
