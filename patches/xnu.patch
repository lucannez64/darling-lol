@@ -0,0 +1,21 @@
+#ifndef DARLING_CPU_FREQUENCY_H
+#define DARLING_CPU_FREQUENCY_H
+#include <stdint.h>
+#include <stdbool.h>
+
+// Linux cpufreq exposes kHz; Darwin's hw.cpufrequency is an unsigned 64-bit Hz value.
+static inline bool darling_frequency_hz(const char* text, uint64_t* result)
+{
+    uint64_t value = 0;
+    if (!text || !result || *text < '0' || *text > '9') return false;
+    do {
+        unsigned digit = (unsigned)(*text++ - '0');
+        if (value > (UINT64_MAX - digit) / 10) return false;
+        value = value * 10 + digit;
+    } while (*text >= '0' && *text <= '9');
+    while (*text == ' ' || *text == '\t' || *text == '\r' || *text == '\n') ++text;
+    if (*text || !value || value > UINT64_MAX / 1000) return false;
+    *result = value * 1000;
+    return true;
+}
+#endif
