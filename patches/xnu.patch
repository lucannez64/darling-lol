+/* darling-lol: opt-in trace for select() busy loops (a thread whose select keeps returning "ready" without
+ * anything consuming the descriptor). Enabled when the host file /tmp/rclol-select-trace exists at the first select
+ * of a process; output is appended to the host /tmp/rclol-select-trace.log. After 5000 consecutive "ready" returns it
+ * logs which descriptors were ready and marks the first readable one; read/recv/recvmsg/close on that descriptor are
+ * then logged too (descriptor numbers and return values only, never data). */
+int rclol_trace_fd = -1;
+static int rclol_trace_state = -1; /* -1 unknown, 0 off, 1 on */
+static unsigned rclol_trace_lines = 0;
+
+static int rclol_trace_enabled(void)
+{
+	if (rclol_trace_state < 0)
+		rclol_trace_state = LINUX_SYSCALL(__NR_access, "/tmp/rclol-select-trace", 0) == 0;
+	return rclol_trace_state;
+}
+
+static void rclol_trace_write(const char* line)
+{
+	unsigned long length = 0;
+	int fd;
+	if (rclol_trace_lines >= 400)
+		return;
+	++rclol_trace_lines;
+	fd = LINUX_SYSCALL(__NR_open, "/tmp/rclol-select-trace.log", 0x441 /* O_WRONLY | O_CREAT | O_APPEND */, 0644);
+	if (fd < 0)
+		return;
+	while (line[length]) ++length;
+	LINUX_SYSCALL(__NR_write, fd, line, length);
+	LINUX_SYSCALL1(__NR_close, fd);
+}
+
+void rclol_trace_io(const char* op, int fd, long ret)
+{
+	char line[128];
+	if (rclol_trace_state != 1 || fd != rclol_trace_fd || fd < 0)
+		return;
+	__simple_sprintf(line, "io pid=%d tid=%d %s fd=%d ret=%ld\n", (int) LINUX_SYSCALL0(__NR_getpid),
+		(int) LINUX_SYSCALL0(__NR_gettid), op, fd, ret);
+	rclol_trace_write(line);
+}
+
+static void rclol_trace_select(int nfds, const unsigned* rfds, const unsigned* wfds, const unsigned* efds,
+	struct bsd_timeval* timeout, int ret)
+{
+	static unsigned streak = 0;
+	char line[512];
+	int used, fd, listed = 0, first_readable = -1;
+
+	if (ret <= 0) {
+		streak = 0;
+		return;
+	}
+	if (++streak != 5000 && streak % 100000 != 0)
+		return;
+
+	used = __simple_sprintf(line, "select pid=%d tid=%d streak=%u nfds=%d ret=%d timeout=%lds+%dus ready:",
+		(int) LINUX_SYSCALL0(__NR_getpid), (int) LINUX_SYSCALL0(__NR_gettid), streak, nfds, ret,
+		timeout ? (long) timeout->tv_sec : -1L, timeout ? (int) timeout->tv_usec : 0);
+	for (fd = 0; fd < nfds && fd < 1024 && listed < 12; ++fd) {
+		int r = rfds && (rfds[fd / 32] >> (fd % 32) & 1);
+		int w = wfds && (wfds[fd / 32] >> (fd % 32) & 1);
+		int e = efds && (efds[fd / 32] >> (fd % 32) & 1);
+		if (!r && !w && !e)
+			continue;
+		used += __simple_sprintf(line + used, " %d%s%s%s", fd, r ? "r" : "", w ? "w" : "", e ? "e" : "");
+		++listed;
+		if (r && first_readable < 0)
+			first_readable = fd;
+	}
+	line[used++] = '\n';
+	line[used] = 0;
+	rclol_trace_write(line);
+	if (first_readable >= 0)
+		rclol_trace_fd = first_readable;
+}
