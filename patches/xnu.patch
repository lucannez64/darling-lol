+		return;
+	streak = __atomic_load_n(&slot->streak, __ATOMIC_RELAXED);
+	if (streak >= 2000) {
+		struct { long tv_sec; long tv_nsec; } pause = { 0, streak >= 20000 ? 500000 : 100000 };
+		LINUX_SYSCALL(__NR_nanosleep, &pause, 0);
+	}
+}
+
+static void rclol_select_backoff_after(struct bsd_timeval* timeout, int ret)
+{
+	struct rclol_poll_slot* slot;
+	int tid;
+	if (!rclol_backoff_state)
+		return;
+	tid = (int) LINUX_SYSCALL0(__NR_gettid);
+	slot = &rclol_poll_slots[(unsigned) tid & 255];
+	if (timeout != NULL && timeout->tv_sec == 0 && timeout->tv_usec == 0 && ret == 0) {
+		if (__atomic_load_n(&slot->tid, __ATOMIC_RELAXED) != tid) {
