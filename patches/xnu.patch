+#ifndef DARLING_CONVERSION_XATTR_NAME
+#define DARLING_CONVERSION_XATTR_NAME
+
+#include <darling/emulation/conversion/errno.h>
+
+/*
+ * darling-lol: macOS xattr names have no namespace prefix
+ * (e.g. "com.apple.quarantine", "org.chromium.crashpad.database.initialized").
+ * Linux requires the "user." namespace for names an unprivileged process may
+ * set/get, and returns ENOTSUP (95) otherwise. Darwin's own xattr layer is
+ * namespace-less, so translate on the way in/out.
+ *
+ * Rules:
+ *  - "" (Darwin: list/remove all) is passed through unchanged.
+ *  - names already carrying a Linux namespace ("user.", "trusted.",
+ *    "system.", "security.") are passed through (avoid double-prefixing).
+ *  - everything else gets "user." prepended.
+ *
+ * OUT must have room for 5 extra bytes + NUL. Returns `name` or `out`.
+ */
+static inline const char* xattr_name_to_linux(const char* name, char* out, unsigned long outsz)
+{
+	unsigned long i = 0;
+
+	if (name == 0 || name[0] == '\0')
+		return name;
+
+	if (__builtin_strncmp(name, "user.", 5) == 0 ||
+	    __builtin_strncmp(name, "trusted.", 8) == 0 ||
+	    __builtin_strncmp(name, "system.", 7) == 0 ||
+	    __builtin_strncmp(name, "security.", 9) == 0)
+		return name;
+
+	if (out == 0 || outsz < 6)
+		return name;
+
+	out[0] = 'u'; out[1] = 's'; out[2] = 'e'; out[3] = 'r'; out[4] = '.';
+	for (i = 0; name[i] != '\0' && i + 5 < outsz - 1; i++)
+		out[i + 5] = name[i];
+	out[i + 5] = '\0';
+	return out;
+}
+
+/*
+ * Reverse: strip a leading "user." when returning names to Darwin callers
+ * (listxattr). Mutates `name` in place (the buffer is caller-owned and the
+ * caller only needs a valid NUL-terminated name at the same address).
+ * Returns the (possibly advanced) pointer for convenience.
+ */
+static inline char* xattr_name_from_linux(char* name)
+{
+	if (name != 0 && __builtin_strncmp(name, "user.", 5) == 0)
+		return name + 5;
+	return name;
+}
+
+/*
+ * Linux reports a missing attribute as ENODATA; Darwin reports ENOATTR (93),
+ * which callers test for to tell "no such attribute" from a real failure.
+ * LINUX_ERRNO is the negative value returned by the Linux xattr syscall.
+ */
+static inline long xattr_errno_to_bsd(long linux_errno)
+{
+	if (linux_errno == -61 /* LINUX_ENODATA */)
+		return -93 /* ENOATTR */;
+	return errno_linux_to_bsd(linux_errno);
+}
+
+#endif /* DARLING_CONVERSION_XATTR_NAME */
