@@ -0,0 +1,72 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/misc/mac_syscall.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/common/simple.h>
+#include <darling/emulation/conversion/duct_errno.h>
+
+#include <darlingserver/rpc.h>
+
+extern int memcmp(const void* s1, const void* s2, __SIZE_TYPE__ n);
+extern __SIZE_TYPE__ strlen(const char* s);
+
+struct amfi_cdhash_args {
+	unsigned char cdhash[20];
+	uint64_t result;
+};
+
+long sys___mac_syscall(const char* policy, int call, void* arg)
+{
+	char name[32];
+	__SIZE_TYPE__ i;
+
+	/* darling-lol: syscall 381 was unmapped (ENOSYS), and Chromium's
+	 * seatbelt client CHECKs it, killing every helper/GPU process with a
+	 * silent UD2. There is no MAC framework to back this; for the
+	 * "Seatbelt" policy we fail soft with success (consistent with the
+	 * sandbox_init stubs that report success without enforcement).
+	 * Anything else keeps ENOSYS. Guest memory is directly readable here;
+	 * bound the copy. */
+
+	if (policy == NULL) {
+		return -EINVAL;
+	}
+
+	for (i = 0; i < sizeof(name) - 1; i++) {
+		char c = policy[i];
+		name[i] = c;
+		if (c == '\0') {
+			break;
+		}
+	}
+	name[sizeof(name) - 1] = '\0';
+
+	if (memcmp(name, "Seatbelt", 9) == 0) {
+		__simple_printf("mac_syscall: Seatbelt call %d (arg=%p), no enforcement, succeeding\n",
+			call, arg);
+		return 0;
+	}
+
+	if (memcmp(name, "AMFI", 5) == 0) {
+		if (call == 95) {
+			/* AMFI_SYSCALL_CDHASH_IN_TRUSTCACHE */
+			struct amfi_cdhash_args* args = (struct amfi_cdhash_args*) arg;
+			int32_t present = 0;
+			int ret;
+			if (args == NULL)
+				return -EINVAL;
+			ret = dserver_rpc_trustcache_contains(args->cdhash, &present);
+			if (ret > 0)
+				return -ret;
+			if (ret < 0)
+				return ret;
+			args->result = present ? 1 : 0;
+			return 0;
+		}
+		/* Unknown AMFI calls must fail closed rather than fabricating
+		 * success. Callers that need a specific query must implement it. */
+		return -ENOTSUP;
+	}
+
+	__simple_printf("mac_syscall: unsupported policy \"%s\" call %d\n", name, call);
+	return -ENOSYS;
+}
