+		*size = value;
+
+		__simple_sprintf(path, HOST_CACHE_DIR "index%d/shared_cpu_list", index);
+		*sharing = read_string(path, buf, sizeof(buf)) ? darling_cpu_count_list(buf) : 1;
+		if (*sharing == 0)
+			*sharing = 1;
+		return true;
+	}
