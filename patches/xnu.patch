diff --git a/darling/src/libsystem_kernel/emulation/include/common/dc_mseal.h b/darling/src/libsystem_kernel/emulation/include/common/dc_mseal.h
new file mode 100644
index 0000000..fb3f73c
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/common/dc_mseal.h
@@ -0,0 +1,37 @@
+/* Replace a read-only file mapping with an anonymous snapshot before sealing.
+ * mseal alone does not stop writes to the original inode. Anonymous backing also
+ * prevents madvise from discarding COW pages and re-reading a modified file.
+ * Callbacks return negative errno on failure; addresses use the native long ABI.
+ */
+#ifndef DC_MSEAL_H
+#define DC_MSEAL_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+struct dc_seal_ops {
+    long (*allocate)(unsigned long);
+    long (*protect)(void*, unsigned long, int);
+    long (*relocate)(void*, unsigned long, void*);
+    void (*release)(void*, unsigned long);
+    long (*seal)(void*, unsigned long);
+};
+static inline int dc_vm_error(long value) {
+    return (unsigned long)value >= (unsigned long)-4095;
+}
+static inline long dc_snapshot_and_seal(void* address, unsigned long length, int prot,
+                                       const struct dc_seal_ops* ops) {
+    const unsigned long page = 4096; /* Darling's x86 guest page size. */
+    if (!length || ((uintptr_t)address & (page - 1)) ||
+        length > ~(unsigned long)0 - (page - 1) || !(prot & 1) || (prot & 2)) return -22;
+    length = (length + page - 1) & ~(page - 1);
+    long allocated = ops->allocate(length);
+    if (dc_vm_error(allocated)) return allocated;
+    void* snapshot = (void*)(uintptr_t)allocated;
+    memcpy(snapshot, address, length);
+    long result = ops->protect(snapshot, length, prot);
+    if (result < 0) { ops->release(snapshot, length); return result; }
+    result = ops->relocate(snapshot, length, address);
+    if (dc_vm_error(result)) { ops->release(snapshot, length); return result; }
+    return ops->seal(address, length);
+}
+#endif
diff --git a/darling/src/libsystem_kernel/emulation/include/common/dc_image_snapshot.h b/darling/src/libsystem_kernel/emulation/include/common/dc_image_snapshot.h
new file mode 100644
index 0000000..04d64c1
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/common/dc_image_snapshot.h
@@ -0,0 +1,48 @@
+/* Immutable file snapshots bind verification and mapping to the same bytes.
+ * Callbacks normalize errors to negative errno and never change the source offset.
+ */
+#ifndef DC_IMAGE_SNAPSHOT_H
+#define DC_IMAGE_SNAPSHOT_H
+#include <stddef.h>
+enum { DC_F_SNAPSHOT_IMAGE = 0x40004443 };
+struct dc_image_ops {
+    long (*size)(int);
+    long (*create)(void);
+    long (*read)(int, void*, unsigned long, unsigned long);
+    long (*write)(int, const void*, unsigned long);
+    long (*seal)(int);
+    void (*close)(int);
+};
+static inline long dc_snapshot_image(int source, const struct dc_image_ops* ops) {
+    long length = ops->size(source);
+    if (length < 0) return length;
+    if (!length) return -22;
+    if ((unsigned long)length > 2UL * 1024 * 1024 * 1024) return -27;
+    long target = ops->create();
+    if (target < 0) return target;
+    unsigned long offset = 0;
+    long error = -5;
+    char buffer[16384];
+    while (offset < (unsigned long)length) {
+        unsigned long amount = (unsigned long)length - offset;
+        if (amount > sizeof(buffer)) amount = sizeof(buffer);
+        long got = ops->read(source, buffer, amount, offset);
+        if (got == -4) continue;
+        if (got <= 0) { error = got < 0 ? got : -5; goto fail; }
+        unsigned long written = 0;
+        while (written < (unsigned long)got) {
+            long put = ops->write((int)target, buffer + written, (unsigned long)got - written);
+            if (put == -4) continue;
+            if (put <= 0) { error = put < 0 ? put : -5; goto fail; }
+            written += (unsigned long)put;
+        }
+        offset += (unsigned long)got;
+    }
+    error = ops->seal((int)target);
+    if (error < 0) goto fail;
+    return target;
+fail:
+    ops->close((int)target);
+    return error;
+}
+#endif
