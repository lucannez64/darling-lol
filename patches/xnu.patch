+	 * the thread entry clears the inherited cookie again. gettid() == getpid() is that initial thread. If
+	 * registration ever ran on another thread, leave everything untagged rather than tag the wrong thread. */
+	if (LINUX_SYSCALL(__NR_gettid) != LINUX_SYSCALL(__NR_getpid)) {
+		lcore_log(0, -2, 0);
+		return;
+	}
+	err = LINUX_SYSCALL5(__NR_prctl, LCORE_PRCTL_SCHED_CORE, LCORE_CREATE, 0, LCORE_SCOPE_THREAD, 0);
+	if (err == 0) {
+		long got = LINUX_SYSCALL5(__NR_prctl, LCORE_PRCTL_SCHED_CORE, LCORE_GET, 0, LCORE_SCOPE_THREAD, &cookie);
+		if (got != 0)
