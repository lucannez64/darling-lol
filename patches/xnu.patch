+__attribute__((visibility("hidden")))
+uint32_t __darling_local_mutexwait(void* mutex, uint32_t mgen, uint32_t ugen, uint32_t flags)
+{
+	const unsigned long addr = (unsigned long) mutex;
+	const unsigned int bucket = lmtx_bucket(addr);
+	const uint32_t lseq = mgen & LMTX_COUNT_MASK;
+	(void) ugen; (void) flags;
+	lmtx_lock(&lmtx_locks[bucket]);
+	struct lmtx* m = lmtx_find(bucket, addr, 1);
+	if (m->prepost) {
+		/* an unlock already arrived for a contender: take it */
+		m->prepost--;
+		uint32_t updatebits = (m->inqueue == 0 ? lseq : (m->highseq & LMTX_COUNT_MASK)) | (LMTX_KBIT | LMTX_EBIT);
+		updatebits &= ~LMTX_MTX_WAIT;
+		lmtx_release_if_unused(bucket, m);
+		lmtx_unlock(&lmtx_locks[bucket]);
+		return updatebits;
+	}
+	struct lmtx_waiter self;
+	self.next = 0;
+	self.lockseq = lseq;
+	self.retval = 0;
+	self.woken = 0;
+	/* ksyn_queue_insert, FIRSTFIT: arrival order */
+	if (m->inqueue == 0) {
+		m->head = m->tail = &self;
+		m->firstnum = m->lastnum = lseq;
+	} else {
+		m->tail->next = &self;
+		m->tail = &self;
+		if (lmtx_seq_lower(lseq, m->firstnum)) m->firstnum = lseq;
+		if (lmtx_seq_higher(lseq, m->lastnum)) m->lastnum = lseq;
+	}
+	if (++m->inqueue == 1) {
+		m->lowseq = m->highseq = lseq;
+	} else {
+		if (lmtx_seq_lower(lseq, m->lowseq)) m->lowseq = lseq;
+		if (lmtx_seq_higher(lseq, m->highseq)) m->highseq = lseq;
+	}
+	lmtx_unlock(&lmtx_locks[bucket]);
+	while (!__atomic_load_n(&self.woken, __ATOMIC_ACQUIRE))
+		LINUX_SYSCALL(__NR_futex, &self.woken, 0 /* FUTEX_WAIT */, 0, 0UL, 0UL, 0);
+	return self.retval & ~LMTX_MTX_WAIT;
+}
 
