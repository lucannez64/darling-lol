+	lim.rlim_max = rlimit_is_infinity(rlp->rlim_max) ? LINUX_RLIM_INFINITY : rlp->rlim_max;
+
 	if (which == LINUX_RLIMIT_NOFILE)
 	{
-		lim.rlim_cur++;
-		lim.rlim_max++;
