+/* Read once per process: the answer cannot change, and other processes must not keep opening files for it. */
+static int darling_is_league_game(void)
+{
+	static volatile int cached; /* 0 unknown, 1 yes, -1 no */
+	int value = __atomic_load_n(&cached, __ATOMIC_ACQUIRE);
+	if (value == 0) {
+		value = darling_is_league_game_uncached() ? 1 : -1;
+		__atomic_store_n(&cached, value, __ATOMIC_RELEASE);
+	}
+	return value == 1;
+}
+
+static int darling_is_league_game_uncached(void)
+{
+	/* Only the executable path (argv[0], the first NUL-terminated string) counts. The whole command line was searched
+	 * before, so any process that merely had the game's path among its arguments would have been treated as the game. */
+	char buf[512];
+	static const char mark[] = "/Game/LeagueOfLegends.app/Contents/MacOS/";
+	int found = 0;
+	long n = 0;
+	int fd = LINUX_SYSCALL(__NR_open, "/proc/self/cmdline", 0 /* O_RDONLY */, 0);
+	if (fd >= 0) {
+		n = LINUX_SYSCALL(__NR_read, fd, buf, sizeof(buf) - 1);
+		LINUX_SYSCALL(__NR_close, fd);
+		if (n < 0) n = 0;
+		buf[n] = 0;
+		long end = 0;
+		while (end < n && buf[end]) ++end; /* argv[0] */
+		for (long i = 0; i + (long) sizeof(mark) - 1 <= end && !found; ++i) {
+			unsigned long j = 0;
+			while (j < sizeof(mark) - 1 && buf[i + j] == mark[j]) ++j;
+			if (j == sizeof(mark) - 1) found = 1;
+		}
+		/* one line per process in the host file /tmp/rclol-game-decisions.log: which processes asked, and the answer */
+		long log = LINUX_SYSCALL(__NR_open, "/tmp/rclol-game-decisions.log", 02101 /* O_WRONLY|O_CREAT|O_APPEND */, 0666);
+		if (log >= 0) {
+			char line[160];
+			long tail = end > 60 ? end - 60 : 0;
+			int len = __simple_sprintf(line, "pid=%d game=%d argv0=...%s\n", (int) LINUX_SYSCALL(__NR_getpid), found, buf + tail);
+			LINUX_SYSCALL(__NR_write, log, line, len);
+			LINUX_SYSCALL(__NR_close, log);
+		}
+	}
+	return found;
+}
