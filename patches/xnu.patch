+	/* once per process: a forked child keeps (inherits) whatever the parent's initial thread had */
+	if (!__atomic_compare_exchange_n(&lcore_main, &expected, -1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+		return;
