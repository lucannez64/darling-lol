+__attribute__((visibility("hidden")))
+uint32_t __darling_local_mutexdrop(void* mutex, uint32_t mgen, uint32_t ugen, uint32_t flags)
+{
+	const unsigned long addr = (unsigned long) mutex;
+	const unsigned int bucket = lmtx_bucket(addr);
+	(void) mgen; (void) ugen; (void) flags;
+	lmtx_lock(&lmtx_locks[bucket]);
+	struct lmtx* m = lmtx_find(bucket, addr, 1);
+	if (m->inqueue == 0) {
+		/* nobody is queued yet: the contender that made the unlocker come here is still on its way */
+		m->prepost++;
+		lmtx_unlock(&lmtx_locks[bucket]);
+		return 0;
+	}
+	const uint32_t updatebits = (m->highseq & LMTX_COUNT_MASK) | (LMTX_EBIT | LMTX_KBIT);
+	struct lmtx_waiter* w = m->head;
+	m->head = w->next;
+	if (!m->head)
+		m->tail = 0;
+	if (--m->inqueue > 0) {
+		/* ksyn_queue_remove_item: first/last sequence from the queue ends, then low/high */
+		m->firstnum = m->head->lockseq;
+		m->lastnum = m->tail->lockseq;
+		if (m->lowseq == w->lockseq) m->lowseq = m->firstnum;
+		if (m->highseq == w->lockseq) m->highseq = m->lastnum;
+	} else {
+		m->firstnum = m->lastnum = m->lowseq = m->highseq = 0;
+	}
+	w->retval = updatebits;
+	volatile int* wake = &w->woken;
+	lmtx_release_if_unused(bucket, m);
+	__atomic_store_n(wake, 1, __ATOMIC_RELEASE);   /* the waiter's stack frame may be gone right after this */
+	lmtx_unlock(&lmtx_locks[bucket]);
+	LINUX_SYSCALL(__NR_futex, wake, 1 /* FUTEX_WAKE */, 1, 0UL, 0UL, 0);
+	return 0;
+}
