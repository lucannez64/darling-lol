+/* Nanosecond variant used by libpthread's private condition variables. The
+ * sequence check and sleep are atomic in FUTEX_WAIT; a signal between the
+ * userspace unlock and this call therefore cannot be lost. */
+long sys_ulock_wait2(uint32_t operation, void* addr, uint64_t value,
+                     uint64_t timeout, uint64_t value2)
+{
+    const uint32_t allowed = XNU_UL_OPCODE_MASK | XNU_ULF_NO_ERRNO |
+        0x00010000u /* WORKQ_DATA_CONTENTION */ | 0x00020000u /* CANCEL_POINT */ |
+        0x00040000u /* ADAPTIVE_SPIN */;
+    int op = operation & XNU_UL_OPCODE_MASK;
+    int ret;
+    if ((operation & ~allowed) || value2 ||
+        (op != XNU_UL_COMPARE_AND_WAIT && op != XNU_UL_UNFAIR_LOCK) ||
+        ((uintptr_t)addr & 3)) {
+        ret = -EINVAL;
+    } else {
+        int cancellation = (operation & 0x00020000u) ? sys_pthread_canceled(0) : -EINVAL;
+        if (cancellation == 0) {
+            ret = -EINTR;
+        } else {
+            /* Darling's server does not implement markcancel/canceled yet.
+             * Bound cancelable sleeps in that case so libpthread can observe
+             * its pending cancellation bit. EINTR is a permitted spurious
+             * condition wake, not a premature timed-wait timeout. */
+            bool cancellation_poll = cancellation == -ENOSYS &&
+                (!timeout || timeout > 50000000ull);
+            uint64_t sleep_ns = cancellation_poll ? 50000000ull : timeout;
+            struct timespec ts = { sleep_ns / 1000000000ull, sleep_ns % 1000000000ull };
+            ret = LINUX_SYSCALL(__NR_futex, addr, FUTEX_WAIT | FUTEX_PRIVATE_FLAG,
+                (uint32_t)value, sleep_ns ? &ts : NULL, 0UL, 0);
+            if (ret == -LINUX_ETIMEDOUT && cancellation_poll) ret = -LINUX_EINTR;
+            if (ret == 0 || ret == -LINUX_EAGAIN) ret = 1;
+            else if (ret < 0) ret = errno_linux_to_bsd(ret);
+        }
+    }
+    if (ret < 0 && (operation & XNU_ULF_NO_ERRNO)) ret &= ~0x800;
+    return ret;
+}
