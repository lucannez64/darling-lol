@@ -2724,6 +2730,22 @@ void ImageLoaderMachO::mapSegments(int fd, uint64_t offsetInFat, uint64_t lenInF
 
 	// update slide to reflect load location			
 	this->setSlide(slide);
+
+#ifdef DARLING
+	/* M5: seal signed read-only ranges in this image. The helper lives in
+	 * libsystem_kernel and uses Linux mseal(2) when available. */
+	const char* sealPolicy = _simple_getenv(context.envp, "DARLING_MSEAL");
+	bool sealEnabled = sealPolicy != NULL &&
+	    (strcmp(sealPolicy, "1") == 0 || strcmp(sealPolicy, "on") == 0 ||
+	     strcmp(sealPolicy, "true") == 0 || strcmp(sealPolicy, "yes") == 0);
+	for (unsigned int i = 0, e = segmentCount(); sealEnabled && i < e; ++i) {
+		if (segWriteable(i))
+			continue;
+		if (strcmp(segName(i), "__TEXT") != 0 && strcmp(segName(i), "__LINKEDIT") != 0)
+			continue;
+		__darling_mseal_range((void*)segActualLoadAddress(i), segSize(i));
+	}
+#endif
 }
 
