+				/* Darling keeps path/root variables because its runtime
+				 * overlays depend on them, but a hardened process must not
+				 * accept code injection through the environment. */
+				if ( sDarlingStripDyldEnv && strcmp(key, "DYLD_INSERT_LIBRARIES") == 0 )
+					continue;
