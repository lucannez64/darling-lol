+#ifdef DARLING
+// Own only the clone: the caller keeps its original fd and path metadata.
+class DarlingImageSnapshot {
+    int _fd;
+public:
+    explicit DarlingImageSnapshot(int source) : _fd(-1) {
+        const char* policy = _simple_getenv(gLinkContext.envp, "DARLING_CODESIGN_ENFORCE");
+        const char* seal = _simple_getenv(gLinkContext.envp, "DARLING_MSEAL");
+        bool requested = (policy && strcmp(policy, "enforce") == 0) || (seal &&
+            (!strcmp(seal, "1") || !strcmp(seal, "on") || !strcmp(seal, "true") || !strcmp(seal, "yes")));
+        if (requested) {
+            _fd = fcntl(source, DC_F_SNAPSHOT_IMAGE, 0);
+            if (_fd < 0) throwf("cannot snapshot image: %d", errno);
+        }
+    }
+    ~DarlingImageSnapshot() { if (_fd >= 0) close(_fd); }
+    int descriptor(int original) const { return _fd >= 0 ? _fd : original; }
+};
+#endif
