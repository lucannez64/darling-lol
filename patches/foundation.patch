+static Boolean value_contains(CFTypeRef value, CFStringRef word)
+{
+  CFTypeID type = CFGetTypeID(value);
+
+  if (type == CFStringGetTypeID())
+    return CFStringFind(value, word, kCFCompareCaseInsensitive).location != kCFNotFound;
+  if (type == CFArrayGetTypeID())
+    {
+      CFIndex k, n = CFArrayGetCount(value);
+
+      for (k = 0; k < n; k++)
+        if (value_contains(CFArrayGetValueAtIndex(value, k), word))
+          return true;
+    }
+  else if (type == CFDictionaryGetTypeID())
+    {
+      CFIndex k, n = CFDictionaryGetCount(value);
+      const void **keys = calloc(n + 1, sizeof(void *));
+      const void **values = calloc(n + 1, sizeof(void *));
+      Boolean found = false;
+
+      CFDictionaryGetKeysAndValues(value, keys, values);
+      for (k = 0; k < n && !found; k++)
+        found = value_contains(keys[k], word) || value_contains(values[k], word);
+      free(keys);
+      free(values);
+      return found;
+    }
+  return false;
+}
+
+static int find_in_domain(CFStringRef app, CFStringRef label, CFStringRef word)
+{
+  struct domain d = { app, NULL };
+  CFDictionaryRef dict = copy_domain(&d);
+  CFMutableDictionaryRef found = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                           &kCFTypeDictionaryValueCallBacks);
+  Boolean whole = CFStringFind(label, word, kCFCompareCaseInsensitive).location != kCFNotFound;
+  CFIndex k, n = CFDictionaryGetCount(dict);
+  const void **keys = calloc(n + 1, sizeof(void *));
+  const void **values = calloc(n + 1, sizeof(void *));
+  char *name;
+
+  CFDictionaryGetKeysAndValues(dict, keys, values);
+  for (k = 0; k < n; k++)
+    if (whole || value_contains(keys[k], word) || value_contains(values[k], word))
+      CFDictionarySetValue(found, keys[k], values[k]);
+  free(keys);
+  free(values);
+  if (CFDictionaryGetCount(found) == 0)
+    return 0;
+  name = c_string(label);
+  printf("Found %ld keys in domain '%s': ", (long)CFDictionaryGetCount(found), name);
+  free(name);
+  print_value(found);
+  return 1;
+}
+
+static int cmd_find(int argc, char **argv, int i)
+{
+  CFStringRef word;
+  CFArrayRef names;
+  CFIndex k;
+  int hits = 0;
+
+  if (i >= argc)
+    return usage();
+  word = cf_string(argv[i]);
+  hits += find_in_domain(kCFPreferencesAnyApplication, CFSTR("Apple Global Domain"), word);
+  names = copy_domain_names();
+  for (k = 0; k < CFArrayGetCount(names); k++)
+    {
+      CFStringRef name = CFArrayGetValueAtIndex(names, k);
+
+      hits += find_in_domain(name, name, word);
+    }
+  if (hits == 0)
+    log_message("No domain, key, nor value containing '%s'", argv[i]);
+  return 0;
+}
