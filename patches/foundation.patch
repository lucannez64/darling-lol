+++ b/src/NSConstantIntegerNumber.m
@@ -0,0 +1,203 @@
+//
+//  NSConstantIntegerNumber.m
+//  Foundation
+//
+//  Compatibility classes for the constant number objects emitted by newer
+//  Clang versions for Objective-C numeric literals. The object layouts match
+//  clang/lib/CodeGen/CGObjCMac.cpp.
+//
+
+#import <Foundation/NSNumber.h>
+
+struct dc_constant_integer_number {
+	void *isa;
+	const char *encoding;
+	long long value;
+};
+
+struct dc_constant_float_number {
+	void *isa;
+	float value;
+};
+
+struct dc_constant_double_number {
+	void *isa;
+	double value;
+};
+
+@interface NSConstantIntegerNumber : NSNumber
+@end
+@interface NSConstantFloatNumber : NSNumber
+@end
+@interface NSConstantDoubleNumber : NSNumber
+@end
+
+@implementation NSConstantIntegerNumber
+
+- (const char *)objCType
+{
+	return ((struct dc_constant_integer_number *) self)->encoding;
+}
+
+- (long long)longLongValue
+{
+	return ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (unsigned long long)unsignedLongLongValue
+{
+	return (unsigned long long) ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (NSInteger)integerValue
+{
+	return (NSInteger) ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (NSUInteger)unsignedIntegerValue
+{
+	return (NSUInteger) ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (int)intValue
+{
+	return (int) ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (unsigned int)unsignedIntValue
+{
+	return (unsigned int) ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (double)doubleValue
+{
+	return (double) ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (float)floatValue
+{
+	return (float) ((struct dc_constant_integer_number *) self)->value;
+}
+
+- (BOOL)boolValue
+{
+	return ((struct dc_constant_integer_number *) self)->value != 0;
+}
+
+- (NSString *)description
+{
+	return [NSString stringWithFormat:@"%lld",
+	    ((struct dc_constant_integer_number *) self)->value];
+}
+
+- (NSString *)stringValue
+{
+	return [self description];
+}
+
+- (void)getValue:(void *)value
+{
+	*(long long *) value = ((struct dc_constant_integer_number *) self)->value;
+}
+
+@end
+
+@implementation NSConstantFloatNumber
+
+- (const char *)objCType
+{
+	return "f";
+}
+
+- (float)floatValue
+{
+	return ((struct dc_constant_float_number *) self)->value;
+}
+
+- (double)doubleValue
+{
+	return (double) ((struct dc_constant_float_number *) self)->value;
+}
+
+- (long long)longLongValue
+{
+	return (long long) ((struct dc_constant_float_number *) self)->value;
+}
+
+- (NSInteger)integerValue
+{
+	return (NSInteger) ((struct dc_constant_float_number *) self)->value;
+}
+
+- (BOOL)boolValue
+{
+	return ((struct dc_constant_float_number *) self)->value != 0;
+}
+
+- (NSString *)description
+{
+	return [NSString stringWithFormat:@"%g",
+	    (double) ((struct dc_constant_float_number *) self)->value];
+}
+
+- (NSString *)stringValue
+{
+	return [self description];
+}
+
+- (void)getValue:(void *)value
+{
+	*(float *) value = ((struct dc_constant_float_number *) self)->value;
+}
+
+@end
+
+@implementation NSConstantDoubleNumber
+
+- (const char *)objCType
+{
+	return "d";
+}
+
+- (double)doubleValue
+{
+	return ((struct dc_constant_double_number *) self)->value;
+}
+
+- (float)floatValue
+{
+	return (float) ((struct dc_constant_double_number *) self)->value;
+}
+
+- (long long)longLongValue
+{
+	return (long long) ((struct dc_constant_double_number *) self)->value;
+}
+
+- (NSInteger)integerValue
+{
+	return (NSInteger) ((struct dc_constant_double_number *) self)->value;
+}
+
+- (BOOL)boolValue
+{
+	return ((struct dc_constant_double_number *) self)->value != 0;
+}
+
+- (NSString *)description
+{
+	return [NSString stringWithFormat:@"%g",
+	    ((struct dc_constant_double_number *) self)->value];
+}
+
+- (NSString *)stringValue
+{
+	return [self description];
+}
+
+- (void)getValue:(void *)value
+{
+	*(double *) value = ((struct dc_constant_double_number *) self)->value;
+}
+
+@end
