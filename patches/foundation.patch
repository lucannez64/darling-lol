+      double v = strtod(arg, &end);
+
+      if (end == arg || *end != '\0')
+        {
+          log_message("\nCannot parse '%s' as a float", arg);
+          return NULL;
+        }
+      return CFNumberCreate(NULL, kCFNumberDoubleType, &v);
+    }
+  if (!strcmp(flag, "-bool") || !strcmp(flag, "-boolean"))
+    {
+      int v = parse_bool_word(arg);
+
+      if (v < 0)
+        {
+          usage();
+          return NULL;
+        }
+      return CFRetain(v ? kCFBooleanTrue : kCFBooleanFalse);
+    }
+  if (!strcmp(flag, "-data"))
+    {
+      long n = parse_hex_bytes(arg, NULL);
+      unsigned char *bytes;
+      CFDataRef data;
+
+      if (n < 0)
+        {
+          log_message("\nCannot parse '%s' as hexadecimal data", arg);
+          return NULL;
+        }
+      bytes = malloc(n + 1);
+      parse_hex_bytes(arg, bytes);
+      data = CFDataCreate(NULL, bytes, n);
+      free(bytes);
+      return data;
+    }
+  if (!strcmp(flag, "-date"))
+    {
+      CFDateRef date = parse_date(arg);
+
+      if (date == NULL)
+        log_message("\nCannot parse '%s' as a date", arg);
+      return date;
+    }
+  return NULL;
+}
