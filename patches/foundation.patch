+static int cmd_write(int argc, char **argv, int i)
+{
+  struct domain d;
+  CFStringRef key;
+  CFTypeRef value = NULL;
+  const char *keyname;
+  int rc;
+
+  if (i >= argc)
+    return usage();
+  if ((rc = resolve_domain(argc, argv, &i, &d)) != 0)
+    return rc;
+  if (i >= argc)
+    return usage();
+  if (i + 1 == argc)
+    {
+      CFTypeRef rep = parse_value_rep(argv[i]);
+
+      if (CFGetTypeID(rep) != CFDictionaryGetTypeID())
+        {
+          log_message("\nRep argument is not a dictionary\nDefaults have not been changed.");
+          return 1;
+        }
+      return replace_domain(&d, rep);
+    }
+  keyname = argv[i++];
+  key = cf_string(keyname);
+  if (!strcmp(argv[i], "-array") || !strcmp(argv[i], "-array-add"))
+    {
+      CFMutableArrayRef array = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+
+      if (!strcmp(argv[i], "-array-add"))
+        {
+          CFTypeRef old = CFPreferencesCopyValue(key, d.app, user_name, host_name);
+
+          if (old && CFGetTypeID(old) != CFArrayGetTypeID())
+            {
+              log_message("Value for key %s is not an array; cannot append.  Leaving defaults unchanged.",
+                          keyname);
+              return 1;
+            }
+          if (old)
+            CFArrayAppendArray(array, old, CFRangeMake(0, CFArrayGetCount(old)));
+        }
+      for (i++; i < argc;)
+        {
+          CFTypeRef item = parse_scalar(argc, argv, &i);
+
+          if (item == NULL)
+            return 1;
+          CFArrayAppendValue(array, item);
+          CFRelease(item);
+        }
+      value = array;
+    }
+  else if (!strcmp(argv[i], "-dict") || !strcmp(argv[i], "-dict-add"))
+    {
+      CFMutableDictionaryRef dict = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                              &kCFTypeDictionaryValueCallBacks);
+
+      if (!strcmp(argv[i], "-dict-add"))
+        {
+          CFTypeRef old = CFPreferencesCopyValue(key, d.app, user_name, host_name);
+
+          if (old && CFGetTypeID(old) != CFDictionaryGetTypeID())
+            {
+              log_message("Value for key %s is not a dictionary; cannot append.  Leaving defaults unchanged.",
+                          keyname);
+              return 1;
+            }
+          if (old)
+            {
+              CFIndex k, n = CFDictionaryGetCount(old);
+              const void **ks = calloc(n + 1, sizeof(void *));
+              const void **vs = calloc(n + 1, sizeof(void *));
+
+              CFDictionaryGetKeysAndValues(old, ks, vs);
+              for (k = 0; k < n; k++)
+                CFDictionarySetValue(dict, ks[k], vs[k]);
+              free(ks);
+              free(vs);
+            }
+        }
+      for (i++; i < argc;)
+        {
+          CFStringRef k;
+          CFTypeRef item;
+
+          if (i + 1 >= argc)
+            {
+              log_message("Key %s lacks a corresponding value", argv[i]);
+              return 1;
+            }
+          k = cf_string(argv[i++]);
+          item = parse_scalar(argc, argv, &i);
+          if (item == NULL)
+            return 1;
+          CFDictionarySetValue(dict, k, item);
+          CFRelease(item);
+          CFRelease(k);
+        }
+      value = dict;
+    }
+  else
+    {
+      value = parse_scalar(argc, argv, &i);
+      if (value == NULL)
+        return 1;
+    }
+  CFPreferencesSetValue(key, value, d.app, user_name, host_name);
+  return synchronize(&d);
+}
+
+static int cmd_delete(int argc, char **argv, int i)
+{
+  struct domain d;
+  int rc;
+
+  if (i >= argc)
+    return usage();
+  if ((rc = resolve_domain(argc, argv, &i, &d)) != 0)
+    return rc;
+  if (i >= argc)
+    {
+      CFDictionaryRef dict = copy_domain(&d);
+      CFIndex n = CFDictionaryGetCount(dict);
+      const void **keys;
+      CFArrayRef removed;
+
+      if (n == 0)
+        {
+          log_message("\nDomain (%s) not found.\nDefaults have not been changed.", d.display);
+          return 1;
+        }
+      keys = calloc(n, sizeof(void *));
+      CFDictionaryGetKeysAndValues(dict, keys, NULL);
+      removed = CFArrayCreate(NULL, keys, n, &kCFTypeArrayCallBacks);
+      free(keys);
+      CFPreferencesSetMultiple(NULL, removed, d.app, user_name, host_name);
+      return synchronize(&d);
+    }
+  else
+    {
+      CFStringRef key = cf_string(argv[i]);
+      CFTypeRef value = CFPreferencesCopyValue(key, d.app, user_name, host_name);
+
+      if (value == NULL)
+        {
+          report_missing_pair(&d, argv[i]);
+          return 1;
+        }
+      CFPreferencesSetValue(key, NULL, d.app, user_name, host_name);
+      return synchronize(&d);
+    }
+}
