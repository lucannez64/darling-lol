+/* Replace the whole domain with dict. */
+static int replace_domain(const struct domain *d, CFDictionaryRef dict)
+{
+  CFDictionaryRef old = copy_domain(d);
+  CFMutableArrayRef removed = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+  CFIndex k, n = CFDictionaryGetCount(old);
+  const void **keys = calloc(n + 1, sizeof(void *));
+
+  CFDictionaryGetKeysAndValues(old, keys, NULL);
+  for (k = 0; k < n; k++)
+    if (!CFDictionaryContainsKey(dict, keys[k]))
+      CFArrayAppendValue(removed, keys[k]);
+  free(keys);
+  CFPreferencesSetMultiple(dict, removed, d->app, user_name, host_name);
+  return synchronize(d);
+}
