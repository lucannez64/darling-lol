+      if (rest == NULL)
+        continue;
+      while (*rest == ' ')
+        rest++;
+      if (*rest == 'Z')
+        rest++;
+      else if ((*rest == '+' || *rest == '-') && isdigit((unsigned char)rest[1]))
+        {
+          int sign = *rest == '-' ? -1 : 1;
+          int digits = 0, value = 0;
+
+          for (rest++; isdigit((unsigned char)*rest) || *rest == ':'; rest++)
+            if (*rest != ':')
