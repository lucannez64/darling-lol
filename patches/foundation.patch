+    return rc;
+  if (i >= argc)
+    return usage();
+  dict = copy_domain(&d);
+  to_stdout = !strcmp(argv[i], "-");
+  data = CFPropertyListCreateData(NULL, dict, to_stdout ? kCFPropertyListXMLFormat_v1_0
+                                  : kCFPropertyListBinaryFormat_v1_0, 0, NULL);
+  if (data == NULL)
+    return 1;
+  if (to_stdout)
+    fwrite(CFDataGetBytePtr(data), 1, CFDataGetLength(data), stdout);
+  else
+    {
+      FILE *f = fopen(argv[i], "wb");
+
+      if (f == NULL || fwrite(CFDataGetBytePtr(data), 1, CFDataGetLength(data), f)
+          != (size_t)CFDataGetLength(data))
+        {
+          log_message("\nCould not write domain %s to %s", d.display, argv[i]);
+          if (f)
+            fclose(f);
+          return 1;
+        }
+      fclose(f);
+    }
+  return 0;
+}
