diff --git a/src/NSConstantNumber.m b/src/NSConstantNumber.m
new file mode 100644
index 0000000..ff9aab7
--- /dev/null
+++ b/src/NSConstantNumber.m
@@ -0,0 +1,161 @@
+//
+//  NSConstantNumber.m
+//  Foundation
+//
+//  Copyright (c) 2026 Darling Developers. All rights reserved.
+//
+
+#import <Foundation/NSValue.h>
+#import <Foundation/NSString.h>
+#import <limits.h>
+#import <stdint.h>
+
+@interface NSConstantIntegerNumber : NSNumber {
+    const char *_encoding;
+    long long _value;
+}
+@end
+
+@interface NSConstantFloatNumber : NSNumber {
+    float _value;
+}
+@end
+
+@interface NSConstantDoubleNumber : NSNumber {
+    double _value;
+}
+@end
+
+#define CONSTANT_NUMBER_METHODS(VALUE)                                              \
+- (id)retain { return self; }                                                       \
+- (oneway void)release {}                                                           \
+- (id)autorelease { return self; }                                                  \
+- (NSUInteger)retainCount { return UINT_MAX; }                                      \
+- (id)copyWithZone:(NSZone *)zone { return self; }                                  \
+- (char)charValue { return (char)(VALUE); }                                         \
+- (unsigned char)unsignedCharValue { return (unsigned char)(VALUE); }               \
+- (short)shortValue { return (short)(VALUE); }                                      \
+- (unsigned short)unsignedShortValue { return (unsigned short)(VALUE); }            \
+- (int)intValue { return (int)(VALUE); }                                            \
+- (unsigned int)unsignedIntValue { return (unsigned int)(VALUE); }                  \
+- (long)longValue { return (long)(VALUE); }                                         \
+- (unsigned long)unsignedLongValue { return (unsigned long)(VALUE); }               \
+- (long long)longLongValue { return (long long)(VALUE); }                           \
+- (unsigned long long)unsignedLongLongValue { return (unsigned long long)(VALUE); } \
+- (float)floatValue { return (float)[self doubleValue]; }                           \
+- (BOOL)boolValue { return (VALUE) != 0; }                                          \
+- (NSUInteger)hash { return [[self _boxedNumber] hash]; }                           \
+- (BOOL)isEqual:(id)other { return [[self _boxedNumber] isEqual:other]; }           \
+- (BOOL)isEqualToNumber:(NSNumber *)other { return [[self _boxedNumber] isEqualToNumber:other]; } \
+- (NSComparisonResult)compare:(NSNumber *)other { return [[self _boxedNumber] compare:other]; } \
+- (NSString *)description { return [[self _boxedNumber] description]; }            \
+- (NSString *)descriptionWithLocale:(id)locale { return [[self _boxedNumber] descriptionWithLocale:locale]; }
+
+static BOOL isUnsignedEncoding(char type)
+{
+    return type == 'C' || type == 'S' || type == 'I' || type == 'L' || type == 'Q';
+}
+
+@implementation NSConstantIntegerNumber
+
+CONSTANT_NUMBER_METHODS(_value)
+
+- (NSNumber *)_boxedNumber
+{
+    if (isUnsignedEncoding(_encoding[0]))
+    {
+        return [NSNumber numberWithUnsignedLongLong:(unsigned long long)_value];
+    }
+    return [NSNumber numberWithLongLong:_value];
+}
+
+- (const char *)objCType
+{
+    return _encoding;
+}
+
+- (void)getValue:(void *)buffer
+{
+    switch (_encoding[0])
+    {
+        case 'c':
+        case 'C':
+        case 'B':
+            *(int8_t *)buffer = (int8_t)_value;
+            break;
+        case 's':
+        case 'S':
+            *(int16_t *)buffer = (int16_t)_value;
+            break;
+        case 'i':
+        case 'I':
+            *(int32_t *)buffer = (int32_t)_value;
+            break;
+        default:
+            *(int64_t *)buffer = (int64_t)_value;
+            break;
+    }
+}
+
+- (double)doubleValue
+{
+    if (isUnsignedEncoding(_encoding[0]))
+    {
+        return (double)(unsigned long long)_value;
+    }
+    return (double)_value;
+}
+
+@end
+
+@implementation NSConstantFloatNumber
+
+CONSTANT_NUMBER_METHODS(_value)
+
+- (NSNumber *)_boxedNumber
+{
+    return [NSNumber numberWithFloat:_value];
+}
+
+- (const char *)objCType
+{
+    return "f";
+}
+
+- (void)getValue:(void *)buffer
+{
+    *(float *)buffer = _value;
+}
+
+- (double)doubleValue
+{
+    return _value;
+}
+
+@end
+
+@implementation NSConstantDoubleNumber
+
+CONSTANT_NUMBER_METHODS(_value)
+
+- (NSNumber *)_boxedNumber
+{
+    return [NSNumber numberWithDouble:_value];
+}
+
+- (const char *)objCType
+{
+    return "d";
+}
+
+- (void)getValue:(void *)buffer
+{
+    *(double *)buffer = _value;
+}
+
+- (double)doubleValue
+{
+    return _value;
+}
+
+@end
