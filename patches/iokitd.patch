+ but WITHOUT ANY WARRANTY; without even the implied warranty of
+ MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ GNU General Public License for more details.
+
+ You should have received a copy of the GNU General Public License
+ along with Darling.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+/*
+ * Follows host suspend/resume through systemd-logind on the system bus.
+ *
+ * At start a "delay" sleep inhibitor is taken. When logind announces a
+ * suspend (PrepareForSleep(true)), will_sleep() is called and the inhibitor
+ * is kept until iokitd_logind_sleep_ready() is called for that cycle or the
+ * acknowledgement timeout expires, whichever comes first; then it is closed
+ * so the suspend can proceed. After resume (PrepareForSleep(false)),
+ * did_wake() is called and a new inhibitor is taken.
+ *
+ * The bus is owned by one background thread; the callbacks run on it.
+ * iokitd_logind_sleep_ready() may be called from any thread.
+ *
+ * This part has no Darling dependencies: every host function comes from the
+ * table below, so it can also be built natively on Linux against libsystemd
+ * for testing. Errors are negative Linux errno values as returned by sd-bus.
+ */
+
+#ifndef IOKITD_LOGIND_SLEEP_H_
+#define IOKITD_LOGIND_SLEEP_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Linux values; the guest's numbering differs. */
+#define IOKITD_LINUX_EINVAL 22
+#define IOKITD_LINUX_ENOMEM 12
+#define IOKITD_LINUX_ENOSYS 38
+#define IOKITD_LINUX_EINTR 4
+#define IOKITD_LINUX_F_DUPFD_CLOEXEC 1030
+
+#define IOKITD_LOGIND_DEFAULT_SYSTEM_BUS "unix:path=/run/dbus/system_bus_socket"
+
+/* Layout of sd_bus_error. */
+struct iokitd_bus_error
+{
+	const char* name;
+	const char* message;
+	int _need_free;
+};
+
+typedef int (*iokitd_bus_handler)(void* m, void* userdata, struct iokitd_bus_error* ret_error);
+
+struct iokitd_logind_api
+{
+	/* libsystemd (sd-bus); bus, message and slot objects are opaque */
+	int (*sd_bus_new)(void** ret);
+	int (*sd_bus_set_address)(void* bus, const char* address);
+	int (*sd_bus_set_bus_client)(void* bus, int b);
+	int (*sd_bus_start)(void* bus);
+	int (*sd_bus_set_method_call_timeout)(void* bus, uint64_t timeout);
+	void* (*sd_bus_flush_close_unref)(void* bus);
+	int (*sd_bus_match_signal)(void* bus, void** ret_slot, const char* sender, const char* path,
+		const char* interface, const char* member, iokitd_bus_handler callback, void* userdata);
+	int (*sd_bus_call_method)(void* bus, const char* destination, const char* path,
+		const char* interface, const char* member, struct iokitd_bus_error* ret_error,
+		void** reply, const char* types, ...);
+	int (*sd_bus_get_property_trivial)(void* bus, const char* destination, const char* path,
+		const char* interface, const char* member, struct iokitd_bus_error* ret_error,
+		char type, void* ret_ptr);
+	int (*sd_bus_message_read)(void* m, const char* types, ...);
+	void* (*sd_bus_message_unref)(void* m);
+	void* (*sd_bus_slot_unref)(void* slot);
+	void (*sd_bus_error_free)(struct iokitd_bus_error* e);
+	int (*sd_bus_process)(void* bus, void** ret);
+	int (*sd_bus_wait)(void* bus, uint64_t timeout_usec);
+
+	/* Host file descriptors (the inhibitor lock) */
+	int (*fcntl)(int fd, int cmd, ...);
+	int (*close)(int fd);
+
+	/* Process environment (DBUS_SYSTEM_BUS_ADDRESS) */
+	char* (*getenv)(const char* name);
+
+	/* Optional diagnostics */
+	void (*log)(const char* message);
+
+	/*
+	 * How long to wait for applications to acknowledge a suspend before
+	 * releasing the inhibitor anyway; 0 derives it from logind's
+	 * InhibitDelayMaxUSec (one second less, so the release always comes
+	 * before logind gives up on us).
+	 */
+	uint64_t ack_timeout_usec;
+};
+
+/* Shared host symbol table. Only implemented in the guest iokitd bridge. */
+const struct iokitd_logind_api* iokitd_host_power_api(void);
+
+struct iokitd_logind_callbacks
+{
+	/* Suspend is imminent. Call iokitd_logind_sleep_ready(cycle) once clients agreed. */
+	void (*will_sleep)(void* context, uint64_t cycle);
+	/* The system has resumed (or the suspend failed). */
+	void (*did_wake)(void* context, uint64_t cycle);
+};
+
+struct iokitd_logind;
+
+/*
+ * Connects to the system bus (DBUS_SYSTEM_BUS_ADDRESS or the standard
+ * socket), subscribes to PrepareForSleep, takes the delay inhibitor and
+ * starts the bus thread. A missing logind is not an error: no events arrive
+ * then. Returns 0 or a negative errno (no bus, incomplete api).
+ */
+int iokitd_logind_start(const struct iokitd_logind_api* api,
+	const struct iokitd_logind_callbacks* callbacks, void* context,
+	struct iokitd_logind** ret);
+
+/* Releases the inhibitor if it is still held for this suspend cycle. */
+void iokitd_logind_sleep_ready(struct iokitd_logind* logind, uint64_t cycle);
+
+/* Acknowledgement timeout in use, in microseconds. */
+uint64_t iokitd_logind_ack_timeout_usec(const struct iokitd_logind* logind);
+
+/* 1 if a delay inhibitor is currently held. */
+int iokitd_logind_holds_inhibitor(struct iokitd_logind* logind);
+
+/* Stops the bus thread, closes the inhibitor and the bus. */
+void iokitd_logind_stop(struct iokitd_logind* logind);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/HostPowerInhibit.c b/src/HostPowerInhibit.c
new file mode 100644
index 0000000..cdcb933
--- /dev/null
+++ b/src/HostPowerInhibit.c
@@ -0,0 +1,118 @@
+/* Host power-save inhibitors. GPL-3.0-or-later, like iokitd. */
+#include "HostPowerInhibit.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+struct iokitd_power_inhibit {
+    struct iokitd_logind_api api;
+    int idle_fd;
+    void* screen_bus;
+    uint32_t screen_cookie;
+    int screen_held;
+};
+
+static int connect_bus(const struct iokitd_logind_api* api, const char* address, void** bus)
+{
+    int r = api->sd_bus_new(bus);
+    if (r >= 0) r = api->sd_bus_set_address(*bus, address);
+    if (r >= 0) r = api->sd_bus_set_bus_client(*bus, 1);
+    /* Assertions are synchronous MIG calls; do not stall the IOKit queue for
+     * sd-bus's default 25-second service timeout. */
+    if (r >= 0) r = api->sd_bus_set_method_call_timeout(*bus, 500000);
+    if (r >= 0) r = api->sd_bus_start(*bus);
+    return r;
+}
+
+static int take_idle_lock(struct iokitd_power_inhibit* inhibitor)
+{
+    const struct iokitd_logind_api* api = &inhibitor->api;
+    const char* address = api->getenv("DBUS_SYSTEM_BUS_ADDRESS");
+    struct iokitd_bus_error error = {0};
+    void *bus = NULL, *reply = NULL;
+    int fd = -1;
+    if (!address || !address[0]) address = IOKITD_LOGIND_DEFAULT_SYSTEM_BUS;
+    int r = connect_bus(api, address, &bus);
+    if (r >= 0)
+        r = api->sd_bus_call_method(bus, "org.freedesktop.login1", "/org/freedesktop/login1",
+                "org.freedesktop.login1.Manager", "Inhibit", &error, &reply, "ssss",
+                "idle", "Darling", "macOS application prevents automatic idle sleep", "block");
+    if (r >= 0) r = api->sd_bus_message_read(reply, "h", &fd);
+    if (r >= 0) {
+        inhibitor->idle_fd = api->fcntl(fd, IOKITD_LINUX_F_DUPFD_CLOEXEC, 3);
+        if (inhibitor->idle_fd < 0) r = -IOKITD_LINUX_ENOMEM;
+    }
+    if (reply) api->sd_bus_message_unref(reply);
+    api->sd_bus_error_free(&error);
+    if (bus) api->sd_bus_flush_close_unref(bus);
+    return r;
+}
+
+static int take_screen_lock(struct iokitd_power_inhibit* inhibitor)
+{
+    const struct iokitd_logind_api* api = &inhibitor->api;
+    const char* address = api->getenv("DBUS_SESSION_BUS_ADDRESS");
+    char fallback[512];
+    if (!address || !address[0]) {
+        const char* runtime = api->getenv("XDG_RUNTIME_DIR");
+        int length = runtime && runtime[0]
+            ? snprintf(fallback, sizeof(fallback), "unix:path=%s/bus", runtime)
+            : snprintf(fallback, sizeof(fallback), "unix:path=/run/user/%u/bus", (unsigned)getuid());
+        if (length < 0 || (size_t)length >= sizeof(fallback)) return -IOKITD_LINUX_EINVAL;
+        address = fallback;
+    }
+    struct iokitd_bus_error error = {0};
+    void* reply = NULL;
+    int r = connect_bus(api, address, &inhibitor->screen_bus);
+    if (r >= 0)
+        r = api->sd_bus_call_method(inhibitor->screen_bus, "org.freedesktop.ScreenSaver",
+                "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver", "Inhibit",
+                &error, &reply, "ss", "Darling", "macOS application prevents display sleep");
+    if (r >= 0) r = api->sd_bus_message_read(reply, "u", &inhibitor->screen_cookie);
+    if (r >= 0) inhibitor->screen_held = 1;
+    if (reply) api->sd_bus_message_unref(reply);
+    api->sd_bus_error_free(&error);
+    return r;
+}
+
+int iokitd_power_inhibit_create(const struct iokitd_logind_api* api, int display,
+                              struct iokitd_power_inhibit** result)
+{
+    *result = NULL;
+    if (!api || !api->sd_bus_new || !api->sd_bus_set_address || !api->sd_bus_set_bus_client ||
+        !api->sd_bus_set_method_call_timeout || !api->sd_bus_start || !api->sd_bus_call_method ||
+        !api->sd_bus_message_read || !api->sd_bus_message_unref || !api->sd_bus_error_free ||
+        !api->sd_bus_flush_close_unref || !api->fcntl || !api->close || !api->getenv)
+        return -IOKITD_LINUX_ENOSYS;
+    struct iokitd_power_inhibit* inhibitor = calloc(1, sizeof(*inhibitor));
+    if (!inhibitor) return -IOKITD_LINUX_ENOMEM;
+    inhibitor->api = *api;
+    inhibitor->idle_fd = -1;
+    int r = take_idle_lock(inhibitor);
+    if (r >= 0 && display) r = take_screen_lock(inhibitor);
+    if (r < 0) {
+        iokitd_power_inhibit_destroy(inhibitor);
+        return r;
+    }
+    *result = inhibitor;
+    return 0;
+}
+
+void iokitd_power_inhibit_destroy(struct iokitd_power_inhibit* inhibitor)
+{
+    if (!inhibitor) return;
+    const struct iokitd_logind_api* api = &inhibitor->api;
+    if (inhibitor->screen_held) {
+        struct iokitd_bus_error error = {0};
+        void* reply = NULL;
+        api->sd_bus_call_method(inhibitor->screen_bus, "org.freedesktop.ScreenSaver",
+                "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver", "UnInhibit",
+                &error, &reply, "u", inhibitor->screen_cookie);
+        if (reply) api->sd_bus_message_unref(reply);
+        api->sd_bus_error_free(&error);
+    }
+    if (inhibitor->screen_bus) api->sd_bus_flush_close_unref(inhibitor->screen_bus);
+    if (inhibitor->idle_fd >= 0) api->close(inhibitor->idle_fd);
+    free(inhibitor);
+}
